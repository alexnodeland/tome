# Rust / Tauri
/target/
/src-tauri/target/
**/*.rs.bk
*.pdb

# Node
node_modules/
# `dist/*`, not `dist/` — git cannot re-include anything inside an excluded
# *directory*, so the negations below would silently do nothing. `dist/` is
# Vite's build output, but CLAUDE.md designates `dist/homebrew/` as the cask's
# source of truth and the Claude Code plugin ships from here too; without
# these two lines those files are untracked, which is how a release ships
# without the thing it was supposed to mirror.
dist/*
!dist/homebrew/
!dist/claude-plugin/
.svelte-kit/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# Build output
/src-tauri/gen/
*.app
*.dmg
*.zip

# Signing — never commit these
*.p12
*.mobileprovision
*.cer
entitlements.local.plist

# Test / coverage
coverage/
lcov*.info
/playwright-report/
/test-results/

# Golden-corpus scratch output. The harness writes `<golden>.actual` beside a
# golden it did not match, so the full output can be inspected rather than only
# read out of a test failure. The goldens themselves ARE committed.
*.actual

# Fuzzing. Corpora and crash artefacts are regenerable and can be large; a
# crash worth keeping gets minimised and committed as a unit test instead.
/fuzz/target/
/spikes/*/target/
/fuzz/corpus/
/fuzz/artifacts/

# Local dev
.env
.env.local
*.log

# macOS
.DS_Store
.AppleDouble
._*

# Editors
.idea/
*.swp
.vscode/*
!.vscode/extensions.json

# Claude Code local settings (shared settings.json IS committed)
.claude/settings.local.json

# App icons MUST be committed — the bundle will not build without them.
#
# macOS global gitignores commonly contain `Icon?` (for the Finder's "Icon\r"
# resource file). Because git is case-insensitive on macOS by default, `Icon?`
# also matches the directory `icons/`, silently excluding the entire icon set.
# Re-include the directory first, then its contents: git cannot re-include a
# file whose parent directory is excluded.
!src-tauri/icons/
!src-tauri/icons/*.png
!src-tauri/icons/*.icns

# Playwright MCP scratch output (browser verification runs)
.playwright-mcp/

# The documentation site's build output. Sources are in `site/`; build it with
# `node site/build.mjs`, which `scripts/check.sh` runs.
site/_build/
