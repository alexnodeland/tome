# Tome Development Environment Variables
# Copy to .env and adjust as needed
# NEVER commit .env files with real values

# === Logging ===
# Log levels: error, warn, info, debug, trace
RUST_LOG=tome=info

# === Development ===
# Vite dev server URL (change port if needed)
VITE_DEV_URL=http://localhost:5173

# === Local API ===
# Port for local HTTP API (Phase 4)
TOME_API_PORT=7431

# === Testing ===
# Enable verbose test output
TOME_TEST_VERBOSE=false

# === Feature Flags (Development Only) ===
# Enable experimental features
TOME_ENABLE_MCP=false
TOME_ENABLE_ICLOUD_SYNC=false
