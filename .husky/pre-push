#!/bin/sh
# Husky pre-push hook
# Runs full test suite before pushing

# Exit on error
set -e

echo "Running pre-push checks..."

# Run Rust tests (only on macOS where Tauri dependencies are available)
if [ "$(uname)" = "Darwin" ] && [ -f "src-tauri/Cargo.toml" ]; then
  echo "Running Rust tests..."
  cargo test --manifest-path src-tauri/Cargo.toml --quiet
else
  echo "Skipping Rust tests (requires macOS with Tauri dependencies)"
fi

# Run JavaScript tests
echo "Running JavaScript tests..."
npm test -- --run

echo "All pre-push checks passed!"
