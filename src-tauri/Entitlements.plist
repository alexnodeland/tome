<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime - Required for notarization -->
    <key>com.apple.security.cs.allow-jit</key>
    <false/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <false/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <false/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <false/>

    <!-- App Sandbox - Enabled with specific capabilities -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Network Access - Required for fetching documentation -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Local Server - Required for local API (Phase 4) -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- File Access - User-selected files and app data -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>

    <!-- iCloud/CloudKit - Required for sync (Phase 3) -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>$(TeamIdentifierPrefix)app.tome.reader</string>
    </array>

    <!-- Temporary Exception for WKWebView -->
    <!-- May be required for loading local content in WebView -->
    <key>com.apple.security.temporary-exception.files.absolute-path.read-only</key>
    <array>
        <string>/</string>
    </array>
</dict>
</plist>
