{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tome",
  "identifier": "com.alexnodeland.tome",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && ./scripts/build-cli-sidecar.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tome",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' tome: data:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "externalBin": ["binaries/tome"],
    "resources": {
      "../registry/index.yaml": "registry/index.yaml",
      "../registry/sources/*.yaml": "registry/sources/"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns"],
    "category": "DeveloperTool",
    "shortDescription": "A personal library for technical documentation.",
    "copyright": "Copyright © 2026 Alex Nodeland. MIT OR Apache-2.0.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": { "width": 540, "height": 380 },
        "appPosition": { "x": 140, "y": 180 },
        "applicationFolderPosition": { "x": 400, "y": 180 }
      }
    }
  }
}
