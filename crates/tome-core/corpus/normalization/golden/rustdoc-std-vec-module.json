      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "value": "A contiguous growable array type with heap-allocated contents, written "
          },
          {
            "type": "inline_code",
            "code": "Vec<T>"
          },
          {
            "type": "text",
            "value": "."
          }
        ]
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "value": "Vectors have "
          },
          {
            "type": "emphasis",
            "children": [
              {
                "type": "text",
                "value": "O"
              }
            ]
          },
          {
            "type": "text",
            "value": "(1) indexing, amortized "
          },
          {
            "type": "emphasis",
            "children": [
              {
                "type": "text",
                "value": "O"
              }
            ]
          },
          {
            "type": "text",
            "value": "(1) push (to the end) and "
          },
          {
            "type": "emphasis",
            "children": [
              {
                "type": "text",
                "value": "O"
              }
            ]
          },
          {
            "type": "text",
            "value": "(1) pop (from the end)."
          }
        ]
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "value": "Vectors ensure they never allocate more than "
          },
          {
            "type": "inline_code",
            "code": "isize::MAX"
          },
          {
            "type": "text",
            "value": " bytes."
          }
        ]
