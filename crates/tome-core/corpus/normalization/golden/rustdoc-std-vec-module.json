          }
        ]
      },
      {
        "type": "code_block",
        "language": null,
        "code": "let v: Vec<i32> = vec![];\n\nlet v = vec![1, 2, 3, 4, 5];\n\nlet v = vec![0; 10]; // ten zeroes"
      },
      {
        "type": "link",
        "href": "https://play.rust-lang.org/?code=%23!%5Ballow(unused)%5D%0Afn+main()+%7B%0A++++let+v:+Vec%3Ci32%3E+=+vec!%5B%5D;%0A++++%0A++++let+v+=+vec!%5B1,+2,+3,+4,+5%5D;%0A++++%0A++++let+v+=+vec!%5B0;+10%5D;%0A%7D&edition=2024",
        "title": "Run code",
        "children": []
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "value": "You can "
          },
