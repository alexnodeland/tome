        "children": [
          {
            "type": "text",
            "value": "The "
          },
          {
            "type": "inline_code",
            "code": "querystring.parse()"
          },
          {
            "type": "text",
            "value": " method parses a URL query string ("
          },
          {
            "type": "inline_code",
            "code": "str"
          },
          {
            "type": "text",
            "value": ") into a collection of key and value pairs."
          }
        ]
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "value": "For example, the query string "
          },
          {
            "type": "inline_code",
            "code": "'foo=bar&abc=xyz&abc=123'"
          },
          {
            "type": "text",
            "value": " is parsed into:"
          }
        ]
      },
      {
        "type": "code_block",
        "language": "json",
        "code": "{\n  \"foo\": \"bar\",\n  \"abc\": [\"xyz\", \"123\"]\n}\njsoncopy"
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "value": "The object returned by the "
          },
          {
            "type": "inline_code",
            "code": "querystring.parse()"
          },
          {
            "type": "text",
            "value": " method "
          },
          {
            "type": "emphasis",
            "children": [
              {
                "type": "text",
                "value": "does not"
              }
            ]
          },
          {
            "type": "text",
            "value": " prototypically inherit from the JavaScript "
          },
          {
            "type": "inline_code",
            "code": "Object"
          },
          {
            "type": "text",
            "value": ". This means that typical "
          },
          {
            "type": "inline_code",
            "code": "Object"
          },
          {
            "type": "text",
            "value": " methods such as "
          },
          {
            "type": "inline_code",
            "code": "obj.toString()"
          },
          {
            "type": "text",
            "value": ", "
          },
          {
            "type": "inline_code",
            "code": "obj.hasOwnProperty()"
          },
          {
            "type": "text",
            "value": ", and others are not defined and "
          },
          {
            "type": "emphasis",
            "children": [
              {
                "type": "text",
                "value": "will not work"
              }
            ]
          },
          {
            "type": "text",
            "value": "."
          }
        ]
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "value": "By default, percent-encoded characters within the query string will be assumed to use UTF-8 encoding. If an alternative character encoding is used, then an alternative "
          },
          {
            "type": "inline_code",
            "code": "decodeURIComponent"
          },
          {
            "type": "text",
            "value": " option will need to be specified:"
          }
        ]
      },
      {
        "type": "code_block",
        "language": "javascript",
        "code": "// Assuming gbkDecodeURIComponent function already exists...\n\nquerystring.parse('w=%D6%D0%CE%C4&foo=bar', null, null,\n                  { decodeURIComponent: gbkDecodeURIComponent });\njscopy"
      },
