{"path":"api/path.html","title":"Path","description":"Stability: 2 - Stable","body":{"type":"document","children":[{"type":"heading","level":1,"id":null,"children":[{"type":"text","value":"Path"},{"type":"anchor","id":"path_path"},{"type":"anchor","id":"path"}]},{"type":"strong","children":[{"type":"text","value":"Source Code: "}]},{"type":"link","href":"https://github.com/nodejs/node/blob/main/lib/path.js","title":null,"children":[{"type":"text","value":"lib/path.js"}]},{"type":"paragraph","children":[{"type":"link","href":"api/documentation.html#stability-index","title":null,"children":[{"type":"text","value":"Stability: 2"}]},{"type":"text","value":" - Stable"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inline_code","code":"node:path"},{"type":"text","value":" module provides utilities for working with file and directory paths. It can be accessed using:"}]},{"type":"code_block","language":"cjs","code":"const path = require('node:path');"},{"type":"heading","level":2,"id":null,"children":[{"type":"text","value":"Windows vs. POSIX"},{"type":"anchor","id":"path_windows_vs_posix"},{"type":"anchor","id":"windows-vs-posix"}]},{"type":"paragraph","children":[{"type":"text","value":"The default operation of the "},{"type":"inline_code","code":"node:path"},{"type":"text","value":" module varies based on the operating system on which a Node.js application is running. Specifically, when running on a Windows operating system, the "},{"type":"inline_code","code":"node:path"},{"type":"text","value":" module will assume that Windows-style paths are being used."}]},{"type":"paragraph","children":[{"type":"text","value":"So using "},{"type":"inline_code","code":"path.basename()"},{"type":"text","value":" might yield different results on POSIX and Windows:"}]},{"type":"paragraph","children":[{"type":"text","value":"On POSIX:"}]},{"type":"code_block","language":"javascript","code":"path.basename('C:\\\\temp\\\\myfile.html');\n// Returns: 'C:\\\\temp\\\\myfile.html'"},{"type":"paragraph","children":[{"type":"text","value":"On Windows:"}]},{"type":"code_block","language":"javascript","code":"path.basename('C:\\\\temp\\\\myfile.html');\n// Returns: 'myfile.html'"},{"type":"paragraph","children":[{"type":"text","value":"To achieve consistent results when working with Windows file paths on any operating system, use "},{"type":"link","href":"api/path.html#pathwin32","title":null,"children":[{"type":"inline_code","code":"path.win32"}]},{"type":"text","value":":"}]},{"type":"paragraph","children":[{"type":"text","value":"On POSIX and Windows:"}]},{"type":"code_block","language":"javascript","code":"path.win32.basename('C:\\\\temp\\\\myfile.html');\n// Returns: 'myfile.html'"},{"type":"paragraph","children":[{"type":"text","value":"To achieve consistent results when working with POSIX file paths on any operating system, use "},{"type":"link","href":"api/path.html#pathposix","title":null,"children":[{"type":"inline_code","code":"path.posix"}]},{"type":"text","value":":"}]},{"type":"paragraph","children":[{"type":"text","value":"On POSIX and Windows:"}]},{"type":"code_block","language":"javascript","code":"path.posix.basename('/tmp/myfile.html');\n// Returns: 'myfile.html'"},{"type":"paragraph","children":[{"type":"text","value":"On Windows Node.js follows the concept of per-drive working directory. This behavior can be observed when using a drive path without a backslash. For example, "},{"type":"inline_code","code":"path.resolve('C:\\\\')"},{"type":"text","value":" can potentially return a different result than "},{"type":"inline_code","code":"path.resolve('C:')"},{"type":"text","value":". For more information, see "},{"type":"link","href":"https://docs.microsoft.com/en-us/windows/desktop/FileIO/naming-a-file#fully-qualified-vs-relative-paths","title":null,"children":[{"type":"text","value":"this MSDN page"}]},{"type":"text","value":"."}]},{"type":"heading","level":2,"id":null,"children":[{"type":"inline_code","code":"pa