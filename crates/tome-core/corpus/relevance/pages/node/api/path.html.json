"}]}]}]}]},{"children":[{"type":"text","value":"Returns: "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inline_code","code":"path.format()"},{"type":"text","value":" method returns a path string from an object. This is the opposite of "},{"type":"link","href":"api/path.html#pathparsepath","title":null,"children":[{"type":"inline_code","code":"path.parse()"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"When providing properties to the "},{"type":"inline_code","code":"pathObject"},{"type":"text","value":" remember that there are combinations where one property has priority over another:"}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"inline_code","code":"pathObject.root"},{"type":"text","value":" is ignored if "},{"type":"inline_code","code":"pathObject.dir"},{"type":"text","value":" is provided"}]},{"children":[{"type":"inline_code","code":"pathObject.ext"},{"type":"text","value":" and "},{"type":"inline_code","code":"pathObject.name"},{"type":"text","value":" are ignored if "},{"type":"inline_code","code":"pathObject.base"},{"type":"text","value":" exists"}]}]},{"type":"paragraph","children":[{"type":"text","value":"For example, on POSIX:"}]},{"type":"code_block","language":"javascript","code":"// If `dir`, `root` and `base` are provided,\n// `${dir}${path.sep}${base}`\n// will be returned. `root` is ignored.\npath.format({\n  root: '/ignored',\n  dir: '/home/user/dir',\n  base: 'file.txt',\n});\n// Returns: '/home/user/dir/file.txt'\n\n// `root` will be used if `dir` is not specified.\n// If only `root` is provided or `dir` is equal to `root` then the\n// platform separator will not be included. `ext` will be ignored.\npath.format({\n  root: '/',\n  base: 'file.txt',\n  ext: 'ignored',\n});\n// Returns: '/file.txt'\n\n// `name` + `ext` will be used if `base` is not specified.\npath.format({\n  root: '/',\n  name: 'file',\n  ext: '.txt',\n});\n// Returns: '/file.txt'\n\n// The dot will be added if it is not specified in `ext`.\npath.format({\n  root: '/',\n  name: 'file',\n  ext: 'txt',\n});\n// Returns: '/file.txt'"},{"type":"paragraph","children":[{"type":"text","value":"On Windows:"}]},{"type":"code_block","language":"javascript","code":"path.format({\n  dir: 'C:\\\\path\\\\dir',\n  base: 'file.txt',\n});\n// Returns: 'C:\\\\path\\\\dir\\\\file.txt'"},{"type":"heading","level":2,"id":null,"children":[{"type":"inline_code","code":"path.matchesGlob(path, pattern)"},{"type":"anchor","id":"path_path_matchesglob_path_pattern"},{"type":"anchor","id":"pathmatchesglobpath-pattern"}]},{"type":"text","value":"Added in: v22.5.0, v20.17.0History"},{"type":"table","headers":[{"children":[{"type":"text","value":"Version"}]},{"children":[{"type":"text","value":"Changes"}]}],"rows":[{"cells":[{"children":[{"type":"text","value":"v24.8.0, v22.20.0"}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"Marking the API stable."}]}]}]}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"inline_code","code":"path"},{"type":"text","value":" "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]},{"type":"text","value":" The path to glob-match against."}]},{"children":[{"type":"inline_code","code":"pattern"},{"type":"text","value":" "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]},{"type":"text","value":" The glob to check the path against."}]},{"children":[{"type":"text","value":"Returns: "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#boolean_type","title":null,"children":[{"type":"inline_code","code":"<boolean>"}]},{"type":"text","value":" Whether or not the "},{"type":"inline_code","code":"path"},{"type":"text","value":" matched the "},{"type":"inline_code","code":"pattern"},{"type":"text","value":"."}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inline_code","code":"path.matchesGlob()"},{"type":"text","value":" method determines if "},{"type":"inline_code","code":"path"},{"type":"text","value":" matches the "},{"type":"inline_code","code":"pattern"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"For example:"}]},{"type":"code_block","language":"javascript","code":"path.matchesGlob('/foo/bar', '/foo/*'); // true\npath.matchesGlob('/foo/bar*', 'foo/bird'); // false"},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"link","href":"api/errors.html#class-typeerror","title":null,"children":[{"type":"inline_code","code":"TypeError"}]},{"type":"text","value":" is thrown if "},{"type":"inline_code","code":"path"},{"type":"text","value":" or "},{"type":"inline_code","code":"pattern"},{"type":"text","value":" are not strings."}]},{"type":"heading","level":2,"id":null,"children":[{"type":"inline_code","code":"path.isAbsolute(path)"},{"type":"anchor","id":"path_path_isabsolute_path"},{"type":"anchor","id":"pathisabsolutepath"}]},{"type":"text","value":"Added in: v0.11.2"},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"inline_code","code":"path"},{"type":"text","value":" "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]}]},{"children":[{"type":"text","value":"Returns: "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#boolean_type","title":null,"children":[{"type":"inline_code","code":"<boolean>"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inline_code","code":"path.isAbsolute()"},{"type":"text","value":" method determines if the literal "},{"type":"inline_code","code":"path"},{"type":"text","value":" is absolute. Therefore, it’s not safe for mitigating path traversals."}]},{"type":"paragraph","children":[{"type":"text","value":"If the given "},{"type":"inline_code","code":"path"},{"type":"text","value":" is a zero-length string, "},{"type":"inline_code","code":"false"},{"type":"text","value":" will be returned."}]},{"type":"paragraph","children":[{"type":"text","value":"For example, on POSIX:"}]},{"type":"code_block","language":"javascript","code":"path.isAbsolute('/foo/bar');   // true\npath.isAbsolute('/baz/..');    // true\npath.isAbsolute('/baz/../..'); // true\npath.isAbsolute('qux/');       // false\npath.isAbsolute('.');          // false"},{"type":"paragraph","children":[{"type":"text","value":"On Windows:"}]},{"type":"code_block","language":"javascript","code":"path.isAbsolute('//server');    // true\npath.isAbsolute('\\\\\\\\server');  // true\npath.isAbsolute('C:/foo/..');   // true\npath.isAbsolute('C:\\\\foo\\\\..'); // true\npath.isAbsolute('bar\\\\baz');    // false\npath.isAbsolute('bar/baz');     // false\npath.isAbsolute('.');           // false"},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"link","href":"api/errors.html#class-typeerror","title":null,"children":[{"type":"inline_code","code":"TypeError"}]},{"type":"text","value":" is thrown if "},{"type":"inline_code","code":"path"},{"type":"text","value":" is not a string."}]},{"type":"heading","level":2,"id":null,"children":[{"type":"inline_code","code":"path.join([...paths])"},{"type":"anchor","id":"path_path_join_paths"},{"type":"anchor","id":"pathjoinpaths"}]},{"type":"text","value":"Added in: v0.1.16"},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"inline_code","code":"...paths"},{"type":"text","value":" "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]},{"type":"text","value":" A sequence of path segments"}]},{"children":[{"type":"text","value":"Returns: "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inline_code","code":"path.join()"},{"type":"text","value":" method joins all given "},{"type":"inline_code","code":"path"},{"type":"text","value":" segments together using the platform-specific separator as a delimiter, then normalizes the resulting path."}]},{"type":"paragraph","children":[{"type":"text","value":"Zero-length "},{"type":"inline_code","code":"path"},{"type":"text","value":" segments are ignored. If the joined path string is a zero-length string then "},{"type":"inline_code","code":"'.'"},{"type":"text","value":" will be returned, representing the current working directory."}]},{"type":"code_block","language":"javascript","code":"path.join('/foo', 'bar', 'baz/asdf', 'quux', '..');\n// Returns: '/foo/bar/baz/asdf'\n\npath.join('foo', {}, 'bar');\n// Throws 'TypeError: Path must be a string. Received {}'"},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"link","href":"api/errors.html#class-typeerror","title":null,"children":[{"type":"inline_code","code":"TypeError"}]},{"type":"text","value":" is thrown if any of the path segments is not a string."}]},{"type":"heading","level":2,"id":null,"children":[{"type":"inline_code","code":"path.normalize(path)"},{"type":"anchor","id":"path_path_normalize_path"},{"type":"anchor","id":"pathnormalizepath"}]},{"type":"text","value":"Added in: v0.1.23"},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"inline_code","code":"path"},{"type":"text","value":" "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]}]},{"children":[{"type":"text","value":"Returns: "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inline_code","code":"path.normalize()"},{"type":"text","value":" method normalizes the given "},{"type":"inline_code","code":"path"},{"type":"text","value":", resolving "},{"type":"inline_code","code":"'..'"},{"type":"text","value":" and "},{"type":"inline_code","code":"'.'"},{"type":"text","value":" segments."}]},{"type":"paragraph","children":[{"type":"text","value":"When multiple, sequential path segment separation characters are found (e.g. "},{"type":"inline_code","code":"/"},{"type":"text","value":" on POSIX and either "},{"type":"inline_code","code":"\\"},{"type":"text","value":" or "},{"type":"inline_code","code":"/"},{"type":"text","value":" on Windows), they are replaced by a single instance of the platform-specific path segment separator ("},{"type":"inline_code","code":"/"},{"type":"text","value":" on POSIX and "},{"type":"inline_code","code":"\\"},{"type":"text","value":" on Windows). Trailing separators are preserved."}]},{"type":"paragraph","children":[{"type":"text","value":"If the "},{"type":"inline_code","code":"path"},{"type":"text","value":" is a zero-length string, "},{"type":"inline_code","code":"'.'"},{"type":"text","value":" is returned, representing the current working directory."}]},{"type":"paragraph","children":[{"type":"text","value":"On POSIX, the types of normalization applied by this function do not strictly adhere to the POSIX specification. For example, this function will replace two leading forward slashes with a single slash as if it was a regular absolute path, whereas a few POSIX systems assign special meaning to paths beginning with exactly two forward slashes. Similarly, other substitutions performed by this function, such as removing "},{"type":"inline_code","code":".."},{"type":"text","value":" segments, may change how the underlying system resolves the path."}]},{"type":"paragraph","children":[{"type":"text","value":"For example, on POSIX:"}]},{"type":"code_block","language":"javascript","code":"path.normalize('/foo/bar//baz/asdf/quux/..');\n// Returns: '/foo/bar/baz/asdf'"},{"type":"paragraph","children":[{"type":"text","value":"On Windows:"}]},{"type":"code_block","language":"javascript","code":"path.normalize('C:\\\\temp\\\\\\\\foo\\\\bar\\\\..\\\\');\n// Returns: 'C:\\\\temp\\\\foo\\\\'"},{"type":"paragraph","children":[{"type":"text","value":"Since Windows recognizes multiple path separators, both separators will be replaced by instances of the Windows preferred separator ("},{"type":"inline_code","code":"\\"},{"type":"text","value":"):"}]},{"type":"code_block","language":"javascript","code":"path.win32.normalize('C:////temp\\\\\\\\/\\\\/\\\\/foo/bar');\n// Returns: 'C:\\\\temp\\\\foo\\\\bar'"},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"link","href":"api/errors.html#class-typeerror","title":null,"children":[{"type":"inline_code","code":"TypeError"}]},{"type":"text","value":" is thrown if "},{"type":"inline_code","code":"path"},{"type":"text","value":" is not a string."}]},{"type":"heading","level":2,"id":null,"children":[{"type":"inline_code","code":"path.parse(path)"},{"type":"anchor","id":"path_path_parse_path"},{"type":"anchor","id":"pathparsepath"}]},{"type":"text","value":"Added in: v0.11.15"},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"inline_code","code":"path"},{"type":"text","value":" "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]}]},{"children":[{"type":"text","value":"Returns: "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Reference/Global_Objects/Object","title":null,"children":[{"type":"inline_code","code":"<Object>"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inline_code","code":"path.parse()"},{"type":"text","value":" method returns an object whose properties represent significant elements of the "},{"type":"inline_code","code":"path"},{"type":"text","value":". Trailing directory separators are ignored, see "},{"type":"link","href":"api/path.html#pathsep","title":null,"children":[{"type":"inline_code","code":"path.sep"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"The returned object will have the following properties:"}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"inline_code","code":"dir"},{"type":"text","value":" "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]}]},{"children":[{"type":"inline_code","code":"root"},{"type":"text","value":" "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]}]},{"children":[{"type":"inline_code","code":"base"},{"type":"text","value":" "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]}]},{"children":[{"type":"inline_code","code":"name"},{"type":"text","value":" "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]}]},{"children":[{"type":"inline_code","code":"ext"},{"type":"text","value":" "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"For example, on POSIX:"}]},{"type":"code_block","language":"javascript","code":"path.parse('/home/user/dir/file.txt');\n// Returns:\n// { root: '/',\n//   dir: '/home/user/dir',\n//   base: 'file.txt',\n//   ext: '.txt',\n//   name: 'file' }"},{"type":"code_block","language":"text","code":"┌─────────────────────┬────────────┐\n│          dir        │    base    │\n├──────┬              ├──────┬─────┤\n│ root │              │ name │ ext │\n\"  /    home/user/dir / file  .txt \"\n└──────┴──────────────┴──────┴─────┘\n(All spaces in the \"\" line should be ignored. They are purely for formatting.)"},{"type":"paragraph","children":[{"type":"text","value":"On Windows:"}]},{"type":"code_block","language":"javascript","code":"path.parse('C:\\\\path\\\\dir\\\\file.txt');\n// Returns:\n// { root: 'C:\\\\',\n//   dir: 'C:\\\\path\\\\dir',\n//   base: 'file.txt',\n//   ext: '.txt',\n//   name: 'file' }"},{"type":"code_block","language":"text","code":"┌─────────────────────┬────────────┐\n│          dir        │    base    │\n├──────┬              ├──────┬─────┤\n│ root │              │ name │ ext │\n\" C:\\      path\\dir   \\ file  .txt \"\n└──────┴──────────────┴──────┴─────┘\n(All spaces in the \"\" line should be ignored. They are purely for formatting.)"},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"link","href":"api/errors.html#class-typeerror","title":null,"children":[{"type":"inline_code","code":"TypeError"}]},{"type":"text","value":" is thrown if "},{"type":"inline_code","code":"path"},{"type":"text","value":" is not a string."}]},{"type":"heading","level":2,"id":null,"children":[{"type":"inline_code","code":"path.posix"},{"type":"anchor","id":"path_path_posix"},{"type":"anchor","id":"pathposix"}]},{"type":"text","value":"Added in: v0.11.15History"},{"type":"table","headers":[{"children":[{"type":"text","value":"Version"}]},{"children":[{"type":"text","value":"Changes"}]}],"rows":[{"cells":[{"children":[{"type":"text","value":"v15.3.0"}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"Exposed as "},{"type":"inline_code","code":"require('path/posix')"},{"type":"text","value":"."}]}]}]}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"text","value":"Type: "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Reference/Global_Objects/Object","title":null,"children":[{"type":"inline_code","code":"<Object>"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inline_code","code":"path.posix"},{"type":"text","value":" property provides access to POSIX specific implementations of the "},{"type":"inline_code","code":"path"},{"type":"text","value":" methods."}]},{"type":"paragraph","children":[{"type":"text","value":"The API is accessible via "},{"type":"inline_code","code":"require('node:path').posix"},{"type":"text","value":" or "},{"type":"inline_code","code":"require('node:path/posix')"},{"type":"text","value":"."}]},{"type":"heading","level":2,"id":null,"children":[{"type":"inline_code","code":"path.relative(from, to)"},{"type":"anchor","id":"path_path_relative_from_to"},{"type":"anchor","id":"pathrelativefrom-to"}]},{"type":"text","value":"Added in: v0.5.0History"},{"type":"table","headers":[{"children":[{"type":"text","value":"Version"}]},{"children":[{"type":"text","value":"Changes"}]}],"rows":[{"cells":[{"children":[{"type":"text","value":"v6.8.0"}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"On Windows, the leading slashes for UNC paths are now included in the return value."}]}]}]}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"inline_code","code":"from"},{"type":"text","value":" "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]}]},{"children":[{"type":"inline_code","code":"to"},{"type":"text","value":" "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]}]},{"children":[{"type":"text","value":"Returns: "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inline_code","code":"path.relative()"},{"type":"text","value":" method returns the relative path from "},{"type":"inline_code","code":"from"},{"type":"text","value":" to "},{"type":"inline_code","code":"to"},{"type":"text","value":" based on the current working directory. If "},{"type":"inline_code","code":"from"},{"type":"text","value":" and "},{"type":"inline_code","code":"to"},{"type":"text","value":" each resolve to the same path (after calling "},{"type":"inline_code","code":"path.resolve()"},{"type":"text","value":" on each), a zero-length string is returned."}]},{"type":"paragraph","children":[{"type":"text","value":"If a zero-length string is passed as "},{"type":"inline_code","code":"from"},{"type":"text","value":" or "},{"type":"inline_code","code":"to"},{"type":"text","value":", the current working directory will be used instead of the zero-length strings."}]},{"type":"paragraph","children":[{"type":"text","value":"For example, on POSIX:"}]},{"type":"code_block","language":"javascript","code":"path.relative('/data/orandea/test/aaa', '/data/orandea/impl/bbb');\n// Returns: '../../impl/bbb'"},{"type":"paragraph","children":[{"type":"text","value":"On Windows:"}]},{"type":"code_block","language":"javascript","code":"path.relative('C:\\\\orandea\\\\test\\\\aaa', 'C:\\\\orandea\\\\impl\\\\bbb');\n// Returns: '..\\\\..\\\\impl\\\\bbb'"},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"link","href":"api/errors.html#class-typeerror","title":null,"children":[{"type":"inline_code","code":"TypeError"}]},{"type":"text","value":" is thrown if either "},{"type":"inline_code","code":"from"},{"type":"text","value":" or "},{"type":"inline_code","code":"to"},{"type":"text","value":" is not a string."}]},{"type":"heading","level":2,"id":null,"children":[{"type":"inline_code","code":"path.resolve([...paths])"},{"type":"anchor","id":"path_path_resolve_paths"},{"type":"anchor","id":"pathresolvepaths"}]},{"type":"text","value":"Added in: v0.3.4"},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"inline_code","code":"...paths"},{"type":"text","value":" "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]},{"type":"text","value":" A sequence of paths or path segments"}]},{"children":[{"type":"text","value":"Returns: "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inline_code","code":"path.resolve()"},{"type":"text","value":" method resolves a sequence of paths or path segments into an absolute path."}]},{"type":"paragraph","children":[{"type":"text","value":"The given sequence of paths is processed from right to left, with each subsequent "},{"type":"inline_code","code":"path"},{"type":"text","value":" prepended until an absolute path is constructed. For instance, given the sequence of path segments: "},{"type":"inline_code","code":"/foo"},{"type":"text","value":", "},{"type":"inline_code","code":"/bar"},{"type":"text","value":", "},{"type":"inline_code","code":"baz"},{"type":"text","value":", calling "},{"type":"inline_code","code":"path.resolve('/foo', '/bar', 'baz')"},{"type":"text","value":" would return "},{"type":"inline_code","code":"/bar/baz"},{"type":"text","value":" because "},{"type":"inline_code","code":"'baz'"},{"type":"text","value":" is not an absolute path but "},{"type":"inline_code","code":"'/bar' + '/' + 'baz'"},{"type":"text","value":" is."}]},{"type":"paragraph","children":[{"type":"text","value":"If, after processing all given "},{"type":"inline_code","code":"path"},{"type":"text","value":" segments, an absolute path has not yet been generated, the current working directory is used."}]},{"type":"paragraph","children":[{"type":"text","value":"The resulting path is normalized and trailing slashes are removed unless the path is resolved to the root directory."}]},{"type":"paragraph","children":[{"type":"text","value":"Zero-length "},{"type":"inline_code","code":"path"},{"type":"text","value":" segments are ignored."}]},{"type":"paragraph","children":[{"type":"text","value":"If no "},{"type":"inline_code","code":"path"},{"type":"text","value":" segments are passed, "},{"type":"inline_code","code":"path.resolve()"},{"type":"text","value":" will return the absolute path of the current working directory."}]},{"type":"code_block","language":"javascript","code":"path.resolve('/foo/bar', './baz');\n// Returns: '/foo/bar/baz'\n\npath.resolve('/foo/bar', '/tmp/file/');\n// Returns: '/tmp/file'\n\npath.resolve('wwwroot', 'static_files/png/', '../gif/image.gif');\n// If the current working directory is /home/myself/node,\n// this returns '/home/myself/node/wwwroot/static_files/gif/image.gif'"},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"link","href":"api/errors.html#class-typeerror","title":null,"children":[{"type":"inline_code","code":"TypeError"}]},{"type":"text","value":" is thrown if any of the arguments is not a string."}]},{"type":"heading","level":2,"id":null,"children":[{"type":"inline_code","code":"path.sep"},{"type":"anchor","id":"path_path_sep"},{"type":"anchor","id":"pathsep"}]},{"type":"text","value":"Added in: v0.7.9"},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"text","value":"Type: "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Provides the platform-specific path segment separator:"}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"inline_code","code":"\\"},{"type":"text","value":" on Windows"}]},{"children":[{"type":"inline_code","code":"/"},{"type":"text","value":" on POSIX"}]}]},{"type":"paragraph","children":[{"type":"text","value":"For example, on POSIX:"}]},{"type":"code_block","language":"javascript","code":"'foo/bar/baz'.split(path.sep);\n// Returns: ['foo', 'bar', 'baz']"},{"type":"paragraph","children":[{"type":"text","value":"On Windows:"}]},{"type":"code_block","language":"javascript","code":"'foo\\\\bar\\\\baz'.split(path.sep);\n// Returns: ['foo', 'bar', 'baz']"},{"type":"paragraph","children":[{"type":"text","value":"On Windows, both the forward slash ("},{"type":"inline_code","code":"/"},{"type":"text","value":") and backward slash ("},{"type":"inline_code","code":"\\"},{"type":"text","value":") are accepted as path segment separators; however, the "},{"type":"inline_code","code":"path"},{"type":"text","value":" methods only add backward slashes ("},{"type":"inline_code","code":"\\"},{"type":"text","value":")."}]},{"type":"heading","level":2,"id":null,"children":[{"type":"inline_code","code":"path.toNamespacedPath(path)"},{"type":"anchor","id":"path_path_tonamespacedpath_path"},{"type":"anchor","id":"pathtonamespacedpathpath"}]},{"type":"text","value":"Added in: v9.0.0"},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"inline_code","code":"path"},{"type":"text","value":" "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]}]},{"children":[{"type":"text","value":"Returns: "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"On Windows systems only, returns an equivalent "},{"type":"link","href":"https://docs.microsoft.com/en-us/windows/desktop/FileIO/naming-a-file#namespaces","title":null,"children":[{"type":"text","value":"namespace-prefixed path"}]},{"type":"text","value":" for the given "},{"type":"inline_code","code":"path"},{"type":"text","value":". If "},{"type":"inline_code","code":"path"},{"type":"text","value":" is not a string, "},{"type":"inline_code","code":"path"},{"type":"text","value":" will be returned without modifications."}]},{"type":"paragraph","children":[{"type":"text","value":"This method is meaningful only on Windows systems. On POSIX systems, the method is non-operational and always returns "},{"type":"inline_code","code":"path"},{"type":"text","value":" without modifications."}]},{"type":"heading","level":2,"id":null,"children":[{"type":"inline_code","code":"path.win32"},{"type":"anchor","id":"path_path_win32"},{"type":"anchor","id":"pathwin32"}]},{"type":"text","value":"Added in: v0.11.15History"},{"type":"table","headers":[{"children":[{"type":"text","value":"Version"}]},{"children":[{"type":"text","value":"Changes"}]}],"rows":[{"cells":[{"children":[{"type":"text","value":"v15.3.0"}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"Exposed as "},{"type":"inline_code","code":"require('path/win32')"},{"type":"text","value":"."}]}]}]}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"text","value":"Type: "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Reference/Global_Objects/Object","title":null,"children":[{"type":"inline_code","code":"<Object>"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inline_code","code":"path.win32"},{"type":"text","value":" property provides access to Windows-specific implementations of the "},{"type":"inline_code","code":"path"},{"type":"text","value":" methods."}]},{"type":"paragraph","children":[{"type":"text","value":"The API is accessible via "},{"type":"inline_code","code":"require('node:path').win32"},{"type":"text","value":" or "},{"type":"inline_code","code":"require('node:path/win32')"},{"type":"text","value":"."}]}]}}
