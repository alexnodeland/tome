az/asdf/quux.html');\n// Returns: 'quux.html'\n\npath.basename('/foo/bar/baz/asdf/quux.html', '.html');\n// Returns: 'quux'"},{"type":"paragraph","children":[{"type":"text","value":"Although Windows usually treats file names, including file extensions, in a case-insensitive manner, this function does not. For example, "},{"type":"inline_code","code":"C:\\\\foo.html"},{"type":"text","value":" and "},{"type":"inline_code","code":"C:\\\\foo.HTML"},{"type":"text","value":" refer to the same file, but "},{"type":"inline_code","code":"basename"},{"type":"text","value":" treats the extension as a case-sensitive string:"}]},{"type":"code_block","language":"javascript","code":"path.win32.basename('C:\\\\foo.html', '.html');\n// Returns: 'foo'\n\npath.win32.basename('C:\\\\foo.HTML', '.html');\n// Returns: 'foo.HTML'"},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"link","href":"api/errors.html#class-typeerror","title":null,"children":[{"type":"inline_code","code":"TypeError"}]},{"type":"text","value":" is thrown if "},{"type":"inline_code","code":"path"},{"type":"text","value":" is not a string or if "},{"type":"inline_code","code":"suffix"},{"type":"text","value":" is given and is not a string."}]},{"type":"heading","level":2,"id":null,"children":[{"type":"inline_code","code":"path.delimiter"},{"type":"anchor","id":"path_path_delimiter"},{"type":"anchor","id":"pathdelimiter"}]},{"type":"text","value":"Added in: v0.9.3"},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"text","value":"Type: "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"Provides the platform-specific path delimiter:"}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"inline_code","code":";"},{"type":"text","value":" for Windows"}]},{"children":[{"type":"inline_code","code":":"},{"type":"text","value":" for POSIX"}]}]},{"type":"paragraph","children":[{"type":"text","value":"For example, on POSIX:"}]},{"type":"code_block","language":"javascript","code":"console.log(process.env.PATH);\n// Prints: '/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin'\n\nprocess.env.PATH.split(path.delimiter);\n// Returns: ['/usr/bin', '/bin', '/usr/sbin', '/sbin', '/usr/local/bin']"},{"type":"paragraph","children":[{"type":"text","value":"On Windows:"}]},{"type":"code_block","language":"javascript","code":"console.log(process.env.PATH);\n// Prints: 'C:\\Windows\\system32;C:\\Windows;C:\\Program Files\\node\\'\n\nprocess.env.PATH.split(path.delimiter);\n// Returns ['C:\\\\Windows\\\\system32', 'C:\\\\Windows', 'C:\\\\Program Files\\\\node\\\\']"},{"type":"heading","level":2,"id":null,"children":[{"type":"inline_code","code":"path.dirname(path)"},{"type":"anchor","id":"path_path_dirname_path"},{"type":"anchor","id":"pathdirnamepath"}]},{"type":"text","value":"Added in: v0.1.16History"},{"type":"table","headers":[{"children":[{"type":"text","value":"Version"}]},{"children":[{"type":"text","value":"Changes"}]}],"rows":[{"cells":[{"children":[{"type":"text","value":"v6.0.0"}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"Passing a non-string as the "},{"type":"inline_code","code":"path"},{"type":"text","value":" argument will throw now."}]}]}]}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"inline_code","code":"path"},{"type":"text","value":" "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]}]},{"children":[{"type":"text","value":"Returns: "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inline_code","code":"path.dirname()"},{"type":"text","value":" method returns the directory name of a "},{"type":"inline_code","code":"path"},{"type":"text","value":", similar to the Unix "},{"type":"inline_code","code":"dirname"},{"type":"text","value":" command. Trailing directory separators are ignored, see "},{"type":"link","href":"api/path.html#pathsep","title":null,"children":[{"type":"inline_code","code":"path.sep"}]},{"type":"text","value":"."}]},{"type":"code_block","language":"javascript","code":"path.dirname('/foo/bar/baz/asdf/quux');\n// Returns: '/foo/bar/baz/asdf'"},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"link","href":"api/errors.html#class-typeerror","title":null,"children":[{"type":"inline_code","code":"TypeError"}]},{"type":"text","value":" is thrown if "},{"type":"inline_code","code":"path"},{"type":"text","value":" is not a string."}]},{"type":"heading","level":2,"id":null,"children":[{"type":"inline_code","code":"path.extname(path)"},{"type":"anchor","id":"path_path_extname_path"},{"type":"anchor","id":"pathextnamepath"}]},{"type":"text","value":"Added in: v0.1.25History"},{"type":"table","headers":[{"children":[{"type":"text","value":"Version"}]},{"children":[{"type":"text","value":"Changes"}]}],"rows":[{"cells":[{"children":[{"type":"text","value":"v6.0.0"}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"Passing a non-string as the "},{"type":"inline_code","code":"path"},{"type":"text","value":" argument will throw now."}]}]}]}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"inline_code","code":"path"},{"type":"text","value":" "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]}]},{"children":[{"type":"text","value":"Returns: "},{"type":"link","href":"https://developer.mozilla.org/docs/Web/JavaScript/Data_structures#string_type","title":null,"children":[{"type":"inline_code","code":"<string>"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inline_code","code":"path.extname()"},{"type":"text","value":" method returns the extension of the "},{"type":"inline_code","code":"path"},{"type":"text","value":", from the last occurrence of the "},{"type":"inline_code","code":"."},{"type":"text","value":" (period) character to end of string in the last portion of the "},{"type":"inline_code","code":"path"},{"type":"text","value":". If there is no "},{"type":"inline_code","code":"."},{"type":"text","value":" in the last portion of the "},{"type":"inline_code","code":"path"},{"type":"text","value":", or if there are no "},{"type":"inline_code","code":"."},{"type":"text","value":" characters other than the first character of the basename of "},{"type":"inline_code","code":"path"},{"type":"text","value":" (see "},{"type":"inline_code","code":"path.basename()"},{"type":"text","value":") , an empty string is returned."}]},{"type":"code_block","language":"javascript","code":"path.extname('index.html');\n// Returns: '.html'\n\npath.extname('index.coffee.md');\n// Returns: '.md'\n\npath.extname('index.');\n// Returns: '.'\n\npath.extname('index');\n// Returns: ''\n\npath.extname('.index');\n// Returns: ''\n\npath.extname('.index.md');\n// Returns: '.md'"},{"type":"paragraph","children":[{"type":"text","value":"A "},{"type":"link","href":"api/errors.html#class-typeerror","title":null,"children":[{"type":"inline_code","code":"TypeError"}]},{"type":"text","value":" is thrown if "},{"type":"inline_code","code":"path"},{"type":"text","value":" is not a string."}]},{"type":"heading","level":2,"id":null,"children":[{"type":"inline_code","code":"path.format(pathObject)"},{"type":"anchor","id":"path_path_format_pathobject"},{"type":"anchor","id":"pathformatpathobject"}]},{"type":"text","value":"Added in: v0.11.15History"},{"type":"table","headers":[{"children":[{"type":"text","value":"Version"}