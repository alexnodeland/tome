derr"}]},{"type":"text","value":". The global "},{"type":"inline_code","code":"console"},{"type":"text","value":" can be used without calling "},{"type":"inline_code","code":"require('node:console')"},{"type":"text","value":"."}]}]},{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"strong","children":[{"type":"text","value":"Warning"}]}]},{"type":"text","value":": The global console object's methods are neither consistently synchronous like the browser APIs they resemble, nor are they consistently asynchronous like all other Node.js streams. Programs that desire to depend on the synchronous / asynchronous behavior of the console functions should first figure out the nature of console's backing stream. This is because the stream is dependent on the underlying platform and standard stream configuration of the current process. See the "},{"type":"link","href":"https://nodejs.org/api/process.html#a-note-on-process-io","title":null,"children":[{"type":"text","value":"note on process I/O"}]},{"type":"text","value":" for more information."}]},{"type":"paragraph","children":[{"type":"text","value":"Example using the global "},{"type":"inline_code","code":"console"},{"type":"text","value":":"}]},{"type":"code_block","language":"javascript","code":"console.log('hello world');\n// Prints: hello world, to stdout\nconsole.log('hello %s', 'world');\n// Prints: hello world, to stdout\nconsole.error(new Error('Whoops, something bad happened'));\n// Prints error message and stack trace to stderr:\n//   Error: Whoops, something bad happened\n//     at [eval]:5:15\n//     at Script.runInThisContext (node:vm:132:18)\n//     at Object.runInThisContext (node:vm:309:38)\n//     at node:internal/process/execution:77:19\n//     at [eval]-wrapper:6:22\n//     at evalScript (node:internal/process/execution:76:60)\n//     at node:internal/main/eval_string:23:3\n\nconst name = 'Will Robinson';\nconsole.warn(`Danger ${name}! Danger!`);\n// Prints: Danger Will Robinson! Danger!, to stderr"},{"type":"paragraph","children":[{"type":"text","value":"Example using the "},{"type":"inline_code","code":"Console"},{"type":"text","value":" class:"}]},{"type":"code_block","language":"javascript","code":"const out = getStreamSomehow();\nconst err = getStreamSomehow();\nconst myConsole = new console.Console(out, err);\n\nmyConsole.log('hello world');\n// Prints: hello world, to out\nmyConsole.log('hello %s', 'world');\n// Prints: hello world, to out\nmyConsole.error(new Error('Whoops, something bad happened'));\n// Prints: [Error: Whoops, something bad happened], to err\n\nconst name = 'Will Robinson';\nmyConsole.warn(`Danger ${name}! Danger!`);\n// Prints: Danger Will Robinson! Danger!, to err"},{"type":"heading","level":2,"id":null,"children":[{"type":"text","value":"Class: "},{"type":"inline_code","code":"Console"},{"type":"anchor","id":"console_class_console"},{"type":"anchor","id":"class-console"}]},{"type":"text","value":"History"},{"type":"table","headers":[{"children":[{"type":"text","value":"Version"}]},{"children":[{"type":"text","value":"Changes"}]}],"rows":[{"cells":[{"children":[{"type":"text","value":"v8.0.0"}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"Errors that occur while writing to the underlying streams will now be ignored by default."}]}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inline_code","code":"Console"},{"type":"text","value":" class can be used to create a simple logger with configurable output streams and can be accessed using either "},{"type":"inline_code","code":"require('node:console').Console"},{"type":"text","value":" or "},{"type":"inline_code","code":"console.Console"},{"type":"text","value":" (or their destructured counterparts):"}]},{"type":"code_block","language":"mjs","code":"import { Console } from 'node:console';"},{"type":"code_block","language":"javascript","code":"const { Console } = console;"},{"type":"heading","level":3,"id":null,"childre