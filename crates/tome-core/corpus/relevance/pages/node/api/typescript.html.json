{"path":"api/typescript.html","title":"Modules: TypeScript","description":"Removed --experimental-transform-types flag.","body":{"type":"document","children":[{"type":"heading","level":1,"id":null,"children":[{"type":"text","value":"Modules: TypeScript"},{"type":"anchor","id":"typescript_modules_typescript"},{"type":"anchor","id":"modules-typescript"}]},{"type":"text","value":"History"},{"type":"table","headers":[{"children":[{"type":"text","value":"Version"}]},{"children":[{"type":"text","value":"Changes"}]}],"rows":[{"cells":[{"children":[{"type":"text","value":"v26.0.0"}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"Removed "},{"type":"inline_code","code":"--experimental-transform-types"},{"type":"text","value":" flag."}]}]}]},{"cells":[{"children":[{"type":"text","value":"v25.2.0, v24.12.0"}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"Type stripping is now stable."}]}]}]},{"cells":[{"children":[{"type":"text","value":"v24.3.0, v22.18.0"}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"Type stripping no longer emits an experimental warning."}]}]}]},{"cells":[{"children":[{"type":"text","value":"v23.6.0, v22.18.0"}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"Type stripping is enabled by default."}]}]}]},{"cells":[{"children":[{"type":"text","value":"v22.7.0"}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"Added "},{"type":"inline_code","code":"--experimental-transform-types"},{"type":"text","value":" flag."}]}]}]}]},{"type":"paragraph","children":[{"type":"link","href":"api/documentation.html#stability-index","title":null,"children":[{"type":"text","value":"Stability: 2"}]},{"type":"text","value":" - Stable"}]},{"type":"heading","level":2,"id":null,"children":[{"type":"text","value":"Enabling"},{"type":"anchor","id":"typescript_enabling"},{"type":"anchor","id":"enabling"}]},{"type":"paragraph","children":[{"type":"text","value":"There are two ways to enable runtime TypeScript support in Node.js:"}]},{"type":"list","ordered":true,"start":null,"items":[{"children":[{"type":"paragraph","children":[{"type":"text","value":"For "},{"type":"link","href":"api/typescript.html#full-typescript-support","title":null,"children":[{"type":"text","value":"full support"}]},{"type":"text","value":" of all of TypeScript's syntax and features, including using any version of TypeScript, use a third-party package."}]}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"For lightweight support, you can use the built-in support for "},{"type":"link","href":"api/typescript.html#type-stripping","title":null,"children":[{"type":"text","value":"type stripping"}]},{"type":"text","value":"."}]}]}]},{"type":"heading","level":2,"id":null,"children":[{"type":"text","value":"Full TypeScript support"},{"type":"anchor","id":"typescript_full_typescript_support"},{"type":"anchor","id":"full-typescript-support"}]},{"type":"paragraph","children":[{"type":"text","value":"To use TypeScript with full support for all TypeScript features, including "},{"type":"inline_code","code":"tsconfig.json"},{"type":"text","value":", you can use a third-party package. These instructions use "},{"type":"link","href":"https://tsx.hirok.io/","title":null,"children":[{"type":"inline_code","code":"tsx"}]},{"type":"text","value":" as an example but there are many other similar libraries available."}]},{"type":"list","ordered":true,"start":null,"items":[{"children":[{"type":"paragraph","children":[{"type":"text","value":"Install the package as a development dependency using whatever package manager you're using for your project. For example, with "},{"type":"inline_code","code":"npm"},{"type":"text","value":":"}]},{"type":"code_block","language":"bash","code":"npm install --save-dev tsx"}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"Then you can run your TypeScript code via:"}]},{"type":"code_block","language":"bash","code":"npx tsx your-file.ts"},{"type":"paragraph","children":[{"type":"text","value":"Or alternatively, you can run with "},{"type":"inline_code","code":"node"},{"type":"text","value":" via:"}]},{"type":"code_block","language":"bash","code":"node --import=tsx your-file.ts"}]}]},{"type":"heading","level":2,"id":null,"children":[{"type":"text","value":"Type stripping"},{"type":"anchor","id":"typescript_type_stripping"},{"type":"anchor","id":"type-stripping"}]},{"type":"text","value":"Added in: v22.6.0History"},{"type":"table","headers":[{"children":[{"type":"text","value":"Version"}]},{"children":[{"type":"text","value":"Changes"}]}],"rows":[{"cells":[{"children":[{"type":"text","value":"v25.2.0, v24.12.0"}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"Type stripping is now stable."}]}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"By default Node.js will execute TypeScript files that contains only erasable TypeScript syntax. Node.js will replace TypeScript syntax with whitespace, and no type checking is performed. To disable this feature, use the flag "},{"type":"link","href":"api/cli.html#--no-strip-types","title":null,"children":[{"type":"inline_code","code":"--no-strip-types"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Node.js ignores "},{"type":"inline_code","code":"tsconfig.json"},{"type":"text","value":" files and therefore features that depend on settings within "},{"type":"inline_code","code":"tsconfig.json"},{"type":"text","value":", such as paths or converting newer JavaScript syntax to older standards, are intentionally unsupported. To get full TypeScript support, see "},{"type":"link","href":"api/typescript.html#full-typescript-support","title":null,"children":[{"type":"text","value":"Full TypeScript support"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"The type stripping feature is designed to be lightweight. By intentionally not supporting syntaxes that require JavaScript code generation, and by replacing inline types with whitespace, Node.js can run TypeScript code without the need for source maps."}]},{"type":"paragraph","children":[{"type":"text","value":"Type stripping is compatible with most versions of TypeScript but we recommend version 5.8 or newer with the following "},{"type":"inline_code","code":"tsconfig.json"},{"type":"text","value":" settings:"}]},{"type":"code_block","language":"json","code":"{\n  \"compilerOptions\": {\n     \"noEmit\": true, // Optional - see note below\n     \"target\": \"esnext\",\n     \"module\": \"nodenext\",\n     \"rewriteRelativeImportExtensions\": true,\n     \"erasableSyntaxOnly\": true,\n     \"verbatimModuleSyntax\": true\n  }\n}"},{"type":"paragraph","children":[{"type":"text","value":"Use the "},{"type":"inline_code","code":"noEmit"},{"type":"text","value":" option if you intend to only execute "},{"type":"inline_code","code":"*.ts"},{"type":"text","value":" files, for example a build script. You won't need this flag if you intend to distribute "},{"type":"inline_code","code":"*.js"},{"type":"text","value":" files."}]},{"type":"heading","level":3,"id":null,"children":[{"type":"text","value":"Determining module system"},{"type":"anchor","id":"typescript_determining_module_system"},{"type":"anchor","id":"determining-module-system"}]},{"type":"paragraph","children":[{"type":"text","value":"Node.js supports both "},{"type":"link","href":"api/modules.html","title":null,"children":[{"type":"text","value":"CommonJS"}]},{"type":"text","value":" and "},{"type":"link","href":"api/esm.html","title":null,"children":[{"type":"text","value":"ES Modules"}]},{"type":"text","value":" syntax in TypeScript files. Node.js will not convert from one module system to another; if you want your code to run as an ES module, you must use "},{"type":"inline_code","code":"import"},{"type":"text","value":" and "},{"type":"inline_code","code":"export"},{"type":"text","value":" syntax, and if you want your code to run as CommonJS you must use "},{"type":"inline_code","code":"require"},{"type":"text","value":" and "},{"type":"inline_code","code":"module.exports"},{"type":"text","value":"."}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"inline_code","code":".ts"},{"type":"text","value":" files will have their module system determined "},{"type":"link","href":"api/packages.html#determining-module-system","title":null,"children":[{"type":"text","value":"the same way as "},{"type":"inline_code","code":".js"},{"type":"text","value":" files."}]},{"type":"text","value":" To use "},{"type":"inline_code","code":"import"},{"type":"text","value":" and "},{"type":"inline_code","code":"export"},{"type":"text","value":" syntax, add "},{"type":"inline_code","code":"\"type\": \"module\""},{"type":"text","value":" to the nearest parent "},{"type":"inline_code","code":"package.json"},{"type":"text","value":"."}]},{"children":[{"type":"inline_code","code":".mts"},{"type":"text","value":" files will always be run as ES modules, similar to "},{"type":"inline_code","code":".mjs"},{"type":"text","value":" files."}]},{"children":[{"type":"inline_code","code":".cts"},{"type":"text","value":" files will always be run as CommonJS modules, similar to "},{"type":"inline_code","code":".cjs"},{"type":"text","value":" files."}]},{"children":[{"type":"inline_code","code":".tsx"},{"type":"text","value":" files are unsupported."}]}]},{"type":"paragraph","children":[{"type":"text","value":"As in JavaScript files, "},{"type":"link","href":"api/esm.html#mandatory-file-extensions","title":null,"children":[{"type":"text","value":"file extensions are mandatory"}]},{"type":"text","value":" in "},{"type":"inline_code","code":"import"},{"type":"text","value":" statements and "},{"type":"inline_code","code":"import()"},{"type":"text","value":" expressions: "},{"type":"inline_code","code":"import './file.ts'"},{"type":"text","value":", not "},{"type":"inline_code","code":"import './file'"},{"type":"text","value":". Because of backward compatibility, file extensions are also mandatory in "},{"type":"inline_code","code":"require()"},{"type":"text","value":" calls: "},{"type":"inline_code","code":"require('./file.ts')"},{"type":"text","value":", not "},{"type":"inline_code","code":"require('./file')"},{"type":"text","value":", similar to how the "},{"type":"inline_code","code":".cjs"},{"type":"text","value":" extension is mandatory in "},{"type":"inline_code","code":"require"},{"type":"text","value":" calls in CommonJS files."}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inline_code","code":"tsconfig.json"},{"type":"text","value":" option "},{"type":"inline_code","code":"allowImportingTsExtensions"},{"type":"text","value":" will allow the TypeScript compiler "},{"type":"inline_code","code":"tsc"},{"type":"text","value":" to type-check files with "},{"type":"inline_code","code":"import"},{"type":"text","value":" specifiers that include the "},{"type":"inline_code","code":".ts"},{"type":"text","value":" extension."}]},{"type":"heading","level":3,"id":null,"children":[{"type":"text","value":"TypeScript features"},{"type":"anchor","id":"typescript_typescript_features"},{"type":"anchor","id":"typescript-features"}]},{"type":"paragraph","children":[{"type":"text","value":"Since Node.js is only removing inline types, any TypeScript features that involve "},{"type":"emphasis","children":[{"type":"text","value":"replacing"}]},{"type":"text","value":" TypeScript syntax with new JavaScript syntax will error."}]},{"type":"paragraph","children":[{"type":"text","value":"The most prominent features that require transformation are:"}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"inline_code","code":"Enum"},{"type":"text","value":" declarations"}]},{"children":[{"type":"inline_code","code":"namespace"},{"type":"text","value":" with runtime code"}]},{"children":[{"type":"text","value":"parameter properties"}]},{"children":[{"type":"text","value":"import aliases"}]}]},{"type":"paragraph","children":[{"type":"inline_code","code":"namespace"},{"type":"text","value":"s that do not contain runtime code are supported. This example will work correctly:"}]},{"type":"code_block","language":"typescript","code":"// This namespace is exporting a type\nnamespace TypeOnly {\n   export type A = string;\n}"},{"type":"paragraph","children":[{"type":"text","value":"This will result in "},{"type":"link","href":"api/errors.html#err_unsupported_typescript_syntax","title":null,"children":[{"type":"inline_code","code":"ERR_UNSUPPORTED_TYPESCRIPT_SYNTAX"}]},{"type":"text","value":" error:"}]},{"type":"code_block","language":"typescript","code":"// This namespace is exporting a value\nnamespace A {\n   export let x = 1\n}"},{"type":"paragraph","children":[{"type":"text","value":"Since Decorators are currently a "},{"type":"link","href":"https://github.com/tc39/proposal-decorators","title":null,"children":[{"type":"text","value":"TC39 Stage 3 proposal"}]},{"type":"text","value":", they are not transformed and will result in a parser error. Node.js does not provide polyfills and thus will not support decorators until they are supported natively in JavaScript."}]},{"type":"paragraph","children":[{"type":"text","value":"In addition, Node.js does not read "},{"type":"inline_code","code":"tsconfig.json"},{"type":"text","value":" files and does not support features that depend on settings within "},{"type":"inline_code","code":"tsconfig.json"},{"type":"text","value":", such as paths or converting newer JavaScript syntax into older standards."}]},{"type":"heading","level":3,"id":null,"children":[{"type":"text","value":"Importing types without "},{"type":"inline_code","code":"type"},{"type":"text","value":" keyword"},{"type":"anchor","id":"typescript_importing_types_without_type_keyword"},{"type":"anchor","id":"importing-types-without-type-keyword"}]},{"type":"paragraph","children":[{"type":"text","value":"Due to the nature of type stripping, the "},{"type":"inline_code","code":"type"},{"type":"text","value":" keyword is necessary to correctly strip type imports. Without the "},{"type":"inline_code","code":"type"},{"type":"text","value":" keyword, Node.js will treat the import as a value import, which will result in a runtime error. The tsconfig option "},{"type":"link","href":"https://www.typescriptlang.org/tsconfig/#verbatimModuleSyntax","title":null,"children":[{"type":"inline_code","code":"verbatimModuleSyntax"}]},{"type":"text","value":" can be used to match this behavior."}]},{"type":"paragraph","children":[{"type":"text","value":"This example will work correctly:"}]},{"type":"code_block","language":"typescript","code":"import type { Type1, Type2 } from './module.ts';\nimport { fn, type FnParams } from './fn.ts';"},{"type":"paragraph","children":[{"type":"text","value":"This will result in a runtime error:"}]},{"type":"code_block","language":"typescript","code":"import { Type1, Type2 } from './module.ts';\nimport { fn, FnParams } from './fn.ts';"},{"type":"heading","level":3,"id":null,"children":[{"type":"text","value":"Non-file forms of input"},{"type":"anchor","id":"typescript_non_file_forms_of_input"},{"type":"anchor","id":"non-file-forms-of-input"}]},{"type":"paragraph","children":[{"type":"text","value":"Type stripping can be enabled for "},{"type":"inline_code","code":"--eval"},{"type":"text","value":" and STDIN. The module system will be determined by "},{"type":"inline_code","code":"--input-type"},{"type":"text","value":", as it is for JavaScript."}]},{"type":"paragraph","children":[{"type":"text","value":"TypeScript syntax is unsupported in the REPL, "},{"type":"inline_code","code":"--check"},{"type":"text","value":", and "},{"type":"inline_code","code":"inspect"},{"type":"text","value":"."}]},{"type":"heading","level":3,"id":null,"children":[{"type":"text","value":"Source maps"},{"type":"anchor","id":"typescript_source_maps"},{"type":"anchor","id":"source-maps"}]},{"type":"paragraph","children":[{"type":"text","value":"Since inline types are replaced by whitespace, source maps are unnecessary for correct line numbers in stack traces; and Node.js does not generate them."}]},{"type":"heading","level":3,"id":null,"children":[{"type":"text","value":"Type stripping in dependencies"},{"type":"anchor","id":"typescript_type_stripping_in_dependencies"},{"type":"anchor","id":"type-stripping-in-dependencies"}]},{"type":"paragraph","children":[{"type":"text","value":"To discourage package authors from publishing packages written in TypeScript, Node.js refuses to handle TypeScript files inside folders under a "},{"type":"inline_code","code":"node_modules"},{"type":"text","value":" path."}]},{"type":"heading","level":3,"id":null,"children":[{"type":"text","value":"Paths aliases"},{"type":"anchor","id":"typescript_paths_aliases"},{"type":"anchor","id":"paths-aliases"}]},{"type":"paragraph","children":[{"type":"link","href":"https://www.typescriptlang.org/tsconfig/#paths","title":null,"children":[{"type":"inline_code","code":"tsconfig"},{"type":"text","value":" \"paths\""}]},{"type":"text","value":" won't be transformed and therefore produce an error. The closest feature available is "},{"type":"link","href":"api/packages.html#subpath-imports","title":null,"children":[{"type":"text","value":"subpath imports"}]},{"type":"text","value":" with the limitation that they need to start with "},{"type":"inline_code","code":"#"},{"type":"text","value":"."}]}]}}
