{"path":"api/synopsis.html","title":"Usage and example","description":"node [options] [V8 options] [script.js | -e \"script\" | - ] [arguments]","body":{"type":"document","children":[{"type":"heading","level":1,"id":null,"children":[{"type":"text","value":"Usage and example"},{"type":"anchor","id":"synopsis_usage_and_example"},{"type":"anchor","id":"usage-and-example"}]},{"type":"heading","level":2,"id":null,"children":[{"type":"text","value":"Usage"},{"type":"anchor","id":"synopsis_usage"},{"type":"anchor","id":"usage"}]},{"type":"paragraph","children":[{"type":"inline_code","code":"node [options] [V8 options] [script.js | -e \"script\" | - ] [arguments]"}]},{"type":"paragraph","children":[{"type":"text","value":"Please see the "},{"type":"link","href":"api/cli.html#options","title":null,"children":[{"type":"text","value":"Command-line options"}]},{"type":"text","value":" document for more information."}]},{"type":"heading","level":2,"id":null,"children":[{"type":"text","value":"Example"},{"type":"anchor","id":"synopsis_example"},{"type":"anchor","id":"example"}]},{"type":"paragraph","children":[{"type":"text","value":"An example of a "},{"type":"link","href":"api/http.html","title":null,"children":[{"type":"text","value":"web server"}]},{"type":"text","value":" written with Node.js which responds with "},{"type":"inline_code","code":"'Hello, World!'"},{"type":"text","value":":"}]},{"type":"paragraph","children":[{"type":"text","value":"Commands in this document start with "},{"type":"inline_code","code":"$"},{"type":"text","value":" or "},{"type":"inline_code","code":">"},{"type":"text","value":" to replicate how they would appear in a user's terminal. Do not include the "},{"type":"inline_code","code":"$"},{"type":"text","value":" and "},{"type":"inline_code","code":">"},{"type":"text","value":" characters. They are there to show the start of each command."}]},{"type":"paragraph","children":[{"type":"text","value":"Lines that don't start with "},{"type":"inline_code","code":"$"},{"type":"text","value":" or "},{"type":"inline_code","code":">"},{"type":"text","value":" character show the output of the previous command."}]},{"type":"paragraph","children":[{"type":"text","value":"First, make sure to have downloaded and installed Node.js. See "},{"type":"link","href":"https://nodejs.org/en/download/package-manager/","title":null,"children":[{"type":"text","value":"Installing Node.js via package manager"}]},{"type":"text","value":" for further install information."}]},{"type":"paragraph","children":[{"type":"text","value":"Now, create an empty project folder called "},{"type":"inline_code","code":"projects"},{"type":"text","value":", then navigate into it."}]},{"type":"paragraph","children":[{"type":"text","value":"Linux and Mac:"}]},{"type":"code_block","language":"bash","code":"mkdir ~/projects\ncd ~/projects"},{"type":"paragraph","children":[{"type":"text","value":"Windows CMD:"}]},{"type":"code_block","language":"powershell","code":"mkdir %USERPROFILE%\\projects\ncd %USERPROFILE%\\projects"},{"type":"paragraph","children":[{"type":"text","value":"Windows PowerShell:"}]},{"type":"code_block","language":"powershell","code":"mkdir $env:USERPROFILE\\projects\ncd $env:USERPROFILE\\projects"},{"type":"paragraph","children":[{"type":"text","value":"Next, create a new source file in the "},{"type":"inline_code","code":"projects"},{"type":"text","value":" folder and call it "},{"type":"inline_code","code":"hello-world.js"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Open "},{"type":"inline_code","code":"hello-world.js"},{"type":"text","value":" in any preferred text editor and paste in the following content:"}]},{"type":"code_block","language":"javascript","code":"const http = require('node:http');\n\nconst hostname = '127.0.0.1';\nconst port = 3000;\n\nconst server = http.createServer((req, res) => {\n  res.statusCode = 200;\n  res.setHeader('Content-Type', 'text/plain');\n  res.end('Hello, World!\\n');\n});\n\nserver.listen(port, hostname, () => {\n  console.log(`Server running at http://${hostname}:${port}/`);\n});"},{"type":"paragraph","children":[{"type":"text","value":"Save the file. Then, in the terminal window, to run the "},{"type":"inline_code","code":"hello-world.js"},{"type":"text","value":" file, enter:"}]},{"type":"code_block","language":"bash","code":"node hello-world.js"},{"type":"paragraph","children":[{"type":"text","value":"Output like this should appear in the terminal:"}]},{"type":"code_block","language":"bash","code":"Server running at http://127.0.0.1:3000/"},{"type":"paragraph","children":[{"type":"text","value":"Now, open any preferred web browser and visit "},{"type":"inline_code","code":"http://127.0.0.1:3000"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"If the browser displays the string "},{"type":"inline_code","code":"Hello, World!"},{"type":"text","value":", that indicates the server is working."}]}]}}
