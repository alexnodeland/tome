"},{"type":"link","href":"https://docs.python.org/3/reference/datamodel.html#code-objects","title":null,"children":[{"type":"text","value":"Code objects"}]},{"type":"text","value":" are only supported if "},{"type":"emphasis","children":[{"type":"text","value":"allow_code"}]},{"type":"text","value":" is true. Extra bytes in the input are ignored."}]},{"type":"paragraph","children":[{"type":"text","value":"Raises an "},{"type":"link","href":"3/library/sys.html#auditing","title":null,"children":[{"type":"text","value":"auditing event"}]},{"type":"text","value":" "},{"type":"inline_code","code":"marshal.loads"},{"type":"text","value":" with argument "},{"type":"inline_code","code":"bytes"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Changed in version 3.10: This call used to raise a "},{"type":"inline_code","code":"code.__new__"},{"type":"text","value":" audit event for each code object. Now it raises a single "},{"type":"inline_code","code":"marshal.loads"},{"type":"text","value":" event for the entire load operation."}]},{"type":"paragraph","children":[{"type":"text","value":"Changed in version 3.13: Added the "},{"type":"emphasis","children":[{"type":"text","value":"allow_code"}]},{"type":"text","value":" parameter."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"In addition, the following constants are defined:"}]},{"type":"definition_list","items":[{"id":"marshal.version","term":[{"type":"text","value":"marshal.version"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Indicates the format that the module uses. Version 0 is the historical first version; subsequent versions add new features. Generally, a new version becomes the default when it is introduced."}]},{"type":"table","headers":[{"children":[{"type":"paragraph","children":[{"type":"text","value":"Version"}]}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"Available since"}]}]},{"children":[{"type":"parag