{"path":"3/library/zoneinfo.html","title":"zoneinfo — IANA time zone support","description":"Added in version 3.9.","body":{"type":"document","children":[{"type":"anchor","id":"module-zoneinfo"},{"type":"anchor","id":"zoneinfo-iana-time-zone-support"},{"type":"heading","level":1,"id":null,"children":[{"type":"inline_code","code":"zoneinfo"},{"type":"text","value":" — IANA time zone support"}]},{"type":"paragraph","children":[{"type":"text","value":"Added in version 3.9."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Source code:"}]},{"type":"text","value":" "},{"type":"link","href":"https://github.com/python/cpython/tree/3.14/Lib/zoneinfo","title":null,"children":[{"type":"text","value":"Lib/zoneinfo"}]}]},{"type":"thematic_break"},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inline_code","code":"zoneinfo"},{"type":"text","value":" module provides a concrete time zone implementation to support the IANA time zone database as originally specified in "},{"type":"anchor","id":"index-0"},{"type":"link","href":"https://peps.python.org/pep-0615/","title":null,"children":[{"type":"strong","children":[{"type":"text","value":"PEP 615"}]}]},{"type":"text","value":". By default, "},{"type":"inline_code","code":"zoneinfo"},{"type":"text","value":" uses the system’s time zone data if available; if no system time zone data is available, the library will fall back to using the first-party "},{"type":"link","href":"https://pypi.org/project/tzdata/","title":null,"children":[{"type":"text","value":"tzdata"}]},{"type":"text","value":" package available on PyPI."}]},{"type":"admonition","kind":"seealso","title":"See also","children":[{"type":"definition_list","items":[{"id":null,"term":[{"type":"text","value":"Module: "},{"type":"link","href":"3/library/datetime.html#module-datetime","title":"datetime: Basic date and time types.","children":[{"type":"inline_code","code":"datetime"}]}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Provides the "},{"type":"link","href":"3/library/datetime.html#datetime.time","title":"datetime.time","children":[{"type":"inline_code","code":"time"}]},{"type":"text","value":" and "},{"type":"link","href":"3/library/datetime.html#datetime.datetime","title":"datetime.datetime","children":[{"type":"inline_code","code":"datetime"}]},{"type":"text","value":" types with which the "},{"type":"link","href":"3/library/zoneinfo.html#zoneinfo.ZoneInfo","title":"zoneinfo.ZoneInfo","children":[{"type":"inline_code","code":"ZoneInfo"}]},{"type":"text","value":" class is designed to be used."}]}]},{"id":null,"term":[{"type":"text","value":"Package "},{"type":"link","href":"https://pypi.org/project/tzdata/","title":null,"children":[{"type":"text","value":"tzdata"}]}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"First-party package maintained by the CPython core developers to supply time zone data via PyPI."}]}]}]}]},{"type":"paragraph","children":[{"type":"link","href":"3/library/intro.html#availability","title":null,"children":[{"type":"text","value":"Availability"}]},{"type":"text","value":": not WASI."}]},{"type":"paragraph","children":[{"type":"text","value":"This module does not work or is not available on WebAssembly. See "},{"type":"link","href":"3/library/intro.html#wasm-availability","title":null,"children":[{"type":"text","value":"WebAssembly platforms"}]},{"type":"text","value":" for more information."}]},{"type":"anchor","id":"using-zoneinfo"},{"type":"heading","level":2,"id":null,"children":[{"type":"text","value":"Using "},{"type":"inline_code","code":"ZoneInfo"}]},{"type":"paragraph","children":[{"type":"link","href":"3/library/zoneinfo.html#zoneinfo.ZoneInfo","title":"zoneinfo.ZoneInfo","children":[{"type":"inline_code","code":"ZoneInfo"}]},{"type":"text","value":" is a concrete implementation of the "},{"type":"link","href":"3/library/datetime.html#datetime.tzinfo","title":"datetime.tzinfo","children":[{"type":"inline_code","code":"datetime.tzinfo"}]},{"type":"text","value":" abstract base class, and is intended to be attached to "},{"type":"inline_code","code":"tzinfo"},{"type":"text","value":", either via the constructor, the "},{"type":"link","href":"3/library/datetime.html#datetime.datetime.replace","title":"datetime.datetime.replace","children":[{"type":"inline_code","code":"datetime.replace"}]},{"type":"text","value":" method or "},{"type":"link","href":"3/library/datetime.html#datetime.datetime.astimezone","title":"datetime.datetime.astimezone","children":[{"type":"inline_code","code":"datetime.astimezone"}]},{"type":"text","value":":"}]},{"type":"code_block","language":"python","code":">>> from zoneinfo import ZoneInfo\n>>> import datetime as dt\n\n>>> when = dt.datetime(2020, 10, 31, 12, tzinfo=ZoneInfo(\"America/Los_Angeles\"))\n>>> print(when)\n2020-10-31 12:00:00-07:00\n\n>>> when.tzname()\n'PDT'"},{"type":"paragraph","children":[{"type":"text","value":"Datetimes constructed in this way are compatible with datetime arithmetic and handle daylight saving time transitions with no further intervention:"}]},{"type":"code_block","language":"python","code":">>> when_add = when + dt.timedelta(days=1)\n\n>>> print(when_add)\n2020-11-01 12:00:00-08:00\n\n>>> when_add.tzname()\n'PST'"},{"type":"paragraph","children":[{"type":"text","value":"These time zones also support the "},{"type":"link","href":"3/library/datetime.html#datetime.datetime.fold","title":"datetime.datetime.fold","children":[{"type":"inline_code","code":"fold"}]},{"type":"text","value":" attribute introduced in "},{"type":"anchor","id":"index-1"},{"type":"link","href":"https://peps.python.org/pep-0495/","title":null,"children":[{"type":"strong","children":[{"type":"text","value":"PEP 495"}]}]},{"type":"text","value":". During offset transitions which induce ambiguous times (such as a daylight saving time to standard time transition), the offset from "},{"type":"emphasis","children":[{"type":"text","value":"before"}]},{"type":"text","value":" the transition is used when "},{"type":"inline_code","code":"fold=0"},{"type":"text","value":", and the offset "},{"type":"emphasis","children":[{"type":"text","value":"after"}]},{"type":"text","value":" the transition is used when "},{"type":"inline_code","code":"fold=1"},{"type":"text","value":", for example:"}]},{"type":"code_block","language":"python","code":">>> when = dt.datetime(2020, 11, 1, 1, tzinfo=ZoneInfo(\"America/Los_Angeles\"))\n>>> print(when)\n2020-11-01 01:00:00-07:00\n\n>>> print(when.replace(fold=1))\n2020-11-01 01:00:00-08:00"},{"type":"paragraph","children":[{"type":"text","value":"When converting from another time zone, the fold will be set to the correct value:"}]},{"type":"code_block","language":"python","code":">>> LOS_ANGELES = ZoneInfo(\"America/Los_Angeles\")\n>>> when_utc = dt.datetime(2020, 11, 1, 8, tzinfo=dt.timezone.utc)\n\n>>> # Before the PDT -> PST transition\n>>> print(when_utc.astimezone(LOS_ANGELES))\n2020-11-01 01:00:00-07:00\n\n>>> # After the PDT -> PST transition\n>>> print((when_utc + dt.timedelta(hours=1)).astimezone(LOS_ANGELES))\n2020-11-01 01:00:00-08:00"},{"type":"anchor","id":"data-sources"},{"type":"heading","level":2,"id":null,"children":[{"type":"text","value":"Data sources"}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inline_code","code":"zoneinfo"},{"type":"text","value":" module does not directly provide time zone data, and instead pulls time zone information from the system time zone database or the first-party PyPI package "},{"type":"link","href":"https://pypi.org/project/tzdata/","title":null,"children":[{"type":"text","value":"tzdata"}]},{"type":"text","value":", if available. Some systems, including notably Windows systems, do not have an IANA database available, and so for projects targeting cross-platform compatibility that require time zone data, it is recommended to declare a dependency on tzdata. If neither system data nor tzdata are available, all calls to "},{"type":"link","href":"3/library/zoneinfo.html#zoneinfo.ZoneInfo","title":"zoneinfo.ZoneInfo","children":[{"type":"inline_code","code":"ZoneInfo"}]},{"type":"text","value":" will raise "},{"type":"link","href":"3/library/zoneinfo.html#zoneinfo.ZoneInfoNotFoundError","title":"zoneinfo.ZoneInfoNotFoundError","children":[{"type":"inline_code","code":"ZoneInfoNotFoundError"}]},{"type":"text","value":"."}]},{"type":"anchor","id":"configuring-the-data-sources"},{"type":"anchor","id":"zoneinfo-data-configuration"},{"type":"heading","level":3,"id":null,"children":[{"type":"text","value":"Configuring the data sources"}]},{"type":"paragraph","children":[{"type":"text","value":"When "},{"type":"inline_code","code":"ZoneInfo(key)"},{"type":"text","value":" is called, the constructor first searches the directories specified in "},{"type":"link","href":"3/library/zoneinfo.html#zoneinfo.TZPATH","title":"zoneinfo.TZPATH","children":[{"type":"inline_code","code":"TZPATH"}]},{"type":"text","value":" for a file matching "},{"type":"inline_code","code":"key"},{"type":"text","value":", and on failure looks for a match in the tzdata package. This behavior can be configured in three ways:"}]},{"type":"list","ordered":true,"start":null,"items":[{"children":[{"type":"paragraph","children":[{"type":"text","value":"The default "},{"type":"link","href":"3/library/zoneinfo.html#zoneinfo.TZPATH","title":"zoneinfo.TZPATH","children":[{"type":"inline_code","code":"TZPATH"}]},{"type":"text","value":" when not otherwise specified can be configured at "},{"type":"link","href":"3/library/zoneinfo.html#zoneinfo-data-compile-time-config","title":null,"children":[{"type":"text","value":"compile time"}]},{"type":"text","value":"."}]}]},{"children":[{"type":"paragraph","children":[{"type":"link","href":"3/library/zoneinfo.html#zoneinfo.TZPATH","title":"zoneinfo.TZPATH","children":[{"type":"inline_code","code":"TZPATH"}]},{"type":"text","value":" can be configured using "},{"type":"link","href":"3/library/zoneinfo.html#zoneinfo-data-environment-var","title":null,"children":[{"type":"text","value":"an environment variable"}]},{"type":"text","value":"."}]}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"At "},{"type":"link","href":"3/library/zoneinfo.html#zoneinfo-data-runtime-config","title":null,"children":[{"type":"text","value":"runtime"}]},{"type":"text","value":", the search path can be manipulated using the "},{"type":"link","href":"3/library/zoneinfo.html#zoneinfo.reset_tzpath","title":"zoneinfo.reset_tzpath","children":[{"type":"inline_code","code":"reset_tzpath()"}]},{"type":"text","value":" function."}]}]}]},{"type":"anchor","id":"compile-time-configuration"},{"type":"anchor","id":"zoneinfo-data-compile-time-config"},{"type":"heading","level":4,"id":null,"children":[{"type":"text","value":"Compile-time configuration"}]},{"type":"paragraph","children":[{"type":"text","value":"The default "},{"type":"link","href":"3/library/zoneinfo.html#zoneinfo.TZPATH","title":"zoneinfo.TZPATH","children":[{"type":"inline_code","code":"TZPATH"}]},{"type":"text","value":" includes several common deployment locations for the time zone database (except on Windows, where there are no “well-known” locations for time zone data). On POSIX systems, downstream distributors and those building Python from source who know where their system time zone data is deployed may change the default time zone path by specifying the compile-time option "},{"type":"inline_code","code":"TZPATH"},{"type":"text","value":" (or, more likely, the "},{"type":"link","href":"https://docs.python.org/3/using/configure.html#cmdoption-with-tzpath","title":null,"children":[{"type":"inline_code","code":"configure\nflag --with-tzpath"}]},{"type":"text","value":"), which should be a string delimited by "},{"type":"link","href":"https://docs.python.org/3/library/os.html#os.pathsep","title":"os.pathsep","children":[{"type":"inline_code","code":"os.pathsep"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"On all platforms, the configured value is available as the "},{"type":"inline_code","code":"TZPATH"},{"type":"text","value":" key in "},{"type":"link","href":"https://docs.python.org/3/library/sysconfig.html#sysconfig.get_config_var","title":"sysconfig.get_config_var","children":[{"type":"inline_code","code":"sysconfig.get_config_var()"}]},{"type":"text","value":"."}]},{"type":"anchor","id":"environment-configuration"},{"type":"anchor","id":"zoneinfo-data-environment-var"},{"type":"heading","level":4,"id":null,"children":[{"type":"text","value":"Environment configuration"}]},{"type":"paragraph","children":[{"type":"text","value":"When initializing "},{"type":"link","href":"3/library/zoneinfo.html#zoneinfo.TZPATH","title":"zoneinfo.TZPATH","children":[{"type":"inline_code","code":"TZPATH"}]},{"type":"text","value":" (either at import time or whenever "},{"type":"link","href":"3/library/zoneinfo.html#zoneinfo.reset_tzpath","title":"zoneinfo.reset_tzpath","children":[{"type":"inline_code","code":"reset_tzpath()"}]},{"type":"text","value":" is called with no arguments), the "},{"type":"inline_code","code":"zoneinfo"},{"type":"text","value":" module will use the environment variable "},{"type":"inline_code","code":"PYTHONTZPATH"},{"type":"text","value":", if it exists, to set the search path."}]},{"type":"definition_list","items":[{"id":"envvar-PYTHONTZPATH","term":[{"type":"text","value":"PYTHONTZPATH"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"This is an "},{"type":"link","href":"https://docs.python.org/3/library/os.html#os.pathsep","title":"os.pathsep","children":[{"type":"inline_code","code":"os.pathsep"}]},{"type":"text","value":"-separated string containing the time zone search path to use. It must consist of only absolute rather than relative paths. Relative components specified in "},{"type":"inline_code","code":"PYTHONTZPATH"},{"type":"text","value":" will not be used, but otherwise the behavior when a relative path is specified is implementation-defined; CPython will raise "},{"type":"link","href":"3/library/zoneinfo.html#zoneinfo.InvalidTZPathWarning","title":"zoneinfo.InvalidTZPathWarning","children":[{"type":"inline_code","code":"InvalidTZPathWarning"}]},{"type":"text","value":", but other implementations are free to silently ignore the erroneous component or raise an exception."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"To set the system to ignore the system data and use the tzdata package instead, set "},{"type":"inline_code","code":"PYTHONTZPATH=\"\""},{"type":"text","value":"."}]},{"type":"anchor","id":"runtime-configuration"},{"type":"anchor","id":"zoneinfo-data-runtime-config"},{"type":"heading","level":4,"id":null,"children":[{"type":"text","value":"Runtime configuration"}]},{"type":"paragraph","children":[{"type":"text","value":"The TZ search path can also be configured at runtime using the "},{"type":"link","href":"3/library/zoneinfo.html#zoneinfo.reset_tzpath","title":"zoneinfo.reset_tzpath","children":[{"type":"inline_code","code":"reset_tzpath()"}]},{"type":"text","value":" function. This is generally not an advisable operation, though it is reasonable to use it in test functions that require the use of a specific time zone path (or require disabling access to the system time zones)."}]},{"type":"anchor","id":"the-zoneinfo-class"},{"type":"heading","level":2,"id":null,"children":[{"type":"text","value":"The "},{"type":"inline_code","code":"ZoneInfo"},{"type":"text","value":" class"}]},{"type":"definition_list","items":[{"id":"zoneinfo.ZoneInfo","term":[{"type":"emphasis","children":[{"type":"text","value":"class"},{"type":"text","value":" "}]},{"type":"text","value":"zoneinfo.ZoneInfo("},{"type":"emphasis","children":[{"type":"text","value":"key"}]},{"type":"text","value":")"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"A concrete "},{"type":"link","href":"3/library/datetime.html#datetime.tzinfo","title":"datetime.tzinfo","children":[{"type":"inline_code","code":"datetime.tzinfo"}]},{"type":"text","value":" subclass that represents an IANA time zone specified by the string "},{"type":"inline_code","code":"key"},{"type":"text","value":". Calls to the primary constructor will always return objects that compare identically; put another way, barring cache invalidation via "},{"type":"link","href":"3/library/zoneinfo.html#zoneinfo.ZoneInfo.clear_cache","title":"zoneinfo.ZoneInfo.clear_cache","children":[{"type":"inline_code","code":"ZoneInfo.clear_cache()"}]},{"type":"text","value":", for all values of "},{"type":"inline_code","code":"key"},{"type":"text","value":", the following assertion will always be true:"}]},{"type":"code_block","language":"python","code":"a = ZoneInfo(key)\nb = ZoneInfo(key)\nassert a is b"},{"type":"paragraph","children":[{"type":"inline_code","code":"key"},{"type":"text","value":" must be in the form of a relative, normalized POSIX path, with no up-level references. The constructor will raise "},{"type":"link","href":"3/library/exceptions.html#ValueError","title":"ValueError","children":[{"type":"inline_code","code":"ValueError"}]},{"type":"text","value":" if a non-conforming key is passed."}]},{"type":"paragraph","children":[{"type":"text","value":"If no file matching "},{"type":"inline_code","code":"key"},{"type":"text","value":" is found, the constructor will raise "},{"type":"link","href":"3/library/zoneinfo.html#zoneinfo.ZoneInfoNotFoundError","title":"zoneinfo.ZoneInfoNotFoundError","children":[{"type":"inline_code","code":"ZoneInfoNotFoundError"}]},{"type":"text","value":"."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inline_code","code":"ZoneInfo"},{"type":"text","value":" class has two alternate constructors:"}]},{"type":"definition_list","items":[{"id":"zoneinfo.ZoneInfo.from_file","term":[{"type":"emphasis","children":[{"type":"text","value":"classmethod"},{"type":"text","value":" "}]},{"type":"text","value":"ZoneInfo.from_file("},{"type":"emphasis","children":[{"type":"text","value":"file_obj"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"/"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"key"},{"type":"text","value":"="},{"type":"text","value":"None"}]},{"type":"text","value":")"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Constructs a "},{"type":"inline_code","code":"ZoneInfo"},{"type":"text","value":" object from a file-like object returning bytes (e.g. a file opened in binary mode or an "},{"type":"link","href":"https://docs.python.org/3/library/io.html#io.BytesIO","title":"io.BytesIO","children":[{"type":"inline_code","code":"io.BytesIO"}]},{"type":"text","value":" object). Unlike the primary constructor, this always constructs a new object."}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inline_code","code":"key"},{"type":"text","value":" parameter sets the name of the zone for the purposes of "},{"type":"link","href":"https://docs.python.org/3/reference/datamodel.html#object.__str__","title":"object.__str__","children":[{"type":"inline_code","code":"__str__()"}]},{"type":"text","value":" and "},{"type":"link","href":"https://docs.python.org/3/reference/datamodel.html#object.__repr__","title":"object.__repr__","children":[{"type":"inline_code","code":"__repr__()"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Objects created via this constructor cannot be pickled (see "},{"type":"link","href":"3/library/zoneinfo.html#pickling","title":null,"children":[{"type":"text","value":"pickling"}]},{"type":"text","value":")."}]},{"type":"paragraph","children":[{"type":"link","href":"3/library/exceptions.html#ValueError","title":"ValueError","children":[{"type":"inline_code","code":"ValueError"}]},{"type":"text","value":" is raised if the data read from "},{"type":"emphasis","children":[{"type":"text","value":"file_obj"}]},{"type":"text","value":" is not a valid TZif file."}]}]}]},{"type":"definition_list","items":[{"id":"zoneinfo.ZoneInfo.no_cache","term":[{"type":"emphasis","children":[{"type":"text","value":"classmethod"},{"type":"text","value":" "}]},{"type":"text","value":"ZoneInfo.no_cache("},{"type":"emphasis","children":[{"type":"text","value":"key"}]},{"type":"text","value":")"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"An alternate constructor that bypasses the constructor’s cache. It is identical to the primary constructor, but returns a new object on each call. This is most likely to be useful for testing or demonstration purposes, but it can also be used to create a system with a different cache invalidation strategy."}]},{"type":"paragraph","children":[{"type":"text","value":"Objects created via this constructor will also bypass the cache of a deserializing process when unpickled."}]},{"type":"admonition","kind":"caution","title":"Caution","children":[{"type":"paragraph","children":[{"type":"text","value":"Using this constructor may change the semantics of your datetimes in surprising ways, only use it if you know that you need to."}]}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The following class methods are also available:"}]},{"type":"definition_list","items":[{"id":"zoneinfo.ZoneInfo.clear_cache","term":[{"type":"emphasis","children":[{"type":"text","value":"classmethod"},{"type":"text","value":" "}]},{"type":"text","value":"ZoneInfo.clear_cache("},{"type":"emphasis","children":[{"type":"text","value":"*"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"only_keys"},{"type":"text","value":"="},{"type":"text","value":"None"}]},{"type":"text","value":")"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"A method for invalidating the cache on the "},{"type":"inline_code","code":"ZoneInfo"},{"type":"text","value":" class. If no arguments are passed, all caches are invalidated and the next call to the primary constructor for each key will return a new instance."}]},{"type":"paragraph","children":[{"type":"text","value":"If an iterable of key names is passed to the "},{"type":"inline_code","code":"only_keys"},{"type":"text","value":" parameter, only the specified keys will be removed from the cache. Keys passed to "},{"type":"inline_code","code":"only_keys"},{"type":"text","value":" but not found in the cache are ignored."}]},{"type":"admonition","kind":"warning","title":"Warning","children":[{"type":"paragraph","children":[{"type":"text","value":"Invoking this function may change the semantics of datetimes using "},{"type":"inline_code","code":"ZoneInfo"},{"type":"text","value":" in surprising ways; this modifies module state and thus may have wide-ranging effects. Only use it if you know that you need to."}]}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The class has one attribute:"}]},{"type":"definition_list","items":[{"id":"zoneinfo.ZoneInfo.key","term":[{"type":"text","value":"ZoneInfo.key"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"This is a read-only "},{"type":"link","href":"https://docs.python.org/3/glossary.html#term-attribute","title":null,"children":[{"type":"text","value":"attribute"}]},{"type":"text","value":" that returns the value of "},{"type":"inline_code","code":"key"},{"type":"text","value":" passed to the constructor, which should be a lookup key in the IANA time zone database (e.g. "},{"type":"inline_code","code":"America/New_York"},{"type":"text","value":", "},{"type":"inline_code","code":"Europe/Paris"},{"type":"text","value":" or "},{"type":"inline_code","code":"Asia/Tokyo"},{"type":"text","value":")."}]},{"type":"paragraph","children":[{"type":"text","value":"For zones constructed from file without specifying a "},{"type":"inline_code","code":"key"},{"type":"text","value":" parameter, this will be set to "},{"type":"inline_code","code":"None"},{"type":"text","value":"."}]},{"type":"admonition","kind":"note","title":"Note","children":[{"type":"paragraph","children":[{"type":"text","value":"Although it is a somewhat common practice to expose these to end users, these values are designed to be primary keys for representing the relevant zones and not necessarily user-facing elements. Projects like CLDR (the Unicode Common Locale Data Repository) can be used to get more user-friendly strings from these keys."}]}]}]}]},{"type":"anchor","id":"string-representations"},{"type":"heading","level":3,"id":null,"children":[{"type":"text","value":"String representations"}]},{"type":"paragraph","children":[{"type":"text","value":"The string representation returned when calling "},{"type":"link","href":"3/library/stdtypes.html#str","title":"str","children":[{"type":"inline_code","code":"str"}]},{"type":"text","value":" on a "},{"type":"link","href":"3/library/zoneinfo.html#zoneinfo.ZoneInfo","title":"zoneinfo.ZoneInfo","children":[{"type":"inline_code","code":"ZoneInfo"}]},{"type":"text","value":" object defaults to using the "},{"type":"link","href":"3/library/zoneinfo.html#zoneinfo.ZoneInfo.key","title":"zoneinfo.ZoneInfo.key","children":[{"type":"inline_code","code":"ZoneInfo.key"}]},{"type":"text","value":" attribute (see the note on usage in the attribute documentation):"}]},{"type":"code_block","language":"python","code":">>> zone = ZoneInfo(\"Pacific/Kwajalein\")\n>>> str(zone)\n'Pacific/Kwajalein'\n\n>>> when = dt.datetime(2020, 4, 1, 3, 15, tzinfo=zone)\n>>> f\"{when.isoformat()} [{when.tzinfo}]\"\n'2020-04-01T03:15:00+12:00 [Pacific/Kwajalein]'"},{"type":"paragraph","children":[{"type":"text","value":"For objects constructed from a file without specifying a "},{"type":"inline_code","code":"key"},{"type":"text","value":" parameter, "},{"type":"inline_code","code":"str"},{"type":"text","value":" falls back to calling "},{"type":"link","href":"3/library/functions.html#repr","title":"repr","children":[{"type":"inline_code","code":"repr()"}]},{"type":"text","value":". "},{"type":"inline_code","code":"ZoneInfo"},{"type":"text","value":"’s "},{"type":"inline_code","code":"repr"},{"type":"text","value":" is implementation-defined and not necessarily stable between versions, but it is guaranteed not to be a valid "},{"type":"inline_code","code":"ZoneInfo"},{"type":"text","value":" key."}]},{"type":"anchor","id":"pickle-serialization"},{"type":"anchor","id":"pickling"},{"type":"heading","level":3,"id":null,"children":[{"type":"text","value":"Pickle serialization"}]},{"type":"paragraph","children":[{"type":"text","value":"Rather than serializing all transition data, "},{"type":"inline_code","code":"ZoneInfo"},{"type":"text","value":" objects are serialized by key, and "},{"type":"inline_code","code":"ZoneInfo"},{"type":"text","value":" objects constructed from files (even those with a value for "},{"type":"inline_code","code":"key"},{"type":"text","value":" specified) cannot be pickled."}]},{"type":"paragraph","children":[{"type":"text","value":"The behavior of a "},{"type":"inline_code","code":"ZoneInfo"},{"type":"text","value":" file depends on how it was constructed:"}]},{"type":"list","ordered":true,"start":null,"items":[{"children":[{"type":"paragraph","children":[{"type":"inline_code","code":"ZoneInfo(key)"},{"type":"text","value":": When constructed with the primary constructor, a "},{"type":"inline_code","code":"ZoneInfo"},{"type":"text","value":" object is serialized by key, and when deserialized, the deserializing process uses the primary and thus it is expected that these are the same object as other references to the same time zone. For example, if "},{"type":"inline_code","code":"europe_berlin_pkl"},{"type":"text","value":" is a string containing a pickle constructed from "},{"type":"inline_code","code":"ZoneInfo(\"Europe/Berlin\")"},{"type":"text","value":", one would expect the following behavior:"}]},{"type":"code_block","language":"pycon","code":">>> a = ZoneInfo(\"Europe/Berlin\")\n>>> b = pickle.loads(europe_berlin_pkl)\n>>> a is b\nTrue"}]},{"children":[{"type":"paragraph","children":[{"type":"inline_code","code":"ZoneInfo.no_cache(key)"},{"type":"text","value":": When constructed from the cache-bypassing constructor, the "},{"type":"inline_code","code":"ZoneInfo"},{"type":"text","value":" object is also serialized by key, but when deserialized, the deserializing process uses the cache bypassing constructor. If "},{"type":"inline_code","code":"europe_berlin_pkl_nc"},{"type":"text","value":" is a string containing a pickle constructed from "},{"type":"inline_code","code":"ZoneInfo.no_cache(\"Europe/Berlin\")"},{"type":"text","value":", one would expect the following behavior:"}]},{"type":"code_block","language":"pycon","code":">>> a = ZoneInfo(\"Europe/Berlin\")\n>>> b = pickle.loads(europe_berlin_pkl_nc)\n>>> a is b\nFalse"}]},{"children":[{"type":"paragraph","children":[{"type":"inline_code","code":"ZoneInfo.from_file(file_obj, /, key=None)"},{"type":"text","value":": When constructed from a file, the "},{"type":"inline_code","code":"ZoneInfo"},{"type":"text","value":" object raises an exception on pickling. If an end user wants to pickle a "},{"type":"inline_code","code":"ZoneInfo"},{"type":"text","value":" constructed from a file, it is recommended that they use a wrapper type or a custom serialization function: either serializing by key or storing the contents of the file object and serializing that."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"This method of serialization requires that the time zone data for the required key be available on both the serializing and deserializing side, similar to the way that references to classes and functions are expected to exist in both the serializing and deserializing environments. It also means that no guarantees are made about the consistency of results when unpickling a "},{"type":"inline_code","code":"ZoneInfo"},{"type":"text","value":" pickled in an environment with a different version of the time zone data."}]},{"type":"anchor","id":"functions"},{"type":"heading","level":2,"id":null,"children":[{"type":"text","value":"Functions"}]},{"type":"definition_list","items":[{"id":"zoneinfo.available_timezones","term":[{"type":"text","value":"zoneinfo.available_timezones()"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Get a set containing all the valid keys for IANA time zones available anywhere on the time zone path. This is recalculated on every call to the function."}]},{"type":"paragraph","children":[{"type":"text","value":"This function only includes canonical zone names and does not include “special” zones such as those under the "},{"type":"inline_code","code":"posix/"},{"type":"text","value":" and "},{"type":"inline_code","code":"right/"},{"type":"text","value":" directories, or the "},{"type":"inline_code","code":"posixrules"},{"type":"text","value":" zone."}]},{"type":"admonition","kind":"caution","title":"Caution","children":[{"type":"paragraph","children":[{"type":"text","value":"This function may open a large number of files, as the best way to determine if a file on the time zone path is a valid time zone is to read the “magic string” at the beginning."}]}]},{"type":"admonition","kind":"note","title":"Note","children":[{"type":"paragraph","children":[{"type":"text","value":"These values are not designed to be exposed to end-users; for user facing elements, applications should use something like CLDR (the Unicode Common Locale Data Repository) to get more user-friendly strings. See also the cautionary note on "},{"type":"link","href":"3/library/zoneinfo.html#zoneinfo.ZoneInfo.key","title":"zoneinfo.ZoneInfo.key","children":[{"type":"inline_code","code":"ZoneInfo.key"}]},{"type":"text","value":"."}]}]}]}]},{"type":"definition_list","items":[{"id":"zoneinfo.reset_tzpath","term":[{"type":"text","value":"zoneinfo.reset_tzpath("},{"type":"emphasis","children":[{"type":"text","value":"to"},{"type":"text","value":"="},{"type":"text","value":"None"}]},{"type":"text","value":")"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Sets or resets the time zone search path ("},{"type":"link","href":"3/library/zoneinfo.html#zoneinfo.TZPATH","title":"zoneinfo.TZPATH","children":[{"type":"inline_code","code":"TZPATH"}]},{"type":"text","value":") for the module. When called with no arguments, "},{"type":"inline_code","code":"TZPATH"},{"type":"text","value":" is set to the default value."}]},{"type":"paragraph","children":[{"type":"text","value":"Calling "},{"type":"inline_code","code":"reset_tzpath"},{"type":"text","value":" will not invalidate the "},{"type":"link","href":"3/library/zoneinfo.html#zoneinfo.ZoneInfo","title":"zoneinfo.ZoneInfo","children":[{"type":"inline_code","code":"ZoneInfo"}]},{"type":"text","value":" cache, and so calls to the primary "},{"type":"inline_code","code":"ZoneInfo"},{"type":"text","value":" constructor will only use the new "},{"type":"inline_code","code":"TZPATH"},{"type":"text","value":" in the case of a cache miss."}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inline_code","code":"to"},{"type":"text","value":" parameter must be a "},{"type":"link","href":"https://docs.python.org/3/glossary.html#term-sequence","title":null,"children":[{"type":"text","value":"sequence"}]},{"type":"text","value":" of strings or "},{"type":"link","href":"https://docs.python.org/3/library/os.html#os.PathLike","title":"os.PathLike","children":[{"type":"inline_code","code":"os.PathLike"}]},{"type":"text","value":" and not a string, all of which must be absolute paths. "},{"type":"link","href":"3/library/exceptions.html#ValueError","title":"ValueError","children":[{"type":"inline_code","code":"ValueError"}]},{"type":"text","value":" will be raised if something other than an absolute path is passed."}]}]}]},{"type":"anchor","id":"globals"},{"type":"heading","level":2,"id":null,"children":[{"type":"text","value":"Globals"}]},{"type":"definition_list","items":[{"id":"zoneinfo.TZPATH","term":[{"type":"text","value":"zoneinfo.TZPATH"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"A read-only sequence representing the time zone search path – when constructing a "},{"type":"inline_code","code":"ZoneInfo"},{"type":"text","value":" from a key, the key is joined to each entry in the "},{"type":"inline_code","code":"TZPATH"},{"type":"text","value":", and the first file found is used."}]},{"type":"paragraph","children":[{"type":"inline_code","code":"TZPATH"},{"type":"text","value":" may contain only absolute paths, never relative paths, regardless of how it is configured."}]},{"type":"paragraph","children":[{"type":"text","value":"The object that "},{"type":"inline_code","code":"zoneinfo.TZPATH"},{"type":"text","value":" points to may change in response to a call to "},{"type":"link","href":"3/library/zoneinfo.html#zoneinfo.reset_tzpath","title":"zoneinfo.reset_tzpath","children":[{"type":"inline_code","code":"reset_tzpath()"}]},{"type":"text","value":", so it is recommended to use "},{"type":"inline_code","code":"zoneinfo.TZPATH"},{"type":"text","value":" rather than importing "},{"type":"inline_code","code":"TZPATH"},{"type":"text","value":" from "},{"type":"inline_code","code":"zoneinfo"},{"type":"text","value":" or assigning a long-lived variable to "},{"type":"inline_code","code":"zoneinfo.TZPATH"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"For more information on configuring the time zone search path, see "},{"type":"link","href":"3/library/zoneinfo.html#zoneinfo-data-configuration","title":null,"children":[{"type":"text","value":"Configuring the data sources"}]},{"type":"text","value":"."}]}]}]},{"type":"anchor","id":"exceptions-and-warnings"},{"type":"heading","level":2,"id":null,"children":[{"type":"text","value":"Exceptions and warnings"}]},{"type":"definition_list","items":[{"id":"zoneinfo.ZoneInfoNotFoundError","term":[{"type":"emphasis","children":[{"type":"text","value":"exception"},{"type":"text","value":" "}]},{"type":"text","value":"zoneinfo.ZoneInfoNotFoundError"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Raised when construction of a "},{"type":"link","href":"3/library/zoneinfo.html#zoneinfo.ZoneInfo","title":"zoneinfo.ZoneInfo","children":[{"type":"inline_code","code":"ZoneInfo"}]},{"type":"text","value":" object fails because the specified key could not be found on the system. This is a subclass of "},{"type":"link","href":"3/library/exceptions.html#KeyError","title":"KeyError","children":[{"type":"inline_code","code":"KeyError"}]},{"type":"text","value":"."}]}]}]},{"type":"definition_list","items":[{"id":"zoneinfo.InvalidTZPathWarning","term":[{"type":"emphasis","children":[{"type":"text","value":"exception"},{"type":"text","value":" "}]},{"type":"text","value":"zoneinfo.InvalidTZPathWarning"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Raised when "},{"type":"anchor","id":"index-2"},{"type":"link","href":"3/library/zoneinfo.html#envvar-PYTHONTZPATH","title":null,"children":[{"type":"inline_code","code":"PYTHONTZPATH"}]},{"type":"text","value":" contains an invalid component that will be filtered out, such as a relative path."}]}]}]}]}}
