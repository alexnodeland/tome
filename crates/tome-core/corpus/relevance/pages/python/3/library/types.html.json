_code","code":"tb"},{"type":"text","value":" is a traceback object."}]}]}]},{"type":"definition_list","items":[{"id":"types.GetSetDescriptorType","term":[{"type":"emphasis","children":[{"type":"text","value":"class"},{"type":"text","value":" "}]},{"type":"text","value":"types.GetSetDescriptorType"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"The type of objects defined in extension modules with "},{"type":"inline_code","code":"PyGetSetDef"},{"type":"text","value":", such as "},{"type":"link","href":"https://docs.python.org/3/reference/datamodel.html#frame.f_locals","title":"frame.f_locals","children":[{"type":"inline_code","code":"FrameType.f_locals"}]},{"type":"text","value":" or "},{"type":"inline_code","code":"array.array.typecode"},{"type":"text","value":". This type is used as descriptor for object attributes; it has the same purpose as the "},{"type":"link","href":"3/library/functions.html#property","title":"property","children":[{"type":"inline_code","code":"property"}]},{"type":"text","value":" type, but for classes defined in extension modules."}]}]}]},{"type":"definition_list","items":[{"id":"types.MemberDescriptorType","term":[{"type":"emphasis","children":[{"type":"text","value":"class"},{"type":"text","value":" "}]},{"type":"text","value":"types.MemberDescriptorType"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"The type of objects defined in extension modules with "},{"type":"inline_code","code":"PyMemberDef"},{"type":"text","value":", such as "},{"type":"inline_code","code":"datetime.timedelta.days"},{"type":"text","value":". This type is used as descriptor for simple C data members which use standard conversion functions; it has the same purpose as the "},{"type":"link","href":"3/library/functions.html#property","title":"property","children":[{"type":"inline_code","code":"property"}]},{"type":"text","value":" type, but for classes defined in extension modules."}]},{"type":"paragraph","children":[{"type":"text","value":"In addition, when a class is defined with a "},{"type":"link","href":"https://docs.python.org/3/reference/datamodel.html#object.__slots__","title":"object.__slots__","children":[{"type":"inline_code","code":"__slots__"}]},{"type":"text","value":" attribute, then for each slot, an instance of "},{"type":"inline_code","code":"MemberDescriptorType"},{"type":"text","value":" will be added as an attribute on the class. This allows the slot to appear in the class’s "},{"type":"link","href":"https://docs.python.org/3/reference/datamodel.html#type.__dict__","title":"type.__dict__","children":[{"type":"inline_code","code":"__dict__"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"CPython implementation detail:"}]},{"type":"text","value":" In other implementations of Python, this type may be identical to "},{"type":"inline_code","code":"GetSetDescriptorType"},{"type":"text","value":"."}]}]}]},{"type":"definition_list","items":[{"id":"types.MappingProxyType","term":[{"type":"emphasis","children":[{"type":"text","value":"class"},{"type":"text","value":" "}]},{"type":"text","value":"types.MappingProxyType("},{"type":"emphasis","children":[{"type":"text","value":"mapping"}]},{"type":"text","value":")"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Read-only proxy of a mapping. It provides a dynamic view on the mapping’s entries, which means that when the mapping changes, the view reflects these changes."}]},{"type":"paragraph","children":[{"type":"inline_code","code":"MappingProxyType"},{"type":"text","value":"s are "},{"type":"link","href":"https://docs.python.org/3/library/typing.html#generics","title":null,"children":[{"type":"text","value":"generic"}]},{"type":"text","value":" over two types, signifying (respectively) the types of the underlying mapping’s keys and values."}]},{"type":"paragraph","children":[{"type":"text","value":"Added in version 3.3."}]},{"type":"paragraph","children":[{"type":"text","value":"Changed in version 3.9: Updated to support the new union ("},{"type":"inline_code","code":"|"},{"type":"text","value":") operator from "},{"type":"anchor","id":"index-6"},{"type":"link","href":"https://peps.python.org/pep-0584/","title":null,"children":[{"type":"strong","children":[{"type":"text","value":"PEP 584"}]}]},{"type":"text","value":", which simply delegates to the underlying mapping."}]},{"type":"definition_list","items":[{"id":null,"term":[{"type":"text","value":"key in proxy"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Return "},{"type":"inline_code","code":"True"},{"type":"text","value":" if the underlying mapping has a key "},{"type":"emphasis","children":[{"type":"text","value":"key"}]},{"type":"text","value":", else "},{"type":"inline_code","code":"False"},{"type":"text","value":"."}]}]}]},{"type":"definition_list","items":[{"id":null,"term":[{"type":"text","value":"proxy[key]"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Return the item of the underlying mapping with key "},{"type":"emphasis","children":[{"type":"text","value":"key"}]},{"type":"text","value":". Raises a "},{"type":"link","href":"3/library/exceptions.html#KeyError","title":"KeyError","children":[{"type":"inline_code","code":"KeyError"}]},{"type":"text","value":" if "},{"type":"emphasis","children":[{"type":"text","value":"key"}]},{"type":"text","value":" is not in the underlying mapping."}]}]}]},{"type":"definition_list","items":[{"id":null,"term":[{"type":"text","value":"iter(proxy)"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Return an iterator over the keys of the underlying mapping. This is a shortcut for "},{"type":"inline_code","code":"iter(proxy.keys())"},{"type":"text","value":"."}]}]}]},{"type":"definition_list","items":[{"id":null,"term":[{"type":"text","value":"len(proxy)"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Return the number of items in the underlying mapping."}]}]}]},{"type":"definition_list","items":[{"id":"types.MappingProxyType.copy","term":[{"type":"text","value":"copy()"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Return a shallow copy of the underlying mapping."}]}]}]},{"type":"definition_list","items":[{"id":"types.MappingProxyType.get","term":[{"type":"text","value":"get("},{"type":"emphasis","children":[{"type":"text","value":"key"}]},{"type":"text","value":"[, "},{"type":"emphasis","children":[{"type":"text","value":"default"}]},{"type":"text","value":"])"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Return the value for "},{"type":"emphasis","children":[{"type":"text","value":"key"}]},{"type":"text","value":" if "},{"type":"emphasis","children":[{"type":"text","value":"key"}]},{"type":"text","value":" is in the underlying mapping, else "},{"type":"emphasis","children":[{"type":"text","value":"default"}]},{"type":"text","value":". If "},{"type":"emphasis","children":[{"type":"text","value":"default"}]},{"type":"text","value":" is not given, it defaults to "},{"type":"inline_code","code":"None"},{"type":"text","value":", so that this method never raises a "},{"type":"link","href":"3/library/exceptions.html#KeyError","title":"KeyError","children":[{"type":"inline_code","code":"KeyError"}]},{"type":"text","value":"."}]}]}]},{"type":"definition_list","items":[{"id":"types.MappingProxyType.items","term":[{"type":"text","value":"items()"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Return a new view of the underlying mapping’s items ("},{"type":"inline_code","code":"(key, value)"},{"type":"text","value":" pairs)."}]}]}]},{"type":"definition_list","items":[{"id":"types.MappingProxyType.keys","term":[{"type":"text","value":"keys()"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Return a new view of the underlying mapping’s keys."}]}]}]},{"type":"definition_list","items":[{"id":"types.MappingProxyType.values","term":[{"type":"text","value":"values()"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Return a new view of the underlying mapping’s values."}]}]}]},{"type":"definition_list","items":[{"id":null,"term":[{"type":"text","value":"reversed(proxy)"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Return a reverse iterator over the keys of the underlying mapping."}]},{"type":"paragraph","children":[{"type":"text","value":"Added in version 3.9."}]}]}]},{"type":"definition_list","items":[{"id":null,"term":[{"type":"text","value":"hash(proxy)"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Return a hash of the underlying mapping."}]},{"type":"paragraph","children":[{"type":"text","value":"Added in version 3.12."}]}]}]}]}]},{"type":"definition_list","items":[{"id":"types.CapsuleType","term":[{"type":"emphasis","children":[{"type":"text","value":"class"},{"type":"text","value":" "}]},{"type":"text","value":"types.CapsuleType"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"The type of "},{"type":"link","href":"https://docs.python.org/3/c-api/capsule.html#capsules","title":null,"children":[{"type":"text","value":"capsule objects"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Added in version 3.13."}]}]}]},{"type":"anchor","id":"additional-utility-classes-and-functions"},{"type":"heading","level":2,"id":null,"children":[{"type":"text","value":"Additional Utility Classes and Functions"}]},{"type":"definition_list","items":[{"id":"types.SimpleNamespace","term":[{"type":"emphasis","children":[{"type":"text","value":"class"},{"type":"text","value":" "}]},{"type":"text","value":"types.SimpleNamespace"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"A simple "},{"type":"link","href":"3/library/functions.html#object","title":"object","children":[{"type":"inline_code","code":"object"}]},{"type":"text","value":" subclass that provides attribute access to its namespace, as well as a meaningful repr."}]},{"type":"paragraph","children":[{"type":"text","value":"Unlike "},{"type":"link","href":"3/library/functions.html#object","title":"object","children":[{"type":"inline_code","code":"object"}]},{"type":"text","value":", with "},{"type":"inline_code","code":"SimpleNamespace"},{"type":"text","value":" you can add and remove attributes."}]},{"type":"paragraph","children":[{"type":"inline_code","code":"SimpleNamespace"},{"type":"text","value":" objects may be initialized in the same way as "},{"type":"link","href":"3/library/stdtypes.html#dict","title":"dict","children":[{"type":"inline_code","code":"dict"}]},{"type":"text","value":": either with keyword arguments, with a single positional argument, or with both. When initialized with keyword arguments, those are directly added to the underlying namespace. Alternatively, when initialized with a positional argument, the underlying namespace will be updated with key-value pairs from that argument (either a mapping object or an "},{"type":"link","href":"https://docs.python.org/3/glossary.html#term-iterable","title":null,"children":[{"type":"text","value":"iterable"}]},{"type":"text","value":" object producing key-value pairs). All such keys must be strings."}]},{"type":"paragraph","children":[{"type":"text","value":"The type is roughly equivalent to the following code:"}]},{"type":"code_block","language":"python","code":"class SimpleNamespace:\n    def __init__(self, mapping_or_iterable=(), /, **kwargs):\n        self.__dict__.update(mapping_or_iterable)\n        self.__dict__.update(kwargs)\n\n    def __repr__(self):\n        items = (f\"{k}={v!r}\" for k, v in self.__dict__.items())\n        return \"{}({})\".format(type(self).__name__, \", \".join(items))\n\n    def __eq__(self, other):\n        if isinstance(self, SimpleNamespace) and isinstance(other, SimpleNamespace):\n           return self.__dict__ == other.__dict__\n        return NotImplemented"},{"type":"paragraph","children":[{"type":"inline_code","code":"SimpleNamespace"},{"type":"text","value":" may be useful as a replacement for "},{"type":"inline_code","code":"class NS: pass"},{"type":"text","value":". However, for a structured record type use "},{"type":"link","href":"3/library/collections.html#collections.namedtuple","title":"collections.namedtuple","children":[{"type":"inline_code","code":"namedtuple()"}]},{"type":"text","value":" instead."}]},{"type":"paragraph","children":[{"type":"inline_code","code":"SimpleNamespace"},{"type":"text","value":" objects are supported by "},{"type":"link","href":"3/library/copy.html#copy.replace","title":"copy.replace","children":[{"type":"inline_code","code":"copy.replace()"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Added in version 3.3."}]},{"type":"paragraph","children":[{"type":"text","value":"Changed in version 3.9: Attribute order in the repr changed from alphabetical to insertion (like "},{"type":"inline_code","code":"dict"},{"type":"text","value":")."}]},{"type":"paragraph","children":[{"type":"text","value":"Changed in version 3.13: Added support for an optional positional argument."}]}]}]},{"type":"definition_list","items":[{"id":"types.DynamicClassAttribute","term":[{"type":"text","value":"types.DynamicClassAttribute("},{"type":"emphasis","children":[{"type":"text","value":"fget"},{"type":"text","value":"="},{"type":"text","value":"None"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"fset"},{"type":"text","value":"="},{"type":"text","value":"None"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"fdel"},{"type":"text","value":"="},{"type":"text","value":"None"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"doc"},{"type":"text","value":"="},{"type":"text","value":"None"}]},{"type":"text","value":")"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Route attribute access on a class to __getattr__."}]},{"type":"paragraph","children":[{"type":"text","value":"This is a descriptor, used to define attributes that act differently when accessed through an instance and through a class. Instance access remains normal, but access to an attribute through a class will be routed to the class’s __getattr__ method; this is done by raising AttributeError."}]},{"type":"paragraph","children":[{"type":"text","value":"This allows one to have properties active on an instance, and have virtual attributes on the class with the same name (see "},{"type":"link","href":"3/library/enum.html#enum.Enum","title":"enum.Enum","children":[{"type":"inline_code","code":"enum.Enum"}]},{"type":"text","value":" for an example)."}]},{"type":"paragraph","children":[{"type":"text","value":"Added in version 3.4."}]}]}]},{"type":"anchor","id":"coroutine-utility-functions"},{"type":"heading","level":2,"id":null,"children":[{"type":"text","value":"Coroutine Utility Functions"}]},{"type":"definition_list","items":[{"id":"types.coroutine","term":[{"type":"text","value":"types.coroutine("},{"type":"emphasis","children":[{"type":"text","value":"gen_func"}]},{"type":"text","value":")"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"This function transforms a "},{"type":"link","href":"https://docs.python.org/3/glossary.html#term-generator","title":null,"children":[{"type":"text","value":"generator"}]},{"type":"text","value":" function into a "},{"type":"link","href":"https://docs.python.org/3/glossary.html#term-coroutine-function","title":null,"children":[{"type":"text","value":"coroutine function"}]},{"type":"text","value":" which returns a generator-based coroutine. The generator-based coroutine is still a "},{"type":"link","href":"https://docs.python.org/3/glossary.html#term-generator-iterator","title":null,"children":[{"type":"text","value":"generator iterator"}]},{"type":"text","value":", but is also considered to be a "},{"type":"link","href":"https://docs.python.org/3/glossary.html#term-coroutine","title":null,"children":[{"type":"text","value":"coroutine"}]},{"type":"text","value":" object and is "},{"type":"link","href":"https://docs.python.org/3/glossary.html#term-awaitable","title":null,"children":[{"type":"text","value":"awaitable"}]},{"type":"text","value":". However, it may not necessarily implement the "},{"type":"link","href":"https://docs.python.org/3/reference/datamodel.html#object.__await__","title":"object.__await__","children":[{"type":"inline_code","code":"__await__()"}]},{"type":"text","value":" method."}]},{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"emphasis","children":[{"type":"text","value":"gen_func"}]},{"type":"text","value":" is a generator function, it will be modified in-place."}]},{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"emphasis","children":[{"type":"text","value":"gen_func"}]},{"type":"text","value":" is not a generator function, it will be wrapped. If it returns an instance of "},{"type":"link","href":"3/library/collections.abc.html#collections.abc.Generator","title":"collections.abc.Generator","children":[{"type":"inline_code","code":"collections.abc.Generator"}]},{"type":"text","value":", the instance will be wrapped in an "},{"type":"emphasis","children":[{"type":"text","value":"awaitable"}]},{"type":"text","value":" proxy object. All other types of objects will be returned as is."}]},{"type":"paragraph","children":[{"type":"text","value":"Added in version 3.5."}]}]}]}]}}
