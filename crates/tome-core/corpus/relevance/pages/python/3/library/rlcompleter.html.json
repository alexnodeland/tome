{"path":"3/library/rlcompleter.html","title":"rlcompleter — Completion function for GNU readline","description":"Source code: Lib/rlcompleter.py","body":{"type":"document","children":[{"type":"anchor","id":"module-rlcompleter"},{"type":"anchor","id":"rlcompleter-completion-function-for-gnu-readline"},{"type":"heading","level":1,"id":null,"children":[{"type":"inline_code","code":"rlcompleter"},{"type":"text","value":" — Completion function for GNU readline"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Source code:"}]},{"type":"text","value":" "},{"type":"link","href":"https://github.com/python/cpython/tree/3.14/Lib/rlcompleter.py","title":null,"children":[{"type":"text","value":"Lib/rlcompleter.py"}]}]},{"type":"thematic_break"},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inline_code","code":"rlcompleter"},{"type":"text","value":" module defines a completion function suitable to be passed to "},{"type":"link","href":"3/library/readline.html#readline.set_completer","title":"readline.set_completer","children":[{"type":"inline_code","code":"set_completer()"}]},{"type":"text","value":" in the "},{"type":"link","href":"3/library/readline.html#module-readline","title":"readline: GNU readline support for Python.","children":[{"type":"inline_code","code":"readline"}]},{"type":"text","value":" module."}]},{"type":"paragraph","children":[{"type":"text","value":"When this module is imported on a Unix platform with the "},{"type":"link","href":"3/library/readline.html#module-readline","title":"readline: GNU readline support for Python.","children":[{"type":"inline_code","code":"readline"}]},{"type":"text","value":" module available, an instance of the "},{"type":"link","href":"3/library/rlcompleter.html#rlcompleter.Completer","title":"rlcompleter.Completer","children":[{"type":"inline_code","code":"Completer"}]},{"type":"text","value":" class is automatically created and its "},{"type":"link","href":"3/library/rlcompleter.html#rlcompleter.Completer.complete","title":"rlcompleter.Completer.complete","children":[{"type":"inline_code","code":"complete()"}]},{"type":"text","value":" method is set as the "},{"type":"link","href":"3/library/readline.html#readline-completion","title":null,"children":[{"type":"text","value":"readline completer"}]},{"type":"text","value":". The method provides completion of valid Python "},{"type":"link","href":"https://docs.python.org/3/reference/lexical_analysis.html#identifiers","title":null,"children":[{"type":"text","value":"identifiers and keywords"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Example:"}]},{"type":"code_block","language":"python","code":">>> import rlcompleter\n>>> import readline\n>>> readline.parse_and_bind(\"tab: complete\")\n>>> readline. <TAB PRESSED>\nreadline.__doc__          readline.get_line_buffer(  readline.read_init_file(\nreadline.__file__         readline.insert_text(      readline.set_completer(\nreadline.__name__         readline.parse_and_bind(\n>>> readline."},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inline_code","code":"rlcompleter"},{"type":"text","value":" module is designed for use with Python’s "},{"type":"link","href":"3/tutorial/interpreter.html#tut-interactive","title":null,"children":[{"type":"text","value":"interactive mode"}]},{"type":"text","value":". Unless Python is run with the "},{"type":"link","href":"https://docs.python.org/3/using/cmdline.html#cmdoption-S","title":null,"children":[{"type":"inline_code","code":"-S"}]},{"type":"text","value":" option, the module is automatically imported and configured (see "},{"type":"link","href":"https://docs.python.org/3/library/site.html#rlcompleter-config","title":null,"children":[{"type":"text","value":"Readline configuration"}]},{"type":"text","value":")."}]},{"type":"paragraph","children":[{"type":"text","value":"On platforms without "},{"type":"link","href":"3/library/readline.html#module-readline","title":"readline: GNU readline support for Python.","children":[{"type":"inline_code","code":"readline"}]},{"type":"text","value":", the "},{"type":"link","href":"3/library/rlcompleter.html#rlcompleter.Completer","title":"rlcompleter.Completer","children":[{"type":"inline_code","code":"Completer"}]},{"type":"text","value":" class defined by this module can still be used for custom purposes."}]},{"type":"definition_list","items":[{"id":"rlcompleter.Completer","term":[{"type":"emphasis","children":[{"type":"text","value":"class"},{"type":"text","value":" "}]},{"type":"text","value":"rlcompleter.Completer"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Completer objects have the following method:"}]},{"type":"definition_list","items":[{"id":"rlcompleter.Completer.complete","term":[{"type":"text","value":"complete("},{"type":"emphasis","children":[{"type":"text","value":"text"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"state"}]},{"type":"text","value":")"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Return the next possible completion for "},{"type":"emphasis","children":[{"type":"text","value":"text"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"When called by the "},{"type":"link","href":"3/library/readline.html#module-readline","title":"readline: GNU readline support for Python.","children":[{"type":"inline_code","code":"readline"}]},{"type":"text","value":" module, this method is called successively with "},{"type":"inline_code","code":"state == 0, 1, 2, ..."},{"type":"text","value":" until the method returns "},{"type":"inline_code","code":"None"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"If called for "},{"type":"emphasis","children":[{"type":"text","value":"text"}]},{"type":"text","value":" that doesn’t include a period character ("},{"type":"inline_code","code":"'.'"},{"type":"text","value":"), it will complete from names currently defined in "},{"type":"link","href":"https://docs.python.org/3/library/__main__.html#module-__main__","title":"__main__: The environment where top-level code is run. Covers command-line interfaces, import-time behavior, and ``__name__ == '__main__'``.","children":[{"type":"inline_code","code":"__main__"}]},{"type":"text","value":", "},{"type":"link","href":"https://docs.python.org/3/library/builtins.html#module-builtins","title":"builtins: The module that provides the built-in namespace.","children":[{"type":"inline_code","code":"builtins"}]},{"type":"text","value":" and keywords (as defined by the "},{"type":"link","href":"https://docs.python.org/3/library/keyword.html#module-keyword","title":"keyword: Test whether a string is a keyword in Python.","children":[{"type":"inline_code","code":"keyword"}]},{"type":"text","value":" module)."}]},{"type":"paragraph","children":[{"type":"text","value":"If called for a dotted name, it will try to evaluate anything without obvious side-effects (functions will not be evaluated, but it can generate calls to "},{"type":"link","href":"https://docs.python.org/3/reference/datamodel.html#object.__getattr__","title":"object.__getattr__","children":[{"type":"inline_code","code":"__getattr__()"}]},{"type":"text","value":") up to the last part, and find matches for the rest via the "},{"type":"link","href":"3/library/functions.html#dir","title":"dir","children":[{"type":"inline_code","code":"dir()"}]},{"type":"text","value":" function. Any exception raised during the evaluation of the expression is caught, silenced and "},{"type":"link","href":"3/library/constants.html#None","title":"None","children":[{"type":"inline_code","code":"None"}]},{"type":"text","value":" is returned."}]}]}]}]}]}]}}
