"text","value":"include"}]}]}]},{"children":[{"type":"paragraph","children":[{"type":"inline_code","code":"prefix\\Include"}]}]}]},{"cells":[{"children":[{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"platinclude"}]}]}]},{"children":[{"type":"paragraph","children":[{"type":"inline_code","code":"prefix\\Include"}]}]}]},{"cells":[{"children":[{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"scripts"}]}]}]},{"children":[{"type":"paragraph","children":[{"type":"inline_code","code":"prefix\\Scripts"}]}]}]},{"cells":[{"children":[{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"data"}]}]}]},{"children":[{"type":"paragraph","children":[{"type":"inline_code","code":"prefix"}]}]}]}]},{"type":"anchor","id":"installation-path-functions"},{"type":"heading","level":2,"id":null,"children":[{"type":"text","value":"Installation path functions"}]},{"type":"paragraph","children":[{"type":"inline_code","code":"sysconfig"},{"type":"text","value":" provides some functions to determine these installation paths."}]},{"type":"definition_list","items":[{"id":"sysconfig.get_scheme_names","term":[{"type":"text","value":"sysconfig.get_scheme_names()"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Return a tuple containing all schemes currently supported in "},{"type":"inline_code","code":"sysconfig"},{"type":"text","value":"."}]}]}]},{"type":"definition_list","items":[{"id":"sysconfig.get_default_scheme","term":[{"type":"text","value":"sysconfig.get_default_scheme()"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Return the default scheme name for the current platform."}]},{"type":"paragraph","children":[{"type":"text","value":"Added in version 3.10: This function was previously named "},{"type":"inline_code","code":"_get_default_scheme()"},{"type":"text","value":" and considered an implementation detail."}]},{"type":"paragraph","children":[{"type":"text","value":"Changed in version 3.11: When Python runs from a virtual environment, the "},{"type":"emphasis","children":[{"type":"text","value":"venv"}]},{"type":"text","value":" scheme is returned."}]}]}]},{"type":"definition_list","items":[{"id":"sysconfig.get_preferred_scheme","term":[{"type":"text","value":"sysconfig.get_preferred_scheme("},{"type":"emphasis","children":[{"type":"text","value":"key"}]},{"type":"text","value":")"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Return a preferred scheme name for an installation layout specified by "},{"type":"emphasis","children":[{"type":"text","value":"key"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"key"}]},{"type":"text","value":" must be either "},{"type":"inline_code","code":"\"prefix\""},{"type":"text","value":", "},{"type":"inline_code","code":"\"home\""},{"type":"text","value":", or "},{"type":"inline_code","code":"\"user\""},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"The return value is a scheme name listed in "},{"type":"link","href":"3/library/sysconfig.html#sysconfig.get_scheme_names","title":"sysconfig.get_scheme_names","children":[{"type":"inline_code","code":"get_scheme_names()"}]},{"type":"text","value":". It can be passed to "},{"type":"inline_code","code":"sysconfig"},{"type":"text","value":" functions that take a "},{"type":"emphasis","children":[{"type":"text","value":"scheme"}]},{"type":"text","value":" argument, such as "},{"type":"link","href":"3/library/sysconfig.html#sysconfig.get_paths","title":"sysconfig.get_paths","children":[{"type":"inline_code","code":"get_paths()"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Added in version 3.10."}]},{"type":"paragraph","children":[{"type":"text","value":"Changed in version 3.11: When Python runs from a virtual environment and "},{"type":"inline_code","code":"key=\"prefix\""},{"type":"text","value":", the "},{"type":"emphasis","children":[{"type":"text","value":"venv"}]},{"type":"text","value":" scheme is returned."}]}]}]},{"type":"definition_list","items":[{"id":"sysconfig._get_preferred_schemes","term":[{"type":"text","value":"sysconfig._get_preferred_schemes()"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Return a dict containing preferred scheme names on the current platform. Python implementers and redistributors may add their preferred schemes to the "},{"type":"inline_code","code":"_INSTALL_SCHEMES"},{"type":"text","value":" module-level global value, and modify this function to return those scheme names, to e.g. provide different schemes for system and language package managers to use, so packages installed by either do not mix with those by the other."}]},{"type":"paragraph","children":[{"type":"text","value":"End users should not use this function, but "},{"type":"link","href":"3/library/sysconfig.html#sysconfig.get_default_scheme","title":"sysconfig.get_default_scheme","children":[{"type":"inline_code","code":"get_default_scheme()"}]},{"type":"text","value":" and "},{"type":"link","href":"3/library/sysconfig.html#sysconfig.get_preferred_scheme","title":"sysconfig.get_preferred_scheme","children":[{"type":"inline_code","code":"get_preferred_scheme()"}]},{"type":"text","value":" instead."}]},{"type":"paragraph","children":[{"type":"text","value":"Added in version 3.10."}]}]}]},{"type":"definition_list","items":[{"id":"sysconfig.get_path_names","term":[{"type":"text","value":"sysconfig.get_path_names()"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Return a tuple containing all path names currently supported in "},{"type":"inline_code","code":"sysconfig"},{"type":"text","value":"."}]}]}]},{"type":"definition_list","items":[{"id":"sysconfig.get_path","term":[{"type":"text","value":"sysconfig.get_path("},{"type":"emphasis","children":[{"type":"text","value":"name"}]},{"type":"text","value":"[, "},{"type":"emphasis","children":[{"type":"text","value":"scheme"}]},{"type":"text","value":"[, "},{"type":"emphasis","children":[{"type":"text","value":"vars"}]},{"type":"text","value":"[, "},{"type":"emphasis","children":[{"type":"text","value":"expand"}]},{"type":"text","value":"]]])"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Return an installation path corresponding to the path "},{"type":"emphasis","children":[{"type":"text","value":"name"}]},{"type":"text","value":", from the install scheme named "},{"type":"emphasis","children":[{"type":"text","value":"scheme"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"name"}]},{"type":"text","value":" has to be a value from the list returned by "},{"type":"link","href":"3/library/sysconfig.html#sysconfig.get_path_names","title":"sysconfig.get_path_names","children":[{"type":"inline_code","code":"get_path_names()"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"inline_code","code":"sysconfig"},{"type":"text","value":" stores installation paths corresponding to each path name, for each platform, with variables to be expanded. For instance the "},{"type":"emphasis","children":[{"type":"text","value":"stdlib"}]},{"type":"text","value":" path for the "},{"type":"emphasis","children":[{"type":"text","value":"nt"}]},{"type":"text","value":" scheme is: "},{"type":"inline_code","code":"{base}/Lib"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"inline_code","code":"get_path()"},{"type":"text","value":" will use the variables returned by "},{"type":"link","href":"3/library/sysconfig.html#sysconfig.get_config_vars","title":"sysconfig.get_config_vars","children":[{"type":"inline_code","code":"get_config_vars()"}]},{"type":"text","value":" to expand the path. All variables have default values for each platform so one may call this function and get the default value."}]},{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"emphasis","children":[{"type":"text","value":"scheme"}]},{"type":"text","value":" is provided, it must be a value from the list returned by "},{"type":"link","href":"3/library/sysconfig.html#sysconfig.get_scheme_names","title":"sysconfig.get_scheme_names","children":[{"type":"inline_code","code":"get_scheme_names()"}]},{"type":"text","value":". Otherwise, the default scheme for the current platform is used."}]},{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"emphasis","children":[{"type":"text","value":"vars"}]},{"type":"text","value":" is provided, it must be a dictionary of variables that will update the dictionary returned by "},{"type":"link","href":"3/library/sysconfig.html#sysconfig.get_config_vars","title":"sysconfig.get_config_vars","children":[{"type":"inline_code","code":"get_config_vars()"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"emphasis","children":[{"type":"text","value":"expand"}]},{"type":"text","value":" is set to "},{"type":"inline_code","code":"False"},{"type":"text","value":", the path will not be expanded using the variables."}]},{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"emphasis","children":[{"type":"text","value":"name"}]},{"type":"text","value":" is not found, raise a "},{"type":"link","href":"3/library/exceptions.html#KeyError","title":"KeyError","children":[{"type":"inline_code","code":"KeyError"}]},{"type":"text","value":"."}]}]}]},{"type":"definition_list","items":[{"id":"sysconfig.get_paths","term":[{"type":"text","value":"sysconfig.get_paths(["},{"type":"emphasis","children":[{"type":"text","value":"scheme"}]},{"type":"text","value":"[, "},{"type":"emphasis","children":[{"type":"text","value":"vars"}]},{"type":"text","value":"[, "},{"type":"emphasis","children":[{"type":"text","value":"expand"}]},{"type":"text","value":"]]])"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Return a dictionary containing all installation paths corresponding to an installation scheme. See "},{"type":"link","href":"3/library/sysconfig.html#sysconfig.get_path","title":"sysconfig.get_path","children":[{"type":"inline_code","code":"get_path()"}]},{"type":"text","value":" for more information."}]},{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"emphasis","children":[{"type":"text","value":"scheme"}]},{"type":"text","value":" is not provided, will use the default scheme for the current platform."}]},{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"emphasis","children":[{"type":"text","value":"vars"}]},{"type":"text","value":" is provided, it must be a dictionary of variables that will update the dictionary used to expand the paths."}]},{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"emphasis","children":[{"type":"text","value":"expand"}]},{"type":"text","value":" is set to false, the paths will not be expanded."}]},{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"emphasis","children":[{"type":"text","value":"scheme"}]},{"type":"text","value":" is not an existing scheme, "},{"type":"inline_code","code":"get_paths()"},{"type":"text","value":" will raise a "},{"type":"link","href":"3/library/exceptions.html#KeyError","title":"KeyError","children":[{"type":"inline_code","code":"KeyError"}]},{"type":"text","value":"."}]}]}]},{"type":"anchor","id":"other-functions"},{"type":"heading","level":2,"id":null,"children":[{"type":"text","value":"Other functions"}]},{"type":"definition_list","items":[{"id":"sysconfig.get_python_version","term":[{"type":"text","value":"sysconfig.get_python_version()"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Return the "},{"type":"inline_code","code":"MAJOR.MINOR"},{"type":"text","value":" Python version number as a string. Similar to "},{"type":"inline_code","code":"'%d.%d' % sys.version_info[:2]"},{"type":"text","value":"."}]}]}]},{"type":"definition_list","items":[{"id":"sysconfig.get_platform","term":[{"type":"text","value":"sysconfig.get_platform()"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Return a string that identifies the current platform."}]},{"type":"paragraph","children":[{"type":"text","value":"This is used mainly to distinguish platform-specific build directories and platform-specific built distributions. Typically includes the OS name and version and the architecture (as supplied by "},{"type":"link","href":"3/library/os.html#os.uname","title":"os.uname","children":[{"type":"inline_code","code":"os.uname()"}]},{"type":"text","value":"), although the exact information included depends on the OS; e.g., on Linux, the kernel version isn’t particularly important."}]},{"type":"paragraph","children":[{"type":"text","value":"Examples of returned values:"}]},{"type":"paragraph","children":[{"type":"text","value":"Windows:"}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"paragraph","children":[{"type":"text","value":"win-amd64 (64-bit Windows on AMD64, aka x86_64, Intel64, and EM64T)"}]}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"win-arm64 (64-bit Windows on ARM64, aka AArch64)"}]}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"win32 (all others - specifically, sys.platform is returned)"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"POSIX based OS:"}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"paragraph","children":[{"type":"text","value":"linux-x86_64"}]}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"macosx-15.5-arm64"}]}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"macosx-26.0-universal2 (macOS on Apple Silicon or Intel)"}]}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"android-24-arm64_v8a"}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"For other non-POSIX platforms, currently just returns "},{"type":"link","href":"3/library/sys.html#sys.platform","title":"sys.platform","children":[{"type":"inline_code","code":"sys.platform"}]},{"type":"text","value":"."}]}]}]},{"type":"definition_list","items":[{"id":"sysconfig.is_python_build","term":[{"type":"text","value":"sysconfig.is_python_build()"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Return "},{"type":"inline_code","code":"True"},{"type":"text","value":" if the running Python interpreter was built from source and is being run from its built location, and not from a location resulting from e.g. running "},{"type":"inline_code","code":"make install"},{"type":"text","value":" or installing via a binary installer."}]}]}]},{"type":"definition_list","items":[{"id":"sysconfig.parse_config_h","term":[{"type":"text","value":"sysconfig.parse_config_h("},{"type":"emphasis","children":[{"type":"text","value":"fp"}]},{"type":"text","value":"[, "},{"type":"emphasis","children":[{"type":"text","value":"vars"}]},{"type":"text","value":"])"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Parse a "},{"type":"inline_code","code":"config.h"},{"type":"text","value":"-style file."}]},{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"fp"}]},{"type":"text","value":" is a file-like object pointing to the "},{"type":"inline_code","code":"config.h"},{"type":"text","value":"-like file."}]},{"type":"paragraph","children":[{"type":"text","value":"A dictionary containing name/value pairs is returned. If an optional dictionary is passed in as the second argument, it is used instead of a new dictionary, and updated with the values read in the file."}]}]}]},{"type":"definition_list","items":[{"id":"sysconfig.get_config_h_filename","term":[{"type":"text","value":"sysconfig.get_config_h_filename()"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Return the path of "},{"type":"inline_code","code":"pyconfig.h"},{"type":"text","value":"."}]}]}]},{"type":"definition_list","items":[{"id":"sysconfig.get_makefile_filename","term":[{"type":"text","value":"sysconfig.get_makefile_filename()"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Return the path of "},{"type":"inline_code","code":"Makefile"},{"type":"text","value":"."}]}]}]},{"type":"anchor","id":"command-line-usage"},{"type":"anchor","id":"using-sysconfig-as-a-script"},{"type":"anchor","id":"sysconfig-cli"},{"type":"heading","level":2,"id":null,"children":[{"type":"text","value":"Command-line usage"}]},{"type":"paragraph","children":[{"type":"text","value":"You can use "},{"type":"inline_code","code":"sysconfig"},{"type":"text","value":" as a script with Python’s "},{"type":"emphasis","children":[{"type":"text","value":"-m"}]},{"type":"text","value":" option:"}]},{"type":"code_block","language":"bash","code":"$ python -m sysconfig\nPlatform: \"macosx-10.4-i386\"\nPython version: \"3.2\"\nCurrent installation scheme: \"posix_prefix\"\n\nPaths:\n        data = \"/usr/local\"\n        include = \"/Users/tarek/Dev/svn.python.org/py3k/Include\"\n        platinclude = \".\"\n        platlib = \"/usr/local/lib/python3.2/site-packages\"\n        platstdlib = \"/usr/local/lib/python3.2\"\n        purelib = \"/usr/local/lib/python3.2/site-packages\"\n        scripts = \"/usr/local/bin\"\n        stdlib = \"/usr/local/lib/python3.2\"\n\nVariables:\n        AC_APPLE_UNIVERSAL_BUILD = \"0\"\n        AIX_GENUINE_CPLUSPLUS = \"0\"\n        AR = \"ar\"\n        ARFLAGS = \"rc\"\n        ..."},{"type":"paragraph","children":[{"type":"text","value":"This call will print in the standard output the information returned by "},{"type":"link","href":"3/library/sysconfig.html#sysconfig.get_platform","title":"sysconfig.get_platform","children":[{"type":"inline_code","code":"get_platform()"}]},{"type":"text","value":", "},{"type":"link","href":"3/library/sysconfig.html#sysconfig.get_python_version","title":"sysconfig.get_python_version","children":[{"type":"inline_code","code":"get_python_version()"}]},{"type":"text","value":", "},{"type":"link","href":"3/library/sysconfig.html#sysconfig.get_path","title":"sysconfig.get_path","children":[{"type":"inline_code","code":"get_path()"}]},{"type":"text","value":" and "},{"type":"link","href":"3/library/sysconfig.html#sysconfig.get_config_vars","title":"sysconfig.get_config_vars","children":[{"type":"inline_code","code":"get_config_vars()"}]},{"type":"text","value":"."}]}]}}
