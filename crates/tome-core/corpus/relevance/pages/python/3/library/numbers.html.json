d "},{"type":"inline_code","code":"!="},{"type":"text","value":". All except "},{"type":"inline_code","code":"-"},{"type":"text","value":" and "},{"type":"inline_code","code":"!="},{"type":"text","value":" are abstract."}]},{"type":"definition_list","items":[{"id":"numbers.Complex.real","term":[{"type":"text","value":"real"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Abstract. Retrieves the real component of this number."}]}]}]},{"type":"definition_list","items":[{"id":"numbers.Complex.imag","term":[{"type":"text","value":"imag"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Abstract. Retrieves the imaginary component of this number."}]}]}]},{"type":"definition_list","items":[{"id":"numbers.Complex.conjugate","term":[{"type":"emphasis","children":[{"type":"text","value":"abstractmethod"},{"type":"text","value":" "}]},{"type":"text","value":"conjugate()"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Abstract. Returns the complex conjugate. For example, "},{"type":"inline_code","code":"(1+3j).conjugate()\n== (1-3j)"},{"type":"text","value":"."}]}]}]}]}]},{"type":"definition_list","items":[{"id":"numbers.Real","term":[{"type":"emphasis","children":[{"type":"text","value":"class"},{"type":"text","value":" "}]},{"type":"text","value":"numbers.Real"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"To "},{"type":"link","href":"3/library/numbers.html#numbers.Complex","title":"numbers.Complex","children":[{"type":"inline_code","code":"Complex"}]},{"type":"text","value":", "},{"type":"inline_code","code":"Real"},{"type":"text","value":" adds the operations that work on real numbers."}]},{"type":"paragraph","children":[{"type":"text","value":"In short, those are: a conversion to "},{"type":"link","href":"3/library/functions.html#float","title":"float","children":[{"type":"inline_code","code":"float"}]},{"type":"text","value":", "},{"type":"link","href":"3/library/math.html#math.trunc","title":"math.trunc","children":[{"type":"inline_code","code":"math.trunc()"}]},{"type":"text","value":", "},{"type":"link","href":"3/library/functions.html#round","title":"round","children":[{"type":"inline_code","code":"round()"}]},{"type":"text","value":", "},{"type":"link","href":"3/library/math.html#math.floor","title":"math.floor","children":[{"type":"inline_code","code":"math.floor()"}]},{"type":"text","value":", "},{"type":"link","href":"3/library/math.html#math.ceil","title":"math.ceil","children":[{"type":"inline_code","code":"math.ceil()"}]},{"type":"text","value":", "},{"type":"link","href":"3/library/functions.html#divmod","title":"divmod","children":[{"type":"inline_code","code":"divmod()"}]},{"type":"text","value":", "},{"type":"inline_code","code":"//"},{"type":"text","value":", "},{"type":"inline_code","code":"%"},{"type":"text","value":", "},{"type":"inline_code","code":"<"},{"type":"text","value":", "},{"type":"inline_code","code":"<="},{"type":"text","value":", "},{"type":"inline_code","code":">"},{"type":"text","value":", and "},{"type":"inline_code","code":">="},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Real also provides defaults for "},{"type":"link","href":"3/library/functions.html#complex","title":"complex","children":[{"type":"inline_code","code":"complex()"}]},{"type":"text","value":", "},{"type":"link","href":"3/library/numbers.html#numbers.Complex.real","title":"numbers.Complex.real","children":[{"type":"inline_code","code":"real"}]},{"type":"text","value":", "},{"type":"link","href":"3/library/numbers.html#numbers.Complex.imag","title":"numbers.Complex.imag","children":[{"type":"inline_code","code":"imag"}]},{"type":"text","value":", and "},{"type":"link","href":"3/library/numbers.html#numbers.Complex.conjugate","title":"numbers.Complex.conjugate","children":[{"type":"inline_code","code":"conjugate()"}]},{"type":"text","value":"."}]}]}]},{"type":"definition_list","items":[{"id":"numbers.Rational","term":[{"type":"emphasis","children":[{"type":"text","value":"class"},{"type":"text","value":" "}]},{"type":"text","value":"numbers.Rational"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Subtypes "},{"type":"link","href":"3/library/numbers.html#numbers.Real","title":"numbers.Real","children":[{"type":"inline_code","code":"Real"}]},{"type":"text","value":" and adds "},{"type":"link","href":"3/library/numbers.html#numbers.Rational.numerator","title":"numbers.Rational.numerator","children":[{"type":"inline_code","code":"numerator"}]},{"type":"text","value":" and "},{"type":"link","href":"3/library/numbers.html#numbers.Rational.denominator","title":"numbers.Rational.denominator","children":[{"type":"inline_code","code":"denominator"}]},{"type":"text","value":" properties. It also provides a default for "},{"type":"link","href":"3/library/functions.html#float","title":"float","children":[{"type":"inline_code","code":"float()"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"link","href":"3/library/numbers.html#numbers.Rational.numerator","title":"numbers.Rational.numerator","children":[{"type":"inline_code","code":"numerator"}]},{"type":"text","value":" and "},{"type":"link","href":"3/library/numbers.html#numbers.Rational.denominator","title":"numbers.Rational.denominator","children":[{"type":"inline_code","code":"denominator"}]},{"type":"text","value":" values should be instances of "},{"type":"link","href":"3/library/numbers.html#numbers.Integral","title":"numbers.Integral","children":[{"type":"inline_code","code":"Integral"}]},{"type":"text","value":" and should be in lowest terms with "},{"type":"inline_code","code":"denominator"},{"type":"text","value":" positive."}]},{"type":"definition_list","items":[{"id":"numbers.Rational.numerator","term":[{"type":"text","value":"numerator"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Abstract. The numerator of this rational number."}]}]}]},{"type":"definition_list","items":[{"id":"numbers.Rational.denominator","term":[{"type":"text","value":"denominator"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Abstract. The denominator of this rational number."}]}]}]}]}]},{"type":"definition_list","items":[{"id":"numbers.Integral","term":[{"type":"emphasis","children":[{"type":"text","value":"class"},{"type":"text","value":" "}]},{"type":"text","value":"numbers.Integral"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Subtypes "},{"type":"link","href":"3/library/numbers.html#numbers.Rational","title":"numbers.Rational","children":[{"type":"inline_code","code":"Rational"}]},{"type":"text","value":" and adds a conversion to "},{"type":"link","href":"3/library/functions.html#int","title":"int","children":[{"type":"inline_code","code":"int"}]},{"type":"text","value":". Provides defaults for "},{"type":"link","href":"3/library/functions.html#float","title":"float","children":[{"type":"inline_code","code":"float()"}]},{"type":"text","value":", "},{"type":"link","href":"3/library/numbers.html#numbers.Rational.numerator","title":"numbers.Rational.numerator","children":[{"type":"inline_code","code":"numerator"}]},{"type":"text","value":", and "},{"type":"link","href":"3/library/numbers.html#numbers.Rational.denominator","title":"numbers.Rational.denominator","children":[{"type":"inline_code","code":"denominator"}]},{"type":"text","value":". Adds abstract methods for "},{"type":"link","href":"3/library/functions.html#pow","title":"pow","children":[{"type":"inline_code","code":"pow()"}]},{"type":"text","value":" with modulus and bit-string operations: "},{"type":"inline_code","code":"<<"},{"type":"text","value":", "},{"type":"inline_code","code":">>"},{"type":"text","value":", "},{"type":"inline_code","code":"&"},{"type":"text","value":", "},{"type":"inline_code","code":"^"},{"type":"text","value":", "},{"type":"inline_code","code":"|"},{"type":"text","value":", "},{"type":"inline_code","code":"~"},{"type":"text","value":"."}]}]}]},{"type":"anchor","id":"notes-for-type-implementers"},{"type":"heading","level":2,"id":null,"children":[{"type":"text","value":"Notes for type implementers"}]},{"type":"paragraph","children":[{"type":"text","value":"Implementers should be careful to make equal numbers equal and hash them to the same values. This may be subtle if there are two different extensions of the real numbers. See also "},{"type":"link","href":"3/library/stdtypes.html#numeric-hash","title":null,"children":[{"type":"text","value":"Hashing of numeric types"}]},{"type":"text","value":"."}]},{"type":"anchor","id":"adding-more-numeric-abcs"},{"type":"heading","level":3,"id":null,"children":[{"type":"text","value":"Adding More Numeric ABCs"}]},{"type":"paragraph","children":[{"type":"text","value":"There are, of course, more possible ABCs for numbers, and this would be a poor hierarchy if it precluded the possibility of adding those. You can add "},{"type":"inline_code","code":"MyFoo"},{"type":"text","value":" between "},{"type":"link","href":"3/library/numbers.html#numbers.Complex","title":"numbers.Complex","children":[{"type":"inline_code","code":"Complex"}]},{"type":"text","value":" and "},{"type":"link","href":"3/library/numbers.html#numbers.Real","title":"numbers.Real","children":[{"type":"inline_code","code":"Real"}]},{"type":"text","value":" with:"}]},{"type":"code_block","language":"python","code":"class MyFoo(Complex): ...\nMyFoo.register(Real)"},{"type":"anchor","id":"implementing-the-arithmetic-operations"},{"type":"anchor","id":"id1"},{"type":"heading","level":3,"id":null,"children":[{"type":"text","value":"Implementing the arithmetic operations"}]},{"type":"paragraph","children":[{"type":"text","value":"We want to implement the arithmetic operations so that mixed-mode operations either call an implementation whose author knew about the types of both arguments, or convert both to the nearest built in type and do the operation there. For subtypes of "},{"type":"link","href":"3/library/numbers.html#numbers.Integral","title":"numbers.Integral","children":[{"type":"inline_code","code":"Integral"}]},{"type":"text","value":", this means that "},{"type":"link","href":"https://docs.python.org/3/reference/datamodel.html#object.__add__","title":"object.__add__","children":[{"type":"inline_code","code":"__add__()"}]},{"type":"text","value":" and "},{"type":"link","href":"https://docs.python.org/3/reference/datamodel.html#object.__radd__","title":"object.__radd__","children":[{"type":"inline_code","code":"__radd__()"}]},{"type":"text","value":" should be defined as:"}]},{"type":"code_block","language":"python","code":"class MyIntegral(Integral):\n\n    def __add__(self, other):\n        if isinstance(other, MyIntegral):\n            return do_my_adding_stuff(self, other)\n        elif isinstance(other, OtherTypeIKnowAbout):\n            return do_my_other_adding_stuff(self, other)\n        else:\n            return NotImplemented\n\n    def __radd__(self, other):\n        if isinstance(other, MyIntegral):\n            return do_my_adding_stuff(other, self)\n        elif isinstance(other, OtherTypeIKnowAbout):\n            return do_my_other_adding_stuff(other, self)\n        elif isinstance(other, Integral):\n            return int(other) + int(self)\n        elif isinstance(other, Real):\n            return float(other) + float(self)\n        elif isinstance(other, Complex):\n            return complex(other) + complex(self)\n        else:\n            return NotImplemented"},{"type":"paragraph","children":[{"type":"text","value":"There are 5 different cases for a mixed-type operation on subclasses of "},{"type":"link","href":"3/library/numbers.html#numbers.Complex","title":"numbers.Complex","children":[{"type":"inline_code","code":"Complex"}]},{"type":"text","value":". I’ll refer to all of the above code that doesn’t refer to "},{"type":"inline_code","code":"MyIntegral"},{"type":"text","value":" and "},{"type":"inline_code","code":"OtherTypeIKnowAbout"},{"type":"text","value":" as “boilerplate”. "},{"type":"inline_code","code":"a"},{"type":"text","value":" will be an instance of "},{"type":"inline_code","code":"A"},{"type":"text","value":", which is a subtype of "},{"type":"inline_code","code":"Complex"},{"type":"text","value":" ("},{"type":"inline_code","code":"a : A <: Complex"},{"type":"text","value":"), and "},{"type":"inline_code","code":"b : B <:\nComplex"},{"type":"text","value":". I’ll consider "},{"type":"inline_code","code":"a + b"},{"type":"text","value":":"}]},{"type":"list","ordered":true,"start":null,"items":[{"children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inline_code","code":"A"},{"type":"text","value":" defines an "},{"type":"link","href":"https://docs.python.org/3/reference/datamodel.html#object.__add__","title":"object.__add__","children":[{"type":"inline_code","code":"__add__()"}]},{"type":"text","value":" which accepts "},{"type":"inline_code","code":"b"},{"type":"text","value":", all is well."}]}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inline_code","code":"A"},{"type":"text","value":" falls back to the boilerplate code, and it were to return a value from "},{"type":"link","href":"https://docs.python.org/3/reference/datamodel.html#object.__add__","title":"object.__add__","children":[{"type":"inline_code","code":"__add__()"}]},{"type":"text","value":", we’d miss the possibility that "},{"type":"inline_code","code":"B"},{"type":"text","value":" defines a more intelligent "},{"type":"link","href":"https://docs.python.org/3/reference/datamodel.html#object.__radd__","title":"object.__radd__","children":[{"type":"inline_code","code":"__radd__()"}]},{"type":"text","value":", so the boilerplate should return "},{"type":"link","href":"3/library/constants.html#NotImplemented","title":"NotImplemented","children":[{"type":"inline_code","code":"NotImplemented"}]},{"type":"text","value":" from "},{"type":"inline_code","code":"__add__()"},{"type":"text","value":". (Or "},{"type":"inline_code","code":"A"},{"type":"text","value":" may not implement "},{"type":"inline_code","code":"__add__()"},{"type":"text","value":" at all.)"}]}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"Then "},{"type":"inline_code","code":"B"},{"type":"text","value":"’s "},{"type":"link","href":"https://docs.python.org/3/reference/datamodel.html#object.__radd__","title":"object.__radd__","children":[{"type":"inline_code","code":"__radd__()"}]},{"type":"text","value":" gets a chance. If it accepts "},{"type":"inline_code","code":"a"},{"type":"text","value":", all is well."}]}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"If it falls back to the boilerplate, there are no more possible methods to try, so this is where the default implementation should live."}]}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inline_code","code":"B <: A"},{"type":"text","value":", Python tries "},{"type":"inline_code","code":"B.__radd__"},{"type":"text","value":" before "},{"type":"inline_code","code":"A.__add__"},{"type":"text","value":". This is ok, because it was implemented with knowledge of "},{"type":"inline_code","code":"A"},{"type":"text","value":", so it can handle those instances before delegating to "},{"type":"link","href":"3/library/numbers.html#numbers.Complex","title":"numbers.Complex","children":[{"type":"inline_code","code":"Complex"}]},{"type":"text","value":"."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"inline_code","code":"A <: Complex"},{"type":"text","value":" and "},{"type":"inline_code","code":"B <: Real"},{"type":"text","value":" without sharing any other knowledge, then the appropriate shared operation is the one involving the built in "},{"type":"link","href":"3/library/functions.html#complex","title":"complex","children":[{"type":"inline_code","code":"complex"}]},{"type":"text","value":", and both "},{"type":"link","href":"https://docs.python.org/3/reference/datamodel.html#object.__radd__","title":"object.__radd__","children":[{"type":"inline_code","code":"__radd__()"}]},{"type":"text","value":" s land there, so "},{"type":"inline_code","code":"a+b\n== b+a"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Because most of the operations on any given type will be very similar, it can be useful to define a helper function which generates the forward and reverse instances of any given operator. For example, "},{"type":"link","href":"3/library/fractions.html#fractions.Fraction","title":"fractions.Fraction","children":[{"type":"inline_code","code":"fractions.Fraction"}]},{"type":"text","value":" uses:"}]},{"type":"code_block","language":"python","code":"def _operator_fallbacks(monomorphic_operator, fallback_operator):\n    def forward(a, b):\n        if isinstance(b, (int, Fraction)):\n            return monomorphic_operator(a, b)\n        elif isinstance(b, float):\n            return fallback_operator(float(a), b)\n        elif isinstance(b, complex):\n            return fallback_operator(complex(a), b)\n        else:\n            return NotImplemented\n    forward.__name__ = '__' + fallback_operator.__name__ + '__'\n    forward.__doc__ = monomorphic_operator.__doc__\n\n    def reverse(b, a):\n        if isinstance(a, Rational):\n            # Includes ints.\n            return monomorphic_operator(a, b)\n        elif isinstance(a, Real):\n            return fallback_operator(float(a), float(b))\n        elif isinstance(a, Complex):\n            return fallback_operator(complex(a), complex(b))\n        else:\n            return NotImplemented\n    reverse.__name__ = '__r' + fallback_operator.__name__ + '__'\n    reverse.__doc__ = monomorphic_operator.__doc__\n\n    return forward, reverse\n\ndef _add(a, b):\n    \"\"\"a + b\"\"\"\n    return Fraction(a.numerator * b.denominator +\n                    b.numerator * a.denominator,\n                    a.denominator * b.denominator)\n\n__add__, __radd__ = _operator_fallbacks(_add, operator.add)\n\n# ..."}]}}
