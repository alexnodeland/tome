{"path":"3/library/textwrap.html","title":"textwrap — Text wrapping and filling","description":"Source code: Lib/textwrap.py","body":{"type":"document","children":[{"type":"anchor","id":"module-textwrap"},{"type":"anchor","id":"textwrap-text-wrapping-and-filling"},{"type":"heading","level":1,"id":null,"children":[{"type":"inline_code","code":"textwrap"},{"type":"text","value":" — Text wrapping and filling"}]},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Source code:"}]},{"type":"text","value":" "},{"type":"link","href":"https://github.com/python/cpython/tree/3.14/Lib/textwrap.py","title":null,"children":[{"type":"text","value":"Lib/textwrap.py"}]}]},{"type":"thematic_break"},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inline_code","code":"textwrap"},{"type":"text","value":" module provides some convenience functions, as well as "},{"type":"link","href":"3/library/textwrap.html#textwrap.TextWrapper","title":"textwrap.TextWrapper","children":[{"type":"inline_code","code":"TextWrapper"}]},{"type":"text","value":", the class that does all the work. If you’re just wrapping or filling one or two text strings, the convenience functions should be good enough; otherwise, you should use an instance of "},{"type":"inline_code","code":"TextWrapper"},{"type":"text","value":" for efficiency."}]},{"type":"definition_list","items":[{"id":"textwrap.wrap","term":[{"type":"text","value":"textwrap.wrap("},{"type":"emphasis","children":[{"type":"text","value":"text"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"width"},{"type":"text","value":"="},{"type":"text","value":"70"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"*"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"initial_indent"},{"type":"text","value":"="},{"type":"text","value":"''"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"subsequent_indent"},{"type":"text","value":"="},{"type":"text","value":"''"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"expand_tabs"},{"type":"text","value":"="},{"type":"text","value":"True"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"replace_whitespace"},{"type":"text","value":"="},{"type":"text","value":"True"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"fix_sentence_endings"},{"type":"text","value":"="},{"type":"text","value":"False"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"break_long_words"},{"type":"text","value":"="},{"type":"text","value":"True"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"drop_whitespace"},{"type":"text","value":"="},{"type":"text","value":"True"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"break_on_hyphens"},{"type":"text","value":"="},{"type":"text","value":"True"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"tabsize"},{"type":"text","value":"="},{"type":"text","value":"8"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"max_lines"},{"type":"text","value":"="},{"type":"text","value":"None"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"placeholder"},{"type":"text","value":"="},{"type":"text","value":"' "},{"type":"text","value":"[...]'"}]},{"type":"text","value":")"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Wraps the single paragraph in "},{"type":"emphasis","children":[{"type":"text","value":"text"}]},{"type":"text","value":" (a string) so every line is at most "},{"type":"emphasis","children":[{"type":"text","value":"width"}]},{"type":"text","value":" characters long. Returns a list of output lines, without final newlines."}]},{"type":"paragraph","children":[{"type":"text","value":"Optional keyword arguments correspond to the instance attributes of "},{"type":"link","href":"3/library/textwrap.html#textwrap.TextWrapper","title":"textwrap.TextWrapper","children":[{"type":"inline_code","code":"TextWrapper"}]},{"type":"text","value":", documented below."}]},{"type":"paragraph","children":[{"type":"text","value":"See the "},{"type":"link","href":"3/library/textwrap.html#textwrap.TextWrapper.wrap","title":"textwrap.TextWrapper.wrap","children":[{"type":"inline_code","code":"TextWrapper.wrap()"}]},{"type":"text","value":" method for additional details on how "},{"type":"inline_code","code":"wrap()"},{"type":"text","value":" behaves."}]}]}]},{"type":"definition_list","items":[{"id":"textwrap.fill","term":[{"type":"text","value":"textwrap.fill("},{"type":"emphasis","children":[{"type":"text","value":"text"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"width"},{"type":"text","value":"="},{"type":"text","value":"70"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"*"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"initial_indent"},{"type":"text","value":"="},{"type":"text","value":"''"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"subsequent_indent"},{"type":"text","value":"="},{"type":"text","value":"''"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"expand_tabs"},{"type":"text","value":"="},{"type":"text","value":"True"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"replace_whitespace"},{"type":"text","value":"="},{"type":"text","value":"True"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"fix_sentence_endings"},{"type":"text","value":"="},{"type":"text","value":"False"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"break_long_words"},{"type":"text","value":"="},{"type":"text","value":"True"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"drop_whitespace"},{"type":"text","value":"="},{"type":"text","value":"True"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"break_on_hyphens"},{"type":"text","value":"="},{"type":"text","value":"True"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"tabsize"},{"type":"text","value":"="},{"type":"text","value":"8"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"max_lines"},{"type":"text","value":"="},{"type":"text","value":"None"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"placeholder"},{"type":"text","value":"="},{"type":"text","value":"' "},{"type":"text","value":"[...]'"}]},{"type":"text","value":")"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Wraps the single paragraph in "},{"type":"emphasis","children":[{"type":"text","value":"text"}]},{"type":"text","value":", and returns a single string containing the wrapped paragraph. "},{"type":"inline_code","code":"fill()"},{"type":"text","value":" is shorthand for"}]},{"type":"code_block","language":"python","code":"\"\\n\".join(wrap(text, ...))"},{"type":"paragraph","children":[{"type":"text","value":"In particular, "},{"type":"inline_code","code":"fill()"},{"type":"text","value":" accepts exactly the same keyword arguments as "},{"type":"link","href":"3/library/textwrap.html#textwrap.wrap","title":"textwrap.wrap","children":[{"type":"inline_code","code":"wrap()"}]},{"type":"text","value":"."}]}]}]},{"type":"definition_list","items":[{"id":"textwrap.shorten","term":[{"type":"text","value":"textwrap.shorten("},{"type":"emphasis","children":[{"type":"text","value":"text"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"width"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"*"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"fix_sentence_endings"},{"type":"text","value":"="},{"type":"text","value":"False"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"break_long_words"},{"type":"text","value":"="},{"type":"text","value":"True"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"break_on_hyphens"},{"type":"text","value":"="},{"type":"text","value":"True"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"placeholder"},{"type":"text","value":"="},{"type":"text","value":"' "},{"type":"text","value":"[...]'"}]},{"type":"text","value":")"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Collapse and truncate the given "},{"type":"emphasis","children":[{"type":"text","value":"text"}]},{"type":"text","value":" to fit in the given "},{"type":"emphasis","children":[{"type":"text","value":"width"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"First the whitespace in "},{"type":"emphasis","children":[{"type":"text","value":"text"}]},{"type":"text","value":" is collapsed (all whitespace is replaced by single spaces). If the result fits in the "},{"type":"emphasis","children":[{"type":"text","value":"width"}]},{"type":"text","value":", it is returned. Otherwise, enough words are dropped from the end so that the remaining words plus the "},{"type":"emphasis","children":[{"type":"text","value":"placeholder"}]},{"type":"text","value":" fit within "},{"type":"emphasis","children":[{"type":"text","value":"width"}]},{"type":"text","value":":"}]},{"type":"code_block","language":"python","code":">>> textwrap.shorten(\"Hello  world!\", width=12)\n'Hello world!'\n>>> textwrap.shorten(\"Hello  world!\", width=11)\n'Hello [...]'\n>>> textwrap.shorten(\"Hello world\", width=10, placeholder=\"...\")\n'Hello...'"},{"type":"paragraph","children":[{"type":"text","value":"Optional keyword arguments correspond to the instance attributes of "},{"type":"link","href":"3/library/textwrap.html#textwrap.TextWrapper","title":"textwrap.TextWrapper","children":[{"type":"inline_code","code":"TextWrapper"}]},{"type":"text","value":", documented below. Note that the whitespace is collapsed before the text is passed to the "},{"type":"inline_code","code":"TextWrapper"},{"type":"text","value":" "},{"type":"link","href":"3/library/textwrap.html#textwrap.fill","title":"textwrap.fill","children":[{"type":"inline_code","code":"fill()"}]},{"type":"text","value":" function, so changing the value of "},{"type":"link","href":"3/library/textwrap.html#textwrap.TextWrapper.tabsize","title":"textwrap.TextWrapper.tabsize","children":[{"type":"inline_code","code":"tabsize"}]},{"type":"text","value":", "},{"type":"link","href":"3/library/textwrap.html#textwrap.TextWrapper.expand_tabs","title":"textwrap.TextWrapper.expand_tabs","children":[{"type":"inline_code","code":"expand_tabs"}]},{"type":"text","value":", "},{"type":"link","href":"3/library/textwrap.html#textwrap.TextWrapper.drop_whitespace","title":"textwrap.TextWrapper.drop_whitespace","children":[{"type":"inline_code","code":"drop_whitespace"}]},{"type":"text","value":", and "},{"type":"link","href":"3/library/textwrap.html#textwrap.TextWrapper.replace_whitespace","title":"textwrap.TextWrapper.replace_whitespace","children":[{"type":"inline_code","code":"replace_whitespace"}]},{"type":"text","value":" will have no effect."}]},{"type":"paragraph","children":[{"type":"text","value":"Added in version 3.4."}]}]}]},{"type":"definition_list","items":[{"id":"textwrap.dedent","term":[{"type":"text","value":"textwrap.dedent("},{"type":"emphasis","children":[{"type":"text","value":"text"}]},{"type":"text","value":")"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Remove any common leading whitespace from every line in "},{"type":"emphasis","children":[{"type":"text","value":"text"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"This can be used to make triple-quoted strings line up with the left edge of the display, while still presenting them in the source code in indented form."}]},{"type":"paragraph","children":[{"type":"text","value":"Note that tabs and spaces are both treated as whitespace, but they are not equal: the lines "},{"type":"inline_code","code":"\"  hello\""},{"type":"text","value":" and "},{"type":"inline_code","code":"\"\\thello\""},{"type":"text","value":" are considered to have no common leading whitespace."}]},{"type":"paragraph","children":[{"type":"text","value":"Lines containing only whitespace are ignored in the input and normalized to a single newline character in the output."}]},{"type":"paragraph","children":[{"type":"text","value":"For example:"}]},{"type":"code_block","language":"python","code":"def test():\n    # end first line with \\ to avoid the empty line!\n    s = '''\\\n    hello\n      world\n    '''\n    print(repr(s))          # prints '    hello\\n      world\\n    '\n    print(repr(dedent(s)))  # prints 'hello\\n  world\\n'"},{"type":"paragraph","children":[{"type":"text","value":"Changed in version 3.14: The "},{"type":"inline_code","code":"dedent()"},{"type":"text","value":" function now correctly normalizes blank lines containing only whitespace characters. Previously, the implementation only normalized blank lines containing tabs and spaces."}]}]}]},{"type":"definition_list","items":[{"id":"textwrap.indent","term":[{"type":"text","value":"textwrap.indent("},{"type":"emphasis","children":[{"type":"text","value":"text"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"prefix"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"predicate"},{"type":"text","value":"="},{"type":"text","value":"None"}]},{"type":"text","value":")"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Add "},{"type":"emphasis","children":[{"type":"text","value":"prefix"}]},{"type":"text","value":" to the beginning of selected lines in "},{"type":"emphasis","children":[{"type":"text","value":"text"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Lines are separated by calling "},{"type":"inline_code","code":"text.splitlines(True)"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"By default, "},{"type":"emphasis","children":[{"type":"text","value":"prefix"}]},{"type":"text","value":" is added to all lines that do not consist solely of whitespace (including any line endings)."}]},{"type":"paragraph","children":[{"type":"text","value":"For example:"}]},{"type":"code_block","language":"python","code":">>> s = 'hello\\n\\n \\nworld'\n>>> indent(s, '  ')\n'  hello\\n\\n \\n  world'"},{"type":"paragraph","children":[{"type":"text","value":"The optional "},{"type":"emphasis","children":[{"type":"text","value":"predicate"}]},{"type":"text","value":" argument can be used to control which lines are indented. For example, it is easy to add "},{"type":"emphasis","children":[{"type":"text","value":"prefix"}]},{"type":"text","value":" to even empty and whitespace-only lines:"}]},{"type":"code_block","language":"python","code":">>> print(indent(s, '+ ', lambda line: True))\n+ hello\n+\n+\n+ world"},{"type":"paragraph","children":[{"type":"text","value":"Added in version 3.3."}]}]}]},{"type":"paragraph","children":[{"type":"link","href":"3/library/textwrap.html#textwrap.wrap","title":"textwrap.wrap","children":[{"type":"inline_code","code":"wrap()"}]},{"type":"text","value":", "},{"type":"link","href":"3/library/textwrap.html#textwrap.fill","title":"textwrap.fill","children":[{"type":"inline_code","code":"fill()"}]},{"type":"text","value":" and "},{"type":"link","href":"3/library/textwrap.html#textwrap.shorten","title":"textwrap.shorten","children":[{"type":"inline_code","code":"shorten()"}]},{"type":"text","value":" work by creating a "},{"type":"link","href":"3/library/textwrap.html#textwrap.TextWrapper","title":"textwrap.TextWrapper","children":[{"type":"inline_code","code":"TextWrapper"}]},{"type":"text","value":" instance and calling a single method on it. That instance is not reused, so for applications that process many text strings using "},{"type":"inline_code","code":"wrap()"},{"type":"text","value":" and/or "},{"type":"inline_code","code":"fill()"},{"type":"text","value":", it may be more efficient to create your own "},{"type":"inline_code","code":"TextWrapper"},{"type":"text","value":" object."}]},{"type":"paragraph","children":[{"type":"text","value":"Text is preferably wrapped on whitespaces and right after the hyphens in hyphenated words; only then will long words be broken if necessary, unless "},{"type":"link","href":"3/library/textwrap.html#textwrap.TextWrapper.break_long_words","title":"textwrap.TextWrapper.break_long_words","children":[{"type":"inline_code","code":"TextWrapper.break_long_words"}]},{"type":"text","value":" is set to false."}]},{"type":"definition_list","items":[{"id":"textwrap.TextWrapper","term":[{"type":"emphasis","children":[{"type":"text","value":"class"},{"type":"text","value":" "}]},{"type":"text","value":"textwrap.TextWrapper("},{"type":"emphasis","children":[{"type":"text","value":"**"},{"type":"text","value":"kwargs"}]},{"type":"text","value":")"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inline_code","code":"TextWrapper"},{"type":"text","value":" constructor accepts a number of optional keyword arguments. Each keyword argument corresponds to an instance attribute, so for example"}]},{"type":"code_block","language":"python","code":"wrapper = TextWrapper(initial_indent=\"* \")"},{"type":"paragraph","children":[{"type":"text","value":"is the same as"}]},{"type":"code_block","language":"python","code":"wrapper = TextWrapper()\nwrapper.initial_indent = \"* \""},{"type":"paragraph","children":[{"type":"text","value":"You can reuse the same "},{"type":"inline_code","code":"TextWrapper"},{"type":"text","value":" object many times, and you can change any of its options through direct assignment to instance attributes between uses."}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"inline_code","code":"TextWrapper"},{"type":"text","value":" instance attributes (and keyword arguments to the constructor) are as follows:"}]},{"type":"definition_list","items":[{"id":"textwrap.TextWrapper.width","term":[{"type":"text","value":"width"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"(default: "},{"type":"inline_code","code":"70"},{"type":"text","value":") The maximum length of wrapped lines. As long as there are no individual words in the input text longer than "},{"type":"link","href":"3/library/textwrap.html#textwrap.TextWrapper.width","title":"textwrap.TextWrapper.width","children":[{"type":"inline_code","code":"width"}]},{"type":"text","value":", "},{"type":"inline_code","code":"TextWrapper"},{"type":"text","value":" guarantees that no output line will be longer than "},{"type":"inline_code","code":"width"},{"type":"text","value":" characters."}]}]}]},{"type":"definition_list","items":[{"id":"textwrap.TextWrapper.expand_tabs","term":[{"type":"text","value":"expand_tabs"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"(default: "},{"type":"inline_code","code":"True"},{"type":"text","value":") If true, then all tab characters in "},{"type":"emphasis","children":[{"type":"text","value":"text"}]},{"type":"text","value":" will be expanded to spaces using the "},{"type":"link","href":"3/library/stdtypes.html#str.expandtabs","title":"str.expandtabs","children":[{"type":"inline_code","code":"expandtabs()"}]},{"type":"text","value":" method of "},{"type":"emphasis","children":[{"type":"text","value":"text"}]},{"type":"text","value":"."}]}]}]},{"type":"definition_list","items":[{"id":"textwrap.TextWrapper.tabsize","term":[{"type":"text","value":"tabsize"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"(default: "},{"type":"inline_code","code":"8"},{"type":"text","value":") If "},{"type":"link","href":"3/library/textwrap.html#textwrap.TextWrapper.expand_tabs","title":"textwrap.TextWrapper.expand_tabs","children":[{"type":"inline_code","code":"expand_tabs"}]},{"type":"text","value":" is true, then all tab characters in "},{"type":"emphasis","children":[{"type":"text","value":"text"}]},{"type":"text","value":" will be expanded to zero or more spaces, depending on the current column and the given tab size."}]},{"type":"paragraph","children":[{"type":"text","value":"Added in version 3.3."}]}]}]},{"type":"definition_list","items":[{"id":"textwrap.TextWrapper.replace_whitespace","term":[{"type":"text","value":"replace_whitespace"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"(default: "},{"type":"inline_code","code":"True"},{"type":"text","value":") If true, after tab expansion but before wrapping, the "},{"type":"link","href":"3/library/textwrap.html#textwrap.wrap","title":"textwrap.wrap","children":[{"type":"inline_code","code":"wrap()"}]},{"type":"text","value":" method will replace each whitespace character with a single space. The whitespace characters replaced are as follows: tab, newline, vertical tab, formfeed, and carriage return ("},{"type":"inline_code","code":"'\\t\\n\\v\\f\\r'"},{"type":"text","value":")."}]},{"type":"admonition","kind":"note","title":"Note","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"link","href":"3/library/textwrap.html#textwrap.TextWrapper.expand_tabs","title":"textwrap.TextWrapper.expand_tabs","children":[{"type":"inline_code","code":"expand_tabs"}]},{"type":"text","value":" is false and "},{"type":"link","href":"3/library/textwrap.html#textwrap.TextWrapper.replace_whitespace","title":"textwrap.TextWrapper.replace_whitespace","children":[{"type":"inline_code","code":"replace_whitespace"}]},{"type":"text","value":" is true, each tab character will be replaced by a single space, which is "},{"type":"emphasis","children":[{"type":"text","value":"not"}]},{"type":"text","value":" the same as tab expansion."}]}]},{"type":"admonition","kind":"note","title":"Note","children":[{"type":"paragraph","children":[{"type":"text","value":"If "},{"type":"link","href":"3/library/textwrap.html#textwrap.TextWrapper.replace_whitespace","title":"textwrap.TextWrapper.replace_whitespace","children":[{"type":"inline_code","code":"replace_whitespace"}]},{"type":"text","value":" is false, newlines may appear in the middle of a line and cause strange output. For this reason, text should be split into paragraphs (using "},{"type":"link","href":"3/library/stdtypes.html#str.splitlines","title":"str.splitlines","children":[{"type":"inline_code","code":"str.splitlines()"}]},{"type":"text","value":" or similar) which are wrapped separately."}]}]}]}]},{"type":"definition_list","items":[{"id":"textwrap.TextWrapper.drop_whitespace","term":[{"type":"text","value":"drop_whitespace"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"(default: "},{"type":"inline_code","code":"True"},{"type":"text","value":") If true, whitespace at the beginning and ending of every line (after wrapping but before indenting) is dropped. Whitespace at the beginning of the paragraph, however, is not dropped if non-whitespace follows it. If whitespace being dropped takes up an entire line, the whole line is dropped."}]}]}]},{"type":"definition_list","items":[{"id":"textwrap.TextWrapper.initial_indent","term":[{"type":"text","value":"initial_indent"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"(default: "},{"type":"inline_code","code":"''"},{"type":"text","value":") String that will be prepended to the first line of wrapped output. Counts towards the length of the first line. The empty string is not indented."}]}]}]},{"type":"definition_list","items":[{"id":"textwrap.TextWrapper.subsequent_indent","term":[{"type":"text","value":"subsequent_indent"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"(default: "},{"type":"inline_code","code":"''"},{"type":"text","value":") String that will be prepended to all lines of wrapped output except the first. Counts towards the length of each line except the first."}]}]}]},{"type":"definition_list","items":[{"id":"textwrap.TextWrapper.fix_sentence_endings","term":[{"type":"text","value":"fix_sentence_endings"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"(default: "},{"type":"inline_code","code":"False"},{"type":"text","value":") If true, "},{"type":"inline_code","code":"TextWrapper"},{"type":"text","value":" attempts to detect sentence endings and ensure that sentences are always separated by exactly two spaces. This is generally desired for text in a monospaced font. However, the sentence detection algorithm is imperfect: it assumes that a sentence ending consists of a lowercase letter followed by one of "},{"type":"inline_code","code":"'.'"},{"type":"text","value":", "},{"type":"inline_code","code":"'!'"},{"type":"text","value":", or "},{"type":"inline_code","code":"'?'"},{"type":"text","value":", possibly followed by one of "},{"type":"inline_code","code":"'\"'"},{"type":"text","value":" or "},{"type":"inline_code","code":"\"'\""},{"type":"text","value":", followed by a space. One problem with this algorithm is that it is unable to detect the difference between “Dr.” in"}]},{"type":"code_block","language":"python","code":"[...] Dr. Frankenstein's monster [...]"},{"type":"paragraph","children":[{"type":"text","value":"and “Spot.” in"}]},{"type":"code_block","language":"python","code":"[...] See Spot. See Spot run [...]"},{"type":"paragraph","children":[{"type":"link","href":"3/library/textwrap.html#textwrap.TextWrapper.fix_sentence_endings","title":"textwrap.TextWrapper.fix_sentence_endings","children":[{"type":"inline_code","code":"fix_sentence_endings"}]},{"type":"text","value":" is false by default."}]},{"type":"paragraph","children":[{"type":"text","value":"Since the sentence detection algorithm relies on "},{"type":"inline_code","code":"string.lowercase"},{"type":"text","value":" for the definition of “lowercase letter”, and a convention of using two spaces after a period to separate sentences on the same line, it is specific to English-language texts."}]}]}]},{"type":"definition_list","items":[{"id":"textwrap.TextWrapper.break_long_words","term":[{"type":"text","value":"break_long_words"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"(default: "},{"type":"inline_code","code":"True"},{"type":"text","value":") If true, then words longer than "},{"type":"link","href":"3/library/textwrap.html#textwrap.TextWrapper.width","title":"textwrap.TextWrapper.width","children":[{"type":"inline_code","code":"width"}]},{"type":"text","value":" will be broken in order to ensure that no lines are longer than "},{"type":"inline_code","code":"width"},{"type":"text","value":". If it is false, long words will not be broken, and some lines may be longer than "},{"type":"inline_code","code":"width"},{"type":"text","value":". (Long words will be put on a line by themselves, in order to minimize the amount by which "},{"type":"inline_code","code":"width"},{"type":"text","value":" is exceeded.)"}]}]}]},{"type":"definition_list","items":[{"id":"textwrap.TextWrapper.break_on_hyphens","term":[{"type":"text","value":"break_on_hyphens"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"(default: "},{"type":"inline_code","code":"True"},{"type":"text","value":") If true, wrapping will occur preferably on whitespaces and right after hyphens in compound words, as it is customary in English. If false, only whitespaces will be considered as potentially good places for line breaks, but you need to set "},{"type":"link","href":"3/library/textwrap.html#textwrap.TextWrapper.break_long_words","title":"textwrap.TextWrapper.break_long_words","children":[{"type":"inline_code","code":"break_long_words"}]},{"type":"text","value":" to false if you want truly insecable words. Default behaviour in previous versions was to always allow breaking hyphenated words."}]}]}]},{"type":"definition_list","items":[{"id":"textwrap.TextWrapper.max_lines","term":[{"type":"text","value":"max_lines"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"(default: "},{"type":"inline_code","code":"None"},{"type":"text","value":") If not "},{"type":"inline_code","code":"None"},{"type":"text","value":", then the output will contain at most "},{"type":"emphasis","children":[{"type":"text","value":"max_lines"}]},{"type":"text","value":" lines, with "},{"type":"emphasis","children":[{"type":"text","value":"placeholder"}]},{"type":"text","value":" appearing at the end of the output."}]},{"type":"paragraph","children":[{"type":"text","value":"Added in version 3.4."}]}]}]},{"type":"definition_list","items":[{"id":"textwrap.TextWrapper.placeholder","term":[{"type":"text","value":"placeholder"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"(default: "},{"type":"inline_code","code":"' [...]'"},{"type":"text","value":") String that will appear at the end of the output text if it has been truncated."}]},{"type":"paragraph","children":[{"type":"text","value":"Added in version 3.4."}]}]}]},{"type":"paragraph","children":[{"type":"inline_code","code":"TextWrapper"},{"type":"text","value":" also provides some public methods, analogous to the module-level convenience functions:"}]},{"type":"definition_list","items":[{"id":"textwrap.TextWrapper.wrap","term":[{"type":"text","value":"wrap("},{"type":"emphasis","children":[{"type":"text","value":"text"}]},{"type":"text","value":")"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Wraps the single paragraph in "},{"type":"emphasis","children":[{"type":"text","value":"text"}]},{"type":"text","value":" (a string) so every line is at most "},{"type":"link","href":"3/library/textwrap.html#textwrap.TextWrapper.width","title":"textwrap.TextWrapper.width","children":[{"type":"inline_code","code":"width"}]},{"type":"text","value":" characters long. All wrapping options are taken from instance attributes of the "},{"type":"inline_code","code":"TextWrapper"},{"type":"text","value":" instance. Returns a list of output lines, without final newlines. If the wrapped output has no content, the returned list is empty."}]}]}]},{"type":"definition_list","items":[{"id":"textwrap.TextWrapper.fill","term":[{"type":"text","value":"fill("},{"type":"emphasis","children":[{"type":"text","value":"text"}]},{"type":"text","value":")"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Wraps the single paragraph in "},{"type":"emphasis","children":[{"type":"text","value":"text"}]},{"type":"text","value":", and returns a single string containing the wrapped paragraph."}]}]}]}]}]}]}}
