n":[{"type":"text","value":"Added in version 3.13."}]}]}]},{"type":"admonition","kind":"seealso","title":"See also","children":[{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"link","href":"https://docs.python.org/3/library/ctypes.html#ctypes-fundamental-data-types","title":null,"children":[{"type":"text","value":"ctypes"}]},{"type":"text","value":" and "},{"type":"link","href":"3/library/struct.html#format-characters","title":null,"children":[{"type":"text","value":"struct"}]},{"type":"text","value":" modules, as well as third-party modules like "},{"type":"link","href":"https://numpy.org/doc/stable/reference/arrays.interface.html#object.__array_interface__","title":null,"children":[{"type":"text","value":"numpy"}]},{"type":"text","value":", use similar – but slightly different – type codes."}]}]},{"type":"paragraph","children":[{"type":"text","value":"The actual representation of values is determined by the machine architecture (strictly speaking, by the C implementation). The actual size can be accessed through the "},{"type":"link","href":"3/library/array.html#array.array.itemsize","title":"array.array.itemsize","children":[{"type":"inline_code","code":"array.itemsize"}]},{"type":"text","value":" attribute."}]},{"type":"paragraph","children":[{"type":"text","value":"The module defines the following item:"}]},{"type":"definition_list","items":[{"id":"array.typecodes","term":[{"type":"text","value":"array.typecodes"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"A string with all available type codes."}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The module defines the following type:"}]},{"type":"definition_list","items":[{"id":"array.array","term":[{"type":"emphasis","children":[{"type":"text","value":"class"},{"type":"text","value":" "}]},{"type":"text","value":"array.array("},{"type":"emphasis","children":[{"type":"text","value":"typecode"}]},{"type":"text","value":"[, "},{"type":"emphasis","ch