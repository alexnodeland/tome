}]},{"type":"paragraph","children":[{"type":"text","value":"Array objects support the ordinary "},{"type":"link","href":"3/library/stdtypes.html#typesseq-mutable","title":null,"children":[{"type":"text","value":"mutable"}]},{"type":"text","value":" "},{"type":"link","href":"https://docs.python.org/3/glossary.html#term-sequence","title":null,"children":[{"type":"text","value":"sequence"}]},{"type":"text","value":" operations of indexing, slicing, concatenation, and multiplication. When using slice assignment, the assigned value must be an array object with the same type code; in all other cases, "},{"type":"link","href":"3/library/exceptions.html#TypeError","title":"TypeError","children":[{"type":"inline_code","code":"TypeError"}]},{"type":"text","value":" is raised. Array objects also implement the buffer interface, and may be used wherever "},{"type":"link","href":"https://docs.python.org/3/glossary.html#term-bytes-like-object","title":null,"children":[{"type":"text","value":"bytes-like objects"}]},{"type":"text","value":" are supported."}]},{"type":"paragraph","children":[{"type":"text","value":"Arrays are "},{"type":"link","href":"https://docs.python.org/3/library/typing.html#generics","title":null,"children":[{"type":"text","value":"generic"}]},{"type":"text","value":" over the type of their contents."}]},{"type":"paragraph","children":[{"type":"text","value":"Raises an "},{"type":"link","href":"https://docs.python.org/3/library/sys.html#auditing","title":null,"children":[{"type":"text","value":"auditing event"}]},{"type":"text","value":" "},{"type":"inline_code","code":"array.__new__"},{"type":"text","value":" with arguments "},{"type":"inline_code","code":"typecode"},{"type":"text","value":", "},{"type":"inline_code","code":"initializer"},{"type":"text","value":"."}]},{"type":"definition_list","items":[{"id":"array.array.typecode","term":[{"type":"text","value":"typecode"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"The typecode char