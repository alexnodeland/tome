xt","value":"Remove the first occurrence of "},{"type":"emphasis","children":[{"type":"text","value":"value"}]},{"type":"text","value":" from the array."}]}]}]},{"type":"definition_list","items":[{"id":"array.array.clear","term":[{"type":"text","value":"clear()"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Remove all elements from the array."}]},{"type":"paragraph","children":[{"type":"text","value":"Added in version 3.13."}]}]}]},{"type":"definition_list","items":[{"id":"array.array.reverse","term":[{"type":"text","value":"reverse()"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Reverse the order of the items in the array."}]}]}]},{"type":"definition_list","items":[{"id":"array.array.tobytes","term":[{"type":"text","value":"tobytes()"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Convert the array to an array of machine values and return the bytes representation (the same sequence of bytes that would be written to a file by the "},{"type":"link","href":"3/library/array.html#array.array.tofile","title":"array.array.tofile","children":[{"type":"inline_code","code":"tofile()"}]},{"type":"text","value":" method.)"}]},{"type":"paragraph","children":[{"type":"text","value":"Added in version 3.2: "},{"type":"inline_code","code":"tostring()"},{"type":"text","value":" is renamed to "},{"type":"inline_code","code":"tobytes()"},{"type":"text","value":" for clarity."}]}]}]},{"type":"definition_list","items":[{"id":"array.array.tofile","term":[{"type":"text","value":"tofile("},{"type":"emphasis","children":[{"type":"text","value":"f"}]},{"type":"text","value":", "},{"type":"emphasis","children":[{"type":"text","value":"/"}]},{"type":"text","value":")"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Write all items (as machine values) to the "},{"type":"link","href":"https://docs.python.org/3/glossary.html#term-file-object","title":null,"children":[{"type":"text","value":"file object"}]},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"f"}]},{"type":"text","value":"."}]}]}]},{"type":"definition_list","items":[{"id":"array.array.tolist","term":[{"type":"text","value":"tolist()"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Convert the array to an ordinary list with the same items."}]}]}]},{"type":"definition_list","items":[{"id":"array.array.tounicode","term":[{"type":"text","value":"tounicode()"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Convert the array to a Unicode string. The array must have a type "},{"type":"inline_code","code":"'u'"},{"type":"text","value":" or "},{"type":"inline_code","code":"'w'"},{"type":"text","value":"; otherwise a "},{"type":"link","href":"3/library/exceptions.html#ValueError","title":"ValueError","children":[{"type":"inline_code","code":"ValueError"}]},{"type":"text","value":" is raised. Use "},{"type":"inline_code","code":"array.tobytes().decode(enc)"},{"type":"text","value":" to obtain a Unicode string from an array of some other type."}]}]}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"The string representation of array objects has the form "},{"type":"inline_code","code":"array(typecode, initializer)"},{"type":"text","value":". The "},{"type":"emphasis","children":[{"type":"text","value":"initializer"}]},{"type":"text","value":" is omitted if the array is empty, otherwise it is a Unicode string if the "},{"type":"emphasis","children":[{"type":"text","value":"typecode"}]},{"type":"text","value":" is "},{"type":"inline_code","code":"'u'"},{"type":"text","value":" or "},{"type":"inline_code","code":"'w'"},{"type":"text","value":", otherwise it is a list of numbers. The string representation is guaranteed to be able to be converted back to an array with the same type and value using "},{"type":"link","href":"3/library/functions.html#eval","title":"eval","children":[{"type":"inline_code","code":"eval()"}]},{"type":"text","value":", so long as the "},{"type":"link","href":"3/library/array.html#array.array","title":"array.array","children":[{"type":"inline_code","code":"array"}]},{"type":"text","value":" class has been imported using "},{"type":"inline_code","code":"from array import array"},{"type":"text","value":". Variables "},{"type":"inline_code","code":"inf"},{"type":"text","value":" and "},{"type":"inline_code","code":"nan"},{"type":"text","value":" must also be defined if it contains corresponding floating-point values. Examples:"}]},{"type":"code_block","language":"python","code":"array('l')\narray('w', 'hello \\u2641')\narray('l', [1, 2, 3, 4, 5])\narray('d', [1.0, 2.0, 3.14, -inf, nan])"},{"type":"admonition","kind":"seealso","title":"See also","children":[{"type":"definition_list","items":[{"id":null,"term":[{"type":"text","value":"Module "},{"type":"link","href":"3/library/struct.html#module-struct","title":"struct: Interpret bytes as packed binary data.","children":[{"type":"inline_code","code":"struct"}]}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Packing and unpacking of heterogeneous binary data."}]}]},{"id":null,"term":[{"type":"link","href":"https://numpy.org/","title":null,"children":[{"type":"text","value":"NumPy"}]}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"The NumPy package defines another array type."}]}]}]}]}]}}
