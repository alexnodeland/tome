{"path":"docs/concepts/containers/container-environment/index.html","title":"Container Environment","description":"This page describes the resources available to Containers in the Container environment.","body":{"type":"document","children":[{"type":"heading","level":1,"id":null,"children":[{"type":"text","value":"Container Environment"}]},{"type":"paragraph","children":[{"type":"text","value":"This page describes the resources available to Containers in the Container environment."}]},{"type":"heading","level":2,"id":"container-environment","children":[{"type":"text","value":"Container environment"},{"type":"link","href":"docs/concepts/containers/container-environment/index.html#container-environment","title":null,"children":[]}]},{"type":"paragraph","children":[{"type":"text","value":"The Kubernetes Container environment provides several important resources to Containers:"}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"text","value":"A filesystem, which is a combination of an "},{"type":"link","href":"docs/concepts/containers/images/index.html","title":null,"children":[{"type":"text","value":"image"}]},{"type":"text","value":" and one or more "},{"type":"link","href":"https://kubernetes.io/docs/concepts/storage/volumes/","title":null,"children":[{"type":"text","value":"volumes"}]},{"type":"text","value":"."}]},{"children":[{"type":"text","value":"Information about the Container itself."}]},{"children":[{"type":"text","value":"Information about other objects in the cluster."}]}]},{"type":"heading","level":3,"id":"container-information","children":[{"type":"text","value":"Container information"},{"type":"link","href":"docs/concepts/containers/container-environment/index.html#container-information","title":null,"children":[]}]},{"type":"paragraph","children":[{"type":"text","value":"The "},{"type":"emphasis","children":[{"type":"text","value":"hostname"}]},{"type":"text","value":" of a Container is the name of the Pod in which the Container is running. It is available through the "},{"type":"inline_code","code":"hostname"},{"type":"text","value":" command or the "},{"type":"link","href":"https://man7.org/linux/man-pages/man2/gethostname.2.html","title":null,"children":[{"type":"inline_code","code":"gethostname"}]},{"type":"text","value":" function call in libc."}]},{"type":"paragraph","children":[{"type":"text","value":"The Pod name and namespace are available as environment variables through the "},{"type":"link","href":"https://kubernetes.io/docs/tasks/inject-data-application/downward-api-volume-expose-pod-information/","title":null,"children":[{"type":"text","value":"downward API"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"User-defined environment variables from the Pod definition are also available to the Container, as are any environment variables specified statically in the container image."}]},{"type":"heading","level":3,"id":"cluster-information","children":[{"type":"text","value":"Cluster information"},{"type":"link","href":"docs/concepts/containers/container-environment/index.html#cluster-information","title":null,"children":[]}]},{"type":"paragraph","children":[{"type":"text","value":"A list of all services that were running when a Container was created is available to that Container as environment variables. This list is limited to services within the same namespace as the new Container's Pod and Kubernetes control plane services."}]},{"type":"paragraph","children":[{"type":"text","value":"For a service named "},{"type":"emphasis","children":[{"type":"text","value":"foo"}]},{"type":"text","value":" that exposes a set of Pods, each running a container named "},{"type":"emphasis","children":[{"type":"text","value":"bar"}]},{"type":"text","value":", the following variables are defined:"}]},{"type":"code_block","language":"bash","code":"FOO_SERVICE_HOST=<the host the service is running on>\nFOO_SERVICE_PORT=<the port the service is running on>"},{"type":"paragraph","children":[{"type":"text","value":"Services have dedicated IP addresses and are available to the Container via DNS, if "},{"type":"link","href":"https://releases.k8s.io/v1.36.0/cluster/addons/dns/","title":null,"children":[{"type":"text","value":"DNS addon"}]},{"type":"text","value":" is enabled."}]},{"type":"heading","level":2,"id":"what-s-next","children":[{"type":"text","value":"What's next"},{"type":"link","href":"docs/concepts/containers/container-environment/index.html#what-s-next","title":null,"children":[]}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"text","value":"Learn more about "},{"type":"link","href":"https://kubernetes.io/docs/concepts/containers/container-lifecycle-hooks/","title":null,"children":[{"type":"text","value":"Container lifecycle hooks"}]},{"type":"text","value":"."}]},{"children":[{"type":"text","value":"Get hands-on experience "},{"type":"link","href":"https://kubernetes.io/docs/tasks/configure-pod-container/attach-handler-lifecycle-event/","title":null,"children":[{"type":"text","value":"attaching handlers to Container lifecycle events"}]},{"type":"text","value":"."}]}]}]}}
