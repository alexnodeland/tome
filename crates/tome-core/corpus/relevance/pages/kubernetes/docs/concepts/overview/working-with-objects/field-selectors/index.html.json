e_code","code":"status.replicas"}]}]},{"cells":[{"children":[{"type":"text","value":"Job"}]},{"children":[{"type":"inline_code","code":"status.successful"}]}]},{"cells":[{"children":[{"type":"text","value":"Node"}]},{"children":[{"type":"inline_code","code":"spec.unschedulable"}]}]},{"cells":[{"children":[{"type":"text","value":"CertificateSigningRequest"}]},{"children":[{"type":"inline_code","code":"spec.signerName"}]}]}]},{"type":"heading","level":3,"id":"custom-resources-fields","children":[{"type":"text","value":"Custom resources fields"},{"type":"link","href":"docs/concepts/overview/working-with-objects/field-selectors/index.html#custom-resources-fields","title":null,"children":[]}]},{"type":"paragraph","children":[{"type":"text","value":"All custom resource types support the "},{"type":"inline_code","code":"metadata.name"},{"type":"text","value":" and "},{"type":"inline_code","code":"metadata.namespace"},{"type":"text","value":" fields."}]},{"type":"paragraph","children":[{"type":"text","value":"Additionally, the "},{"type":"inline_code","code":"spec.versions[*].selectableFields"},{"type":"text","value":" field of a "},{"type":"link","href":"https://kubernetes.io/docs/tasks/extend-kubernetes/custom-resources/custom-resource-definitions/","title":"Custom code that defines a resource to add to your Kubernetes API server without building a complete custom server.","children":[{"type":"text","value":"CustomResourceDefinition"}]},{"type":"text","value":" declares which other fields in a custom resource may be used in field selectors. See "},{"type":"link","href":"https://kubernetes.io/docs/tasks/extend-kubernetes/custom-resources/custom-resource-definitions/#crd-selectable-fields","title":null,"children":[{"type":"text","value":"selectable fields for custom resources"}]},{"type":"text","value":" for more information about how to use field selectors with CustomResourceDefinitions."}]},{"type":"heading","level":2,"id":"supported-operators","children":[{"type":"text","value":"Supported operators"},{"type":"link","href":"docs/concepts/overview/working-with-objects/field-selectors/index.html#supported-operators","title":null,"children":[]}]},{"type":"paragraph","children":[{"type":"text","value":"You can use the "},{"type":"inline_code","code":"="},{"type":"text","value":", "},{"type":"inline_code","code":"=="},{"type":"text","value":", and "},{"type":"inline_code","code":"!="},{"type":"text","value":" operators with field selectors ("},{"type":"inline_code","code":"="},{"type":"text","value":" and "},{"type":"inline_code","code":"=="},{"type":"text","value":" mean the same thing). This "},{"type":"inline_code","code":"kubectl"},{"type":"text","value":" command, for example, selects all Kubernetes Services that aren't in the "},{"type":"inline_code","code":"default"},{"type":"text","value":" namespace:"}]},{"type":"code_block","language":"bash","code":"kubectl get services  --all-namespaces --field-selector metadata.namespace!=default"},{"type":"heading","level":4,"id":null,"children":[{"type":"text","value":"Note:"}]},{"type":"link","href":"docs/concepts/overview/working-with-objects/labels/index.html#set-based-requirement","title":null,"children":[{"type":"text","value":"Set-based operators"}]},{"type":"text","value":" ("},{"type":"inline_code","code":"in"},{"type":"text","value":", "},{"type":"inline_code","code":"notin"},{"type":"text","value":", "},{"type":"inline_code","code":"exists"},{"type":"text","value":") are not supported for field selectors."},{"type":"heading","level":2,"id":"chained-selectors","children":[{"type":"text","value":"Chained selectors"},{"type":"link","href":"docs/concepts/overview/working-with-objects/field-selectors/index.html#chained-selectors","title":null,"children":[]}]},{"type":"paragraph","children":[{"type":"text","value":"As with "},{"type":"link","href":"docs/concepts/overview/working-with-objects/labels/index.html","title":null,"children":[{"type":"text","value":"label"}]},{"type":"text","value":" and other selectors, field selectors can be chained together as a comma-separated list. This "},{"type":"inline_code","code":"kubectl"},{"type":"text","value":" command selects all Pods for which the "},{"type":"inline_code","code":"status.phase"},{"type":"text","value":" does not equal "},{"type":"inline_code","code":"Running"},{"type":"text","value":" and the "},{"type":"inline_code","code":"spec.restartPolicy"},{"type":"text","value":" field equals "},{"type":"inline_code","code":"Always"},{"type":"text","value":":"}]},{"type":"code_block","language":"bash","code":"kubectl get pods --field-selector=status.phase!=Running,spec.restartPolicy=Always"},{"type":"heading","level":2,"id":"multiple-resource-types","children":[{"type":"text","value":"Multiple resource types"},{"type":"link","href":"docs/concepts/overview/working-with-objects/field-selectors/index.html#multiple-resource-types","title":null,"children":[]}]},{"type":"paragraph","children":[{"type":"text","value":"You can use field selectors across multiple resource types. This "},{"type":"inline_code","code":"kubectl"},{"type":"text","value":" command selects all Statefulsets and Services that are not in the "},{"type":"inline_code","code":"default"},{"type":"text","value":" namespace:"}]},{"type":"code_block","language":"bash","code":"kubectl get statefulsets,services --all-namespaces --field-selector metadata.namespace!=default"}]}}
