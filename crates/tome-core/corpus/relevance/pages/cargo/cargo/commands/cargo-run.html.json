{"path":"cargo/commands/cargo-run.html","title":"cargo-run(1)","description":"cargo-run — Run the current package","body":{"type":"document","children":[{"type":"heading","level":1,"id":"cargo-run1","children":[{"type":"text","value":"cargo-run(1)"}]},{"type":"heading","level":2,"id":"name","children":[{"type":"text","value":"NAME"}]},{"type":"paragraph","children":[{"type":"text","value":"cargo-run — Run the current package"}]},{"type":"heading","level":2,"id":"synopsis","children":[{"type":"text","value":"SYNOPSIS"}]},{"type":"paragraph","children":[{"type":"inline_code","code":"cargo run"},{"type":"text","value":" ["},{"type":"emphasis","children":[{"type":"text","value":"options"}]},{"type":"text","value":"] ["},{"type":"inline_code","code":"--"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"args"}]},{"type":"text","value":"]"}]},{"type":"heading","level":2,"id":"description","children":[{"type":"text","value":"DESCRIPTION"}]},{"type":"paragraph","children":[{"type":"text","value":"Run a binary or example of the local package."}]},{"type":"paragraph","children":[{"type":"text","value":"All the arguments following the two dashes ("},{"type":"inline_code","code":"--"},{"type":"text","value":") are passed to the binary to run. If you’re passing arguments to both Cargo and the binary, the ones after "},{"type":"inline_code","code":"--"},{"type":"text","value":" go to the binary, the ones before go to Cargo."}]},{"type":"paragraph","children":[{"type":"text","value":"Unlike "},{"type":"link","href":"cargo/commands/cargo-test.html","title":null,"children":[{"type":"text","value":"cargo-test(1)"}]},{"type":"text","value":" and "},{"type":"link","href":"https://doc.rust-lang.org/cargo/commands/cargo-bench.html","title":null,"children":[{"type":"text","value":"cargo-bench(1)"}]},{"type":"text","value":", "},{"type":"inline_code","code":"cargo run"},{"type":"text","value":" sets the working directory of the binary executed to the current working directory, same as if it was executed in the shell directly."}]},{"type":"heading","level":2,"id":"options","children":[{"type":"text","value":"OPTIONS"}]},{"type":"heading","level":3,"id":"package-selection","children":[{"type":"text","value":"Package Selection"}]},{"type":"paragraph","children":[{"type":"text","value":"By default, the package in the current working directory is selected. The "},{"type":"inline_code","code":"-p"},{"type":"text","value":" flag can be used to choose a different package in a workspace."}]},{"type":"definition_list","items":[{"id":"option-cargo-run--p","term":[{"type":"inline_code","code":"-p"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"spec"}]}],"definition":[]},{"id":"option-cargo-run---package","term":[{"type":"inline_code","code":"--package"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"spec"}]}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"The package to run. See "},{"type":"link","href":"https://doc.rust-lang.org/cargo/commands/cargo-pkgid.html","title":null,"children":[{"type":"text","value":"cargo-pkgid(1)"}]},{"type":"text","value":" for the SPEC format."}]}]}]},{"type":"heading","level":3,"id":"target-selection","children":[{"type":"text","value":"Target Selection"}]},{"type":"paragraph","children":[{"type":"text","value":"When no target selection options are given, "},{"type":"inline_code","code":"cargo run"},{"type":"text","value":" will run the binary target. If there are multiple binary targets, you must pass a target flag to choose one. Or, the "},{"type":"inline_code","code":"default-run"},{"type":"text","value":" field may be specified in the "},{"type":"inline_code","code":"[package]"},{"type":"text","value":" section of "},{"type":"inline_code","code":"Cargo.toml"},{"type":"text","value":" to choose the name of the binary to run by default."}]},{"type":"definition_list","items":[{"id":"option-cargo-run---bin","term":[{"type":"inline_code","code":"--bin"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"name"}]}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Run the specified binary."}]}]},{"id":"option-cargo-run---example","term":[{"type":"inline_code","code":"--example"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"name"}]}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Run the specified example."}]}]}]},{"type":"heading","level":3,"id":"feature-selection","children":[{"type":"text","value":"Feature Selection"}]},{"type":"paragraph","children":[{"type":"text","value":"The feature flags allow you to control which features are enabled. When no feature options are given, the "},{"type":"inline_code","code":"default"},{"type":"text","value":" feature is activated for every selected package."}]},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"https://doc.rust-lang.org/cargo/reference/features.html#command-line-feature-options","title":null,"children":[{"type":"text","value":"the features documentation"}]},{"type":"text","value":" for more details."}]},{"type":"definition_list","items":[{"id":"option-cargo-run--F","term":[{"type":"inline_code","code":"-F"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"features"}]}],"definition":[]},{"id":"option-cargo-run---features","term":[{"type":"inline_code","code":"--features"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"features"}]}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Space or comma separated list of features to activate. Features of workspace members may be enabled with "},{"type":"inline_code","code":"package-name/feature-name"},{"type":"text","value":" syntax. This flag may be specified multiple times, which enables all specified features."}]}]},{"id":"option-cargo-run---all-features","term":[{"type":"inline_code","code":"--all-features"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Activate all available features of all selected packages."}]}]},{"id":"option-cargo-run---no-default-features","term":[{"type":"inline_code","code":"--no-default-features"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Do not activate the "},{"type":"inline_code","code":"default"},{"type":"text","value":" feature of the selected packages."}]}]}]},{"type":"heading","level":3,"id":"compilation-options","children":[{"type":"text","value":"Compilation Options"}]},{"type":"definition_list","items":[{"id":"option-cargo-run---target","term":[{"type":"inline_code","code":"--target"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"triple"}]}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Run for the specified target architecture. The default is the host architecture. The general format of the triple is "},{"type":"inline_code","code":"<arch><sub>-<vendor>-<sys>-<abi>"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Possible values:"}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"text","value":"Any supported target in "},{"type":"inline_code","code":"rustc --print target-list"},{"type":"text","value":"."}]},{"children":[{"type":"inline_code","code":"\"host-tuple\""},{"type":"text","value":", which will internally be substituted by the host’s target. This can be particularly useful if you’re cross-compiling some crates, and don’t want to specify your host’s machine as a target (for instance, an "},{"type":"inline_code","code":"xtask"},{"type":"text","value":" in a shared project that may be worked on by many hosts)."}]},{"children":[{"type":"text","value":"A path to a custom target specification. See "},{"type":"link","href":"https://doc.rust-lang.org/rustc/targets/custom.html#custom-target-lookup-path","title":null,"children":[{"type":"text","value":"Custom Target Lookup Path"}]},{"type":"text","value":" for more information."}]}]},{"type":"paragraph","children":[{"type":"text","value":"This may also be specified with the "},{"type":"inline_code","code":"build.target"},{"type":"text","value":" "},{"type":"link","href":"https://doc.rust-lang.org/cargo/reference/config.html","title":null,"children":[{"type":"text","value":"config value"}]},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"Note that specifying this flag makes Cargo run in a different mode where the target artifacts are placed in a separate directory. See the "},{"type":"link","href":"https://doc.rust-lang.org/cargo/reference/build-cache.html","title":null,"children":[{"type":"text","value":"build cache"}]},{"type":"text","value":" documentation for more details."}]}]},{"id":"option-cargo-run--r","term":[{"type":"inline_code","code":"-r"}],"definition":[]},{"id":"option-cargo-run---release","term":[{"type":"inline_code","code":"--release"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Run optimized artifacts with the "},{"type":"inline_code","code":"release"},{"type":"text","value":" profile. See also the "},{"type":"inline_code","code":"--profile"},{"type":"text","value":" option for choosing a specific profile by name."}]}]},{"id":"option-cargo-run---profile","term":[{"type":"inline_code","code":"--profile"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"name"}]}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Run with the given profile. See "},{"type":"link","href":"https://doc.rust-lang.org/cargo/reference/profiles.html","title":null,"children":[{"type":"text","value":"the reference"}]},{"type":"text","value":" for more details on profiles."}]}]},{"id":"option-cargo-run---timings","term":[{"type":"inline_code","code":"--timings"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Output information how long each compilation takes, and track concurrency information over time."}]},{"type":"paragraph","children":[{"type":"text","value":"A file "},{"type":"inline_code","code":"cargo-timing.html"},{"type":"text","value":" will be written to the "},{"type":"inline_code","code":"target/cargo-timings"},{"type":"text","value":" directory at the end of the build. An additional report with a timestamp in its filename is also written if you want to look at a previous run. These reports are suitable for human consumption only, and do not provide machine-readable timing data."}]}]}]},{"type":"heading","level":3,"id":"output-options","children":[{"type":"text","value":"Output Options"}]},{"type":"definition_list","items":[{"id":"option-cargo-run---target-dir","term":[{"type":"inline_code","code":"--target-dir"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"directory"}]}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Directory for all generated artifacts and intermediate files. May also be specified with the "},{"type":"inline_code","code":"CARGO_TARGET_DIR"},{"type":"text","value":" environment variable, or the "},{"type":"inline_code","code":"build.target-dir"},{"type":"text","value":" "},{"type":"link","href":"https://doc.rust-lang.org/cargo/reference/config.html","title":null,"children":[{"type":"text","value":"config value"}]},{"type":"text","value":". Defaults to "},{"type":"inline_code","code":"target"},{"type":"text","value":" in the root of the workspace."}]}]}]},{"type":"heading","level":3,"id":"display-options","children":[{"type":"text","value":"Display Options"}]},{"type":"definition_list","items":[{"id":"option-cargo-run--v","term":[{"type":"inline_code","code":"-v"}],"definition":[]},{"id":"option-cargo-run---verbose","term":[{"type":"inline_code","code":"--verbose"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Use verbose output. May be specified twice for “very verbose” output which includes extra output such as dependency warnings and build script output. May also be specified with the "},{"type":"inline_code","code":"term.verbose"},{"type":"text","value":" "},{"type":"link","href":"https://doc.rust-lang.org/cargo/reference/config.html","title":null,"children":[{"type":"text","value":"config value"}]},{"type":"text","value":"."}]}]},{"id":"option-cargo-run--q","term":[{"type":"inline_code","code":"-q"}],"definition":[]},{"id":"option-cargo-run---quiet","term":[{"type":"inline_code","code":"--quiet"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Do not print cargo log messages. May also be specified with the "},{"type":"inline_code","code":"term.quiet"},{"type":"text","value":" "},{"type":"link","href":"https://doc.rust-lang.org/cargo/reference/config.html","title":null,"children":[{"type":"text","value":"config value"}]},{"type":"text","value":"."}]}]},{"id":"option-cargo-run---color","term":[{"type":"inline_code","code":"--color"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"when"}]}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Control when colored output is used. Valid values:"}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"inline_code","code":"auto"},{"type":"text","value":" (default): Automatically detect if color support is available on the terminal."}]},{"children":[{"type":"inline_code","code":"always"},{"type":"text","value":": Always display colors."}]},{"children":[{"type":"inline_code","code":"never"},{"type":"text","value":": Never display colors."}]}]},{"type":"paragraph","children":[{"type":"text","value":"May also be specified with the "},{"type":"inline_code","code":"term.color"},{"type":"text","value":" "},{"type":"link","href":"https://doc.rust-lang.org/cargo/reference/config.html","title":null,"children":[{"type":"text","value":"config value"}]},{"type":"text","value":"."}]}]},{"id":"option-cargo-run---message-format","term":[{"type":"inline_code","code":"--message-format"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"fmt"}]}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"The output format for diagnostic messages. Can be specified multiple times and consists of comma-separated values. Valid values:"}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"inline_code","code":"human"},{"type":"text","value":" (default): Display in a human-readable text format. Conflicts with "},{"type":"inline_code","code":"short"},{"type":"text","value":" and "},{"type":"inline_code","code":"json"},{"type":"text","value":"."}]},{"children":[{"type":"inline_code","code":"short"},{"type":"text","value":": Emit shorter, human-readable text messages. Conflicts with "},{"type":"inline_code","code":"human"},{"type":"text","value":" and "},{"type":"inline_code","code":"json"},{"type":"text","value":"."}]},{"children":[{"type":"inline_code","code":"json"},{"type":"text","value":": Emit JSON messages to stdout. See "},{"type":"link","href":"https://doc.rust-lang.org/cargo/reference/external-tools.html#json-messages","title":null,"children":[{"type":"text","value":"the reference"}]},{"type":"text","value":" for more details. Conflicts with "},{"type":"inline_code","code":"human"},{"type":"text","value":" and "},{"type":"inline_code","code":"short"},{"type":"text","value":"."}]},{"children":[{"type":"inline_code","code":"json-diagnostic-short"},{"type":"text","value":": Ensure the "},{"type":"inline_code","code":"rendered"},{"type":"text","value":" field of JSON messages contains the “short” rendering from rustc. Cannot be used with "},{"type":"inline_code","code":"human"},{"type":"text","value":" or "},{"type":"inline_code","code":"short"},{"type":"text","value":"."}]},{"children":[{"type":"inline_code","code":"json-diagnostic-rendered-ansi"},{"type":"text","value":": Ensure the "},{"type":"inline_code","code":"rendered"},{"type":"text","value":" field of JSON messages contains embedded ANSI color codes for respecting rustc’s default color scheme. Cannot be used with "},{"type":"inline_code","code":"human"},{"type":"text","value":" or "},{"type":"inline_code","code":"short"},{"type":"text","value":"."}]},{"children":[{"type":"inline_code","code":"json-render-diagnostics"},{"type":"text","value":": Instruct Cargo to not include rustc diagnostics in JSON messages printed, but instead Cargo itself should render the JSON diagnostics coming from rustc. Cargo’s own JSON diagnostics and others coming from rustc are still emitted. Cannot be used with "},{"type":"inline_code","code":"human"},{"type":"text","value":" or "},{"type":"inline_code","code":"short"},{"type":"text","value":"."}]}]}]}]},{"type":"heading","level":3,"id":"manifest-options","children":[{"type":"text","value":"Manifest Options"}]},{"type":"definition_list","items":[{"id":"option-cargo-run---manifest-path","term":[{"type":"inline_code","code":"--manifest-path"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"path"}]}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Path to the "},{"type":"inline_code","code":"Cargo.toml"},{"type":"text","value":" file. By default, Cargo searches for the "},{"type":"inline_code","code":"Cargo.toml"},{"type":"text","value":" file in the current directory or any parent directory."}]}]},{"id":"option-cargo-run---ignore-rust-version","term":[{"type":"inline_code","code":"--ignore-rust-version"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Ignore "},{"type":"inline_code","code":"rust-version"},{"type":"text","value":" specification in packages."}]}]},{"id":"option-cargo-run---locked","term":[{"type":"inline_code","code":"--locked"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Asserts that the exact same dependencies and versions are used as when the existing "},{"type":"inline_code","code":"Cargo.lock"},{"type":"text","value":" file was originally generated. Cargo will exit with an error when either of the following scenarios arises:"}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"text","value":"The lock file is missing."}]},{"children":[{"type":"text","value":"Cargo attempted to change the lock file due to a different dependency resolution."}]}]},{"type":"paragraph","children":[{"type":"text","value":"It may be used in environments where deterministic builds are desired, such as in CI pipelines."}]}]},{"id":"option-cargo-run---offline","term":[{"type":"inline_code","code":"--offline"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Prevents Cargo from accessing the network for any reason. Without this flag, Cargo will stop with an error if it needs to access the network and the network is not available. With this flag, Cargo will attempt to proceed without the network if possible."}]},{"type":"paragraph","children":[{"type":"text","value":"Beware that this may result in different dependency resolution than online mode. Cargo will restrict itself to crates that are downloaded locally, even if there might be a newer version as indicated in the local copy of the index. See the "},{"type":"link","href":"https://doc.rust-lang.org/cargo/commands/cargo-fetch.html","title":null,"children":[{"type":"text","value":"cargo-fetch(1)"}]},{"type":"text","value":" command to download dependencies before going offline."}]},{"type":"paragraph","children":[{"type":"text","value":"May also be specified with the "},{"type":"inline_code","code":"net.offline"},{"type":"text","value":" "},{"type":"link","href":"https://doc.rust-lang.org/cargo/reference/config.html","title":null,"children":[{"type":"text","value":"config value"}]},{"type":"text","value":"."}]}]},{"id":"option-cargo-run---frozen","term":[{"type":"inline_code","code":"--frozen"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Equivalent to specifying both "},{"type":"inline_code","code":"--locked"},{"type":"text","value":" and "},{"type":"inline_code","code":"--offline"},{"type":"text","value":"."}]}]}]},{"type":"heading","level":3,"id":"common-options","children":[{"type":"text","value":"Common Options"}]},{"type":"definition_list","items":[{"id":"option-cargo-run-+toolchain","term":[{"type":"inline_code","code":"+"},{"type":"emphasis","children":[{"type":"text","value":"toolchain"}]}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"If Cargo has been installed with rustup, and the first argument to "},{"type":"inline_code","code":"cargo"},{"type":"text","value":" begins with "},{"type":"inline_code","code":"+"},{"type":"text","value":", it will be interpreted as a rustup toolchain name (such as "},{"type":"inline_code","code":"+stable"},{"type":"text","value":" or "},{"type":"inline_code","code":"+nightly"},{"type":"text","value":"). See the "},{"type":"link","href":"https://rust-lang.github.io/rustup/overrides.html","title":null,"children":[{"type":"text","value":"rustup documentation"}]},{"type":"text","value":" for more information about how toolchain overrides work."}]}]},{"id":"option-cargo-run---config","term":[{"type":"inline_code","code":"--config"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"KEY=VALUE"}]},{"type":"text","value":" or "},{"type":"emphasis","children":[{"type":"text","value":"PATH"}]}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Overrides a Cargo configuration value. The argument should be in TOML syntax of "},{"type":"inline_code","code":"KEY=VALUE"},{"type":"text","value":", or provided as a path to an extra configuration file. This flag may be specified multiple times. See the "},{"type":"link","href":"https://doc.rust-lang.org/cargo/reference/config.html#command-line-overrides","title":null,"children":[{"type":"text","value":"command-line overrides section"}]},{"type":"text","value":" for more information."}]}]},{"id":"option-cargo-run--C","term":[{"type":"inline_code","code":"-C"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"PATH"}]}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Changes the current working directory before executing any specified operations. This affects things like where cargo looks by default for the project manifest ("},{"type":"inline_code","code":"Cargo.toml"},{"type":"text","value":"), as well as the directories searched for discovering "},{"type":"inline_code","code":".cargo/config.toml"},{"type":"text","value":", for example. This option must appear before the command name, for example "},{"type":"inline_code","code":"cargo -C path/to/my-project build"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"This option is only available on the "},{"type":"link","href":"https://doc.rust-lang.org/book/appendix-07-nightly-rust.html","title":null,"children":[{"type":"text","value":"nightly channel"}]},{"type":"text","value":" and requires the "},{"type":"inline_code","code":"-Z unstable-options"},{"type":"text","value":" flag to enable (see "},{"type":"link","href":"https://github.com/rust-lang/cargo/issues/10098","title":null,"children":[{"type":"text","value":"#10098"}]},{"type":"text","value":")."}]}]},{"id":"option-cargo-run--h","term":[{"type":"inline_code","code":"-h"}],"definition":[]},{"id":"option-cargo-run---help","term":[{"type":"inline_code","code":"--help"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Prints help information."}]}]},{"id":"option-cargo-run--Z","term":[{"type":"inline_code","code":"-Z"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"flag"}]}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Unstable (nightly-only) flags to Cargo. Run "},{"type":"inline_code","code":"cargo -Z help"},{"type":"text","value":" for details."}]}]}]},{"type":"heading","level":3,"id":"miscellaneous-options","children":[{"type":"text","value":"Miscellaneous Options"}]},{"type":"definition_list","items":[{"id":"option-cargo-run--j","term":[{"type":"inline_code","code":"-j"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"N"}]}],"definition":[]},{"id":"option-cargo-run---jobs","term":[{"type":"inline_code","code":"--jobs"},{"type":"text","value":" "},{"type":"emphasis","children":[{"type":"text","value":"N"}]}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Number of parallel jobs to run. May also be specified with the "},{"type":"inline_code","code":"build.jobs"},{"type":"text","value":" "},{"type":"link","href":"https://doc.rust-lang.org/cargo/reference/config.html","title":null,"children":[{"type":"text","value":"config value"}]},{"type":"text","value":". Defaults to the number of logical CPUs. If negative, it sets the maximum number of parallel jobs to the number of logical CPUs plus provided value. If a string "},{"type":"inline_code","code":"default"},{"type":"text","value":" is provided, it sets the value back to defaults. Should not be 0."}]}]},{"id":"option-cargo-run---keep-going","term":[{"type":"inline_code","code":"--keep-going"}],"definition":[{"type":"paragraph","children":[{"type":"text","value":"Build as many crates in the dependency graph as possible, rather than aborting the build on the first one that fails to build."}]},{"type":"paragraph","children":[{"type":"text","value":"For example if the current package depends on dependencies "},{"type":"inline_code","code":"fails"},{"type":"text","value":" and "},{"type":"inline_code","code":"works"},{"type":"text","value":", one of which fails to build, "},{"type":"inline_code","code":"cargo run -j1"},{"type":"text","value":" may or may not build the one that succeeds (depending on which one of the two builds Cargo picked to run first), whereas "},{"type":"inline_code","code":"cargo run -j1 --keep-going"},{"type":"text","value":" would definitely run both builds, even if the one run first fails."}]}]}]},{"type":"heading","level":2,"id":"environment","children":[{"type":"text","value":"ENVIRONMENT"}]},{"type":"paragraph","children":[{"type":"text","value":"See "},{"type":"link","href":"https://doc.rust-lang.org/cargo/reference/environment-variables.html","title":null,"children":[{"type":"text","value":"the reference"}]},{"type":"text","value":" for details on environment variables that Cargo reads."}]},{"type":"heading","level":2,"id":"exit-status","children":[{"type":"text","value":"EXIT STATUS"}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"inline_code","code":"0"},{"type":"text","value":": Cargo succeeded."}]},{"children":[{"type":"inline_code","code":"101"},{"type":"text","value":": Cargo failed to complete."}]}]},{"type":"heading","level":2,"id":"examples","children":[{"type":"text","value":"EXAMPLES"}]},{"type":"list","ordered":true,"start":null,"items":[{"children":[{"type":"paragraph","children":[{"type":"text","value":"Build the local package and run its main target (assuming only one binary):"}]},{"type":"code_block","language":null,"code":"cargo run"}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"Run an example with extra arguments:"}]},{"type":"code_block","language":null,"code":"cargo run --example exname -- --exoption exarg1 exarg2"}]}]},{"type":"heading","level":2,"id":"see-also","children":[{"type":"text","value":"SEE ALSO"}]},{"type":"paragraph","children":[{"type":"link","href":"https://doc.rust-lang.org/cargo/commands/cargo.html","title":null,"children":[{"type":"text","value":"cargo(1)"}]},{"type":"text","value":", "},{"type":"link","href":"cargo/commands/cargo-build.html","title":null,"children":[{"type":"text","value":"cargo-build(1)"}]}]}]}}
