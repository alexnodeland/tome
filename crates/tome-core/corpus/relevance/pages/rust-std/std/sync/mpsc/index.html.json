},{"type":"text","value":" could not return data when called. This can occur with both a "},{"type":"link","href":"https://doc.rust-lang.org/std/sync/mpsc/fn.channel.html","title":"fn std::sync::mpsc::channel","children":[{"type":"inline_code","code":"channel"}]},{"type":"text","value":" and a "},{"type":"link","href":"https://doc.rust-lang.org/std/sync/mpsc/fn.sync_channel.html","title":"fn std::sync::mpsc::sync_channel","children":[{"type":"inline_code","code":"sync_channel"}]},{"type":"text","value":"."}]},{"id":null,"term":[{"type":"link","href":"https://doc.rust-lang.org/std/sync/mpsc/enum.TrySendError.html","title":"enum std::sync::mpsc::TrySendError","children":[{"type":"text","value":"TrySendError"}]}],"definition":[{"type":"text","value":"This enumeration is the list of the possible error outcomes for the "},{"type":"link","href":"https://doc.rust-lang.org/std/sync/mpsc/struct.SyncSender.html#method.try_send","title":"method std::sync::mpsc::SyncSender::try_send","children":[{"type":"inline_code","code":"try_send"}]},{"type":"text","value":" method."}]}]},{"type":"heading","level":2,"id":"functions","children":[{"type":"text","value":"Functions"}]},{"type":"definition_list","items":[{"id":null,"term":[{"type":"link","href":"https://doc.rust-lang.org/std/sync/mpsc/fn.channel.html","title":"fn std::sync::mpsc::channel","children":[{"type":"text","value":"channel"}]}],"definition":[{"type":"text","value":"Creates a new asynchronous channel, returning the sender/receiver halves."}]},{"id":null,"term":[{"type":"link","href":"https://doc.rust-lang.org/std/sync/mpsc/fn.sync_channel.html","title":"fn std::sync::mpsc::sync_channel","children":[{"type":"text","value":"sync_channel"}]}],"definition":[{"type":"text","value":"Creates a new synchronous, bounded channel."}]}]}]}}
