Release"}]},{"type":"text","value":" ordering semantics synchronizes with an atomic operation with (at least) "},{"type":"link","href":"https://doc.rust-lang.org/std/sync/atomic/enum.Ordering.html#variant.Acquire","title":"variant std::sync::atomic::Ordering::Acquire","children":[{"type":"inline_code","code":"Acquire"}]},{"type":"text","value":" ordering semantics."}]},{"children":[{"type":"text","value":"fence - fence synchronization: a fence with (at least) "},{"type":"link","href":"https://doc.rust-lang.org/std/sync/atomic/enum.Ordering.html#variant.Release","title":"variant std::sync::atomic::Ordering::Release","children":[{"type":"inline_code","code":"Release"}]},{"type":"text","value":" ordering semantics synchronizes with a fence with (at least) "},{"type":"link","href":"https://doc.rust-lang.org/std/sync/atomic/enum.Ordering.html#variant.Acquire","title":"variant std::sync::atomic::Ordering::Acquire","children":[{"type":"inline_code","code":"Acquire"}]},{"type":"text","value":" ordering semantics."}]}]},{"type":"paragraph","children":[{"type":"text","value":"These 3 ways complement the regular, fence-less, atomic - atomic synchronization."}]},{"type":"heading","level":3,"id":"atomic---fence","children":[{"type":"text","value":"Atomic - Fence"}]},{"type":"paragraph","children":[{"type":"text","value":"An atomic operation on one thread will synchronize with a fence on another thread when:"}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"paragraph","children":[{"type":"text","value":"on thread 1:"}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"text","value":"an atomic operation ‘X’ with (at least) "},{"type":"link","href":"https://doc.rust-lang.org/std/sync/atomic/enum.Ordering.html#variant.Release","title":"variant std::sync::atomic::Ordering::Release","children":[{"type":"inline_code","code":"Release"}]},{"type":"text","value":" ordering semantics on some atomic object ‘m’,"}]}]}]},{"children":[{"type":"paragraph","children":[{"type":"text","value":"is paired on thread 2 with:"}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"text","value":"an atomic read ‘Y’ with any order on ‘m’,"}]},{"children":[{"type":"text","value":"followed by a fence ‘B’ with (at least) "},{"type":"link","href":"https://doc.rust-lang.org/std/sync/atomic/enum.Ordering.html#variant.Acquire","title":"variant std::sync::atomic::Ordering::Acquire","children":[{"type":"inline_code","code":"Acquire"}]},{"type":"text","value":" ordering semantics."}]}]}]}]},{"type":"paragraph","children":[{"type":"text","value":"This provides a happens-before dependence between X and B."}]},{"type":"code_block","language":"text","code":"    Thread 1                                          Thread 2\n\nm.store(3, Release); X ---------\n                               |\n                               |\n                               -------------> Y  if m.load(Relaxed) == 3 {\n                                              B      fence(Acquire);\n                                                     ...\n                                                 }"},{"type":"heading","level":3,"id":"fence---atomic","children":[{"type":"text","value":"Fence - Atomic"}]},{"type":"paragraph","children":[{"type":"text","value":"A fence on one thread will synchronize with an atomic operation on another thread when:"}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"paragraph","children":[{"type":"text","value":"on thread:"}]},{"type":"list","ordered":false,"start":null,"items":[{"children":[{"type":"text","value":"a fence ‘A’ with (at least) "},{"type":"link","href":"https://doc.rust-lang.org/std/sync/atomic/enum.Ordering.html#variant.Release","title":"variant std::sync::atomic::Ordering::Release","children":[{"type":"inline_code","code":"Release"}]},{"type":"text","value":" ordering semantics,"}]},{"children":[{"type":"text","value":"followed by an atomic write ‘X’ with 