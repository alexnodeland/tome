]},{"type":"text","value":" should be used instead to make the intent explicit."}]},{"type":"heading","level":2,"id":"examples","children":[{"type":"text","value":"Examples"}]},{"type":"code_block","language":null,"code":"use std::fs;\n\nfn main() -> std::io::Result<()> {\n    fs::soft_link(\"a.txt\", \"b.txt\")?;\n    Ok(())\n}"},{"type":"link","href":"https://play.rust-lang.org/?code=%23!%5Ballow(unused)%5D%0Ause+std::fs;%0A%0Afn+main()+-%3E+std::io::Result%3C()%3E+%7B%0A++++fs::soft_link(%22a.txt%22,+%22b.txt%22)?;%0A++++Ok(())%0A%7D&edition=2024","title":"Run code","children":[]}]}}
